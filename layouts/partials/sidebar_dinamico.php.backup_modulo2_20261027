/**
 * Función recursiva para construir árbol de páginas
 * Busca todos los children de un parent_id y los agrupa
 */
function construirArbolPaginas($parent_id, $paginas_por_padre, $modulo_slug) {
    $resultado = [];
    
    // Si no hay páginas para este padre, retornar vacío
    if (!isset($paginas_por_padre[$parent_id])) {
        return $resultado;
    }
    
    // Obtener todas las páginas que tienen este padre
    foreach ($paginas_por_padre[$parent_id] as $pagina) {
        // Construir página con sus children recursivamente
        $pagina['children'] = construirArbolPaginas($pagina['id'], $paginas_por_padre, $modulo_slug);
        $resultado[] = $pagina;
    }
    
    return $resultado;
}

/**
 * Renderizar árbol de páginas recursivamente con AdminLTE
 */
function renderizarArbolPaginas($paginas, $nivel = 0) {
    $html = '';
    
    foreach ($paginas as $pagina) {
        $tiene_children = !empty($pagina['children']);
        $icono = !empty($pagina['icon']) ? $pagina['icon'] : 'fas fa-file';
        
        // Abrir elemento
        $html .= '<li class="nav-item' . ($tiene_children ? ' has-treeview' : '') . '">';
        
        // Renderizar link o botón si tiene children
        if ($tiene_children) {
            $html .= '<a href="' . htmlspecialchars($pagina['url']) . '" class="nav-link">';
            $html .= '<i class="nav-icon ' . htmlspecialchars($icono) . '"></i>';
            $html .= '<p>' . htmlspecialchars($pagina['title']) . '<i class="right fas fa-angle-left"></i></p>';
            $html .= '</a>';
            
            // Renderizar submenu
            $html .= '<ul class="nav nav-treeview">';
            $html .= renderizarArbolPaginas($pagina['children'], $nivel + 1);
            $html .= '</ul>';
        } else {
            // Enlace simple sin children
            $html .= '<a href="' . htmlspecialchars($pagina['url']) . '" class="nav-link">';
            $html .= '<i class="nav-icon ' . htmlspecialchars($icono) . '"></i>';
            $html .= '<p>' . htmlspecialchars($pagina['title']) . '</p>';
            $html .= '</a>';
        }
        
        // Cerrar elemento
        $html .= '</li>';
    }
    
    return $html;
}

try {
    // Obtener información completa de módulos desde BD
    $modulos_info = [];
    global $db;
    $sql = "SELECT id, slug, nombre, descripcion, icono, estado FROM modulos WHERE estado = 1 ORDER BY orden ASC, nombre ASC";
    $result = $db->query($sql);
    
    if ($result && $db->num_rows($result) > 0) {
        while ($row = $db->fetch_assoc($result)) {
            $modulos_info[] = $row;
        }
    }
    
    // Obtener todas las páginas de módulos de una vez (más eficiente)
    $module_pages_por_modulo = [];
    if (!empty($modulos_info)) {
        $slugs = array_map(function($m) { return "'" . $m['slug'] . "'"; }, $modulos_info);
        $slugs_sql = implode(',', $slugs);
        
        $sql_pages = "SELECT id, modulo_slug, parent_id, title, url, icon, orden, estado 
                      FROM module_pages 
                      WHERE modulo_slug IN ($slugs_sql) AND estado = 1 
                      ORDER BY modulo_slug, orden ASC";
        $result_pages = $db->query($sql_pages);
        
        if ($result_pages && $db->num_rows($result_pages) > 0) {
            while ($row = $db->fetch_assoc($result_pages)) {
                if (!isset($module_pages_por_modulo[$row['modulo_slug']])) {
                    $module_pages_por_modulo[$row['modulo_slug']] = [];
                }
                $module_pages_por_modulo[$row['modulo_slug']][] = $row;
            }
        }
    }
} catch (Exception $e) {
    $modulos_info = [];
    $module_pages_por_modulo = [];
}
