.fhc-root,.fhc-doc{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:#101b2bc9;padding:20px;z-index:21000}.fhc-panel{background:white;border-radius:14px;box-shadow:0 24px 80px #0006;width:min(1320px,97vw);max-height:94vh;display:flex;flex-direction:column;overflow:hidden}.fhc-panel>header,.fhc-doc header{display:flex;align-items:center;justify-content:space-between;gap:20px;background:#17365a;color:#fff;padding:15px 20px;flex-shrink:0}.fhc-panel header small{display:block;color:#bdd2e9;font-size:12px;margin-bottom:4px}.fhc-title{font-size:18px}.fhc-close,.fhc-doc header button{background:transparent;border:0;color:white;font-size:28px;cursor:pointer}.fhc-body{overflow:auto;padding:22px}.fhc-metrics{display:grid;grid-template-columns:repeat(4,minmax(140px,1fr));gap:12px}.fhc-metrics>div{padding:15px;border:1px solid #dbe3ef;border-radius:10px;background:#f5f8fc}.fhc-metrics small{display:block;color:#64748b;margin-bottom:6px}.fhc-metrics strong{color:#17365a;font-size:15px}.fhc-body h3{font-size:17px;font-weight:700;margin:25px 0 12px;color:#17365a}.fhc-muted{font-size:13px;color:#64748b;margin:12px 0}.fhc-process{border:1px solid #dbe3ef;border-radius:9px;margin:10px 0;overflow:hidden}.fhc-process summary{cursor:pointer;padding:13px 15px;background:#eef4fb;font-weight:700;color:#244c75}.fhc-process summary span{float:right;font-size:12px;color:#64748b}.fhc-scroll{overflow:auto}.fhc-body table{width:100%;border-collapse:collapse;font-size:13px}.fhc-body td,.fhc-body th{padding:11px 13px;border-bottom:1px solid #e2e8f0;text-align:left;vertical-align:middle}.fhc-body th{background:#f8fafc;color:#475569;font-size:12px}.fhc-body td div{color:#64748b;margin-top:4px}.fhc-file{display:inline-flex;align-items:center;gap:7px;max-width:330px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;background:#e9f2fd;color:#1e4a76;border:1px solid #bfd1e6;border-radius:7px;padding:7px 10px;cursor:pointer;font-size:12px}.fhc-file:hover{background:#dbeafe}.fhc-attachments{padding:12px;display:flex;gap:9px;flex-wrap:wrap;align-items:center}.fhc-note{padding:14px 16px;border:1px solid #e2e8f0;border-radius:9px;margin:10px 0}.fhc-note small{display:block;color:#64748b;margin-top:5px}.fhc-note p{white-space:pre-wrap;margin-top:10px}.fhc-image{padding:0;border:1px solid #dbe3ef;background:white;border-radius:6px;margin:4px;cursor:pointer}.fhc-image img{width:70px;height:70px;object-fit:cover;border-radius:6px}.fhc-doc{z-index:22000;background:#0b1320dc}.fhc-doc>section{width:96vw;height:92vh;display:flex;flex-direction:column;background:#fff;border-radius:12px;overflow:hidden}.fhc-doc header strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.fhc-doc header a{color:white;font-size:13px;margin-right:20px}.fhc-document-stage{position:relative;flex:1;min-height:0;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#f1f5f9}.fhc-document-stage>img{max-width:100%;max-height:100%;object-fit:contain}.fhc-document-stage>iframe,.fhc-cad{width:100%;height:100%;border:0;position:absolute;inset:0}.fhc-doc-status{position:absolute;top:12px;left:12px;right:12px;z-index:3;padding:10px;background:#fffffff0;color:#334155;border-radius:6px;font-size:13px}.fhc-open-project{white-space:nowrap}.fhc-root button:focus-visible,.fhc-root a:focus-visible,.fhc-root summary:focus-visible{outline:3px solid #60a5fa;outline-offset:2px}@media(max-width:700px){.fhc-root,.fhc-doc{padding:6px}.fhc-body{padding:12px}.fhc-metrics{grid-template-columns:repeat(2,minmax(100px,1fr))}.fhc-title{font-size:15px}.fhc-panel{max-height:97vh}.fhc-file{max-width:190px}.fhc-process summary span{float:none;display:block;margin-top:5px}}