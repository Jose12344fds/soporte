function saveFloatData() {
  let $tbody = $('#floatTable tbody');
  let datos = [], suma = 0;

  // Calcular suma total (todas las filas) para validar 100%
  $tbody.find('tr').each(function() {
    let $avCell = $(this).find('[data-field="Avance"]');
    let $avInp  = $avCell.find('input');
    suma += $avInp.length > 0
      ? parseFloat($avInp.val()) || 0
      : parseFloat($avCell.text().replace('%', '')) || 0;
  });

  // Solo recopilar filas NUEVAS para insertar
  $tbody.find('tr[data-id="NEW"]').each(function() {
    let $tr  = $(this);
    let anio = $tr.find('.float-year-select').val();
    let semana = $tr.find('.float-week-select').val();
    let $avCell = $tr.find('[data-field="Avance"]');
    let $avInp  = $avCell.find('input');
    let avance  = $avInp.length > 0
      ? parseFloat($avInp.val()) || 0
      : parseFloat($avCell.text().replace('%', '')) || 0;
    let fab = $tr.find('.float-select-fab').val() || 'tama';

    if (anio && semana && avance > 0) {
      datos.push({
        idPrograma: null,
        anio: parseInt(anio),
        semana: parseInt(semana),
        porcentaje: parseFloat(avance),
        totalHoras: parseFloat($tr.find('.float-horas-calc').text()) || 0,
        fabricacion: fab,
        proyecto: window.projectCode,
        codPdre: window.codPdre,
        idPadreOT: window.idPadreOT,
        proceso: window.columnName
      });
    }
  });

  if (!datos.length) { toast('warning', 'No hay filas nuevas para guardar'); return; }
  if (Math.abs(suma - 100) > 0.01) { toast('warning', `Avances deben sumar 100%. Actual: ${suma.toFixed(2)}% — Faltante: ${(100 - suma).toFixed(2)}%`); return; }

  console.log('Enviando datos:', JSON.stringify(datos));
  
  $.ajax({
    url: API.guardar, method: 'POST', data: { datos: JSON.stringify(datos) }, dataType: 'json',
    success: (res) => {
      console.log('Respuesta del servidor:', res);
      if (res.success) { toast('success', res.message || 'Guardado correctamente'); reloadFloatDiv(); }
      else toast('error', res.message || 'Error al guardar')
    },
    error: (xhr, status, err) => {
      console.error('Error:', xhr, status, err);
      toast('error', 'Error de conexión al guardar')
    }
  });
}

function reloadFloatDiv() {
  if (window.idPadreOT && window.codPdre && window.columnName) {
    ListarDatos(window.idPadreOT, window.codPdre, window.columnName, function(data) {
      programacionCache.set([window.idPadreOT, window.codPdre, window.columnName].join('|'), data);
      window.modalFloatData = data;
      renderFloatTableDiv(data);
      // Resetear checkbox "seleccionar todas"
      $('#floatSelectAllChk').prop('checked', false);
      window.selectedToOpen = [];
      refreshCelda();
    });
  }
}

/* ── Variable global para track de maximize ── */
window.floatingPanelState = { isMaximized: false };

/* ── Bootstrap Modal — Floating Panel ── */
function initFloatingPanel() {
  var $modal   = $('#floatModal');
  var $dialog  = $('#floatModalDialog');
  var $content = $modal.find('.modal-content');
  window.floatingPanelState = { isMaximized: false };

  function resetSize() {
    $dialog.css({ 'max-width': '82vw', margin: '2vh auto' });
    $content.css({ height: '78vh' });
    window.floatingPanelState.isMaximized = false;
    $('#floatMax').html('<i class="fa fa-expand"></i>');
  }
  window.centerFloatingPanel = resetSize;

  $('#floatMax').off('click').on('click', function () {
    if (!window.floatingPanelState.isMaximized) {
      $dialog.css({ 'max-width': '98vw', margin: '0.5vh auto' });
      $content.css({ height: '97vh' });
      window.floatingPanelState.isMaximized = true;
      $(this).html('<i class="fa fa-compress"></i>');
    } else {
      resetSize();
    }
  });

  $modal.on('hidden.bs.modal', function () {
    resetSize();
    window.totalAvance = 0;
  });

  $('#floatAddRow').off('click').on('click', addFloatRow);
  $('#floatOpenWeeks').off('click').on('click', openSelectedRows);
  $('#floatCloseAll').off('click').on('click', closeAllRows);
  $('#floatSelectAllChk').off('change').on('change', selectAllRows);
  $('#floatSave').off('click').on('click', saveFloatData);
}

