var editableCols = ['PorcenCalProy','MO001_1','MO001_2','MO002','MO004','MO014','MO008_1','MO008_2','MO007_1','MO007_2','MO003','MO015','MO005','MO009','MO004P','MO006','MO012','MO011','MO020','MO010','MO050','MO060','MO070','MO080'];

function initSubDblClick() {
  $('#tblSub tbody').on('dblclick', 'td', function () {
    var cell = subTable.cell(this);
    var rowData = subTable.row(cell.index().row).data();
    var colDef = subTable.settings()[0].aoColumns[cell.index().column];
    var field = colDef.mData || colDef.data;
    if (!editableCols.includes(field)) return;

    var orig = cell.data();
    var $input = $('<input type="number" class="form-control" step="0.01"/>').val(orig);
    $input.on('blur', function () {
      var nv = $(this).val();
      if (nv !== String(orig)) updateCellValue(cell, rowData, field, nv, orig);
      else cell.data(orig).draw();
    }).on('keydown', function (e) {
      if (e.key === 'Enter') $(this).blur();
      if (e.key === 'Escape') cell.data(orig).draw();
    });
    $(cell.node()).html($input);
    $input.focus().select();
  });
}

function updateCellValue(cell, rowData, field, newValue, orig) {
  $(cell.node()).html('<i class="fa fa-spinner fa-spin"></i>');
  $.ajax({
    url: API.updateCelda, method: 'POST',
    data: { IdHijOT: rowData.IdHijOT, fieldName: field, newValue: newValue },
    success: function (r) {
      var res = typeof r === 'string' ? JSON.parse(r) : r;
      if (res.success) {
        cell.data(newValue).draw();
        $(cell.node()).css('background-color', '#d4edda');
        setTimeout(() => $(cell.node()).css('background-color', ''), 800);
        fetchSubQuery(rowData.IdPadre);
        if (field === 'PorcenCalProy') recalcularAvanceRealProyecto({ idPadreOT: rowData.IdPadre || rowData.IdPadreOT, codPdre: rowData.CodPdre, projectCode: rowData.ProjectCode });
      } else { toast('error', res.message || 'Error'); cell.data(orig).draw(); }
    },
    error: function () { toast('error', 'Error de conexión'); cell.data(orig).draw(); }
  });
}

