function openFloatingPanel($cell, colIdx, cellValue) {
  var row = subTable.row($cell.closest('tr')).data();
  window._floatCell = subTable.cell($cell[0]);   // referencia viva a la celda activa
  window.Peso = cellValue;
  window.codPdre = row.CodPdre;
  window.projectCode = row.OTPADRE;
  window.idPadreOT = row.IdPadreOT;
  window.NPdre = row.NPdre;
  window.columnName = subTable.settings()[0].aoColumns[colIdx].mData;

  Peso1 = cellValue; codPdre1 = row.CodPdre; projectCode1 = row.OTPADRE;
  idPadreOT1 = row.IdPadreOT; Proceso1 = window.columnName;

  var colTitle = subTable.settings()[0].aoColumns[colIdx].sTitle || window.columnName;
  
  // Actualizar título del floating panel
  $('#floatTitleText').text(window.projectCode + ' - ' + window.NPdre + ' — ' + colTitle);
  
  var cacheKey = [window.idPadreOT, window.codPdre, window.columnName].join('|');
  var requestToken = ++floatRequestToken;
  var cachedData = programacionCache.get(cacheKey);

  // El panel responde de inmediato; la consulta termina en segundo plano.
  if (cachedData) {
    renderFloatTableDiv(cachedData);
    window.modalFloatData = cachedData;
  } else {
    $('#floatTable tbody').html("<tr><td colspan='9' class='ps-float-loading'><i class='fa fa-spinner fa-spin'></i> Cargando programacion...</td></tr>");
  }
  $('#floatModal').modal('show');

  if (floatPendingRequest && floatPendingRequest.readyState !== 4) floatPendingRequest.abort();
  floatPendingRequest = ListarDatos(window.idPadreOT, window.codPdre, window.columnName, function(data) {
    if (requestToken !== floatRequestToken) return;
    programacionCache.set(cacheKey, data);
    renderFloatTableDiv(data);
    window.modalFloatData = data;
  }, function() {
    if (requestToken !== floatRequestToken || cachedData) return;
    $('#floatTable tbody').html("<tr><td colspan='9' class='ps-float-error'><i class='fa fa-exclamation-triangle'></i> No se pudo cargar la programacion.</td></tr>");
  });
}

function renderFloatTableDiv(data) {
  window.selectedToOpen = [];
  let $tbody = $('#floatTable tbody').html('');
  let horasPendientes = [];
  
  if (data && data.length) {
    data.forEach((row) => {
      let fabVal = (row.Fabricacion || row.fabricacion || 'tama').toLowerCase();
      let isPE = ['MO050','MO060','MO070','MO080'].includes(window.columnName || '');
      let fabOptions = isPE 
        ? `<option value='svt-especiales' ${fabVal === 'svt-especiales' ? 'selected' : ''}>SVT-ESP</option>`
        : `<option value='tama' ${fabVal === 'tama' ? 'selected' : ''}>TAMA</option><option value='svt' ${fabVal === 'svt' ? 'selected' : ''}>SVT</option>`;
      
      // Crear selects de año y semana (igual que en addFloatRow)
      let currentYear = new Date().getFullYear();
      let yearOpts = '';
      for (let y = currentYear - 1; y <= currentYear + 1; y++) {
        yearOpts += `<option value='${y}' ${y == row.Aniio ? 'selected' : ''}>${y}</option>`;
      }
      
      let weekOpts = '';
      for (let w = 1; w <= 52; w++) {
        weekOpts += `<option value='${w}' ${w == row.Semana ? 'selected' : ''}>${w}</option>`;
      }
      
      let cerrarBtnStyle = row.Estado == 1
        ? "background-color:#5ef518;color:black;border:none;border-radius:5px;cursor:pointer;padding:3px 10px"
        : "background-color:#95a5a6;color:black;border:none;border-radius:5px;cursor:pointer;padding:3px 10px";
      let cerrarBtnText = row.Estado == 1 ? 'Abierto' : 'Cerrado';

      // Recalcular Horas desde window.Peso actual (evita valores obsoletos del DB)
      let pesoActual = parseFloat(window.Peso) || 0;
      let avanceNum  = parseFloat(row.Avance) || 0;
      let horasCalc  = pesoActual > 0
        ? ((avanceNum / 100) * pesoActual).toFixed(2)
        : (parseFloat(row.TotHoras) || 0).toFixed(2);

      let $tr = $(`<tr data-id='${row.IdPrograma || ''}' data-estado='${row.Estado}'>
        <td style='width:30px'><input type='checkbox' class='float-chk-select' ${row.Estado == 1 ? '' : 'disabled'}></td>
        <td><select class='form-control form-control-sm float-year-select' ${row.Estado == 2 ? 'disabled' : ''}>${yearOpts}</select></td>
        <td><select class='form-control form-control-sm float-week-select' ${row.Estado == 2 ? 'disabled' : ''}>${weekOpts}</select></td>
        <td class='float-cell-edit float-cell-avance' data-field='Avance'>${row.Avance || ''}%</td>
        <td class='float-horas-calc'>${horasCalc}</td>
        <td class='float-cell-edit float-cell-avance' data-field='AvanceReal'>${row.AvanceReal || ''}%</td>
        <td><select class='float-select-fab form-control form-control-sm' data-field='Fabricacion' ${row.Estado == 2 ? 'disabled' : ''}>${fabOptions}</select></td>
        <td style='text-align:center'><button type='button' class='cerrar-row-btn' style='${cerrarBtnStyle}'>${cerrarBtnText}</button></td>
        <td style='text-align:center'><button type='button' class='delete-row-btn' style='background-color:#e74c3c;color:white;border:none;border-radius:5px;cursor:pointer;padding:3px 10px' ${row.Estado == 2 ? 'disabled' : ''}>Eliminar</button></td>
      </tr>`);
      $tbody.append($tr);

      // Corregir TotHoras en BD si difiere del valor calculado con el peso actual
      if (pesoActual > 0 && row.IdPrograma && parseFloat(row.TotHoras) !== parseFloat(horasCalc)) {
        horasPendientes.push({ idPrograma: row.IdPrograma, totalHoras: horasCalc });
      }
    });
  } else {
    $tbody.html(`<tr><td colspan='9' style='text-align:center;color:#999'>Sin datos</td></tr>`);
  }
  
  initFloatTableEvents();

  // Dejar libre el hilo de interfaz antes de sincronizar horas en segundo plano.
  if (horasPendientes.length) {
    var enviarCorrecciones = function() {
      horasPendientes.forEach(function(item) {
