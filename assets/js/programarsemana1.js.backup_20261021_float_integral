/* ════════════════════════════════════════════════════════
   17. BOTONES OT — Correo, Validar, Cerrar
   ════════════════════════════════════════════════════════ */
function initOTButtons() {
  // Correo
  $(document).on('click', '.btn-correo', function () {
    var id = $(this).data('id');
    confirmAction('¿Enviar correo?', '').then(r => {
      if (!r.isConfirmed) return;
      $.ajax({ url: 'enviarCorreo_Semana.php', method: 'POST', data: { id: id }, success: () => toast('success', 'Correo enviado'), error: () => toast('error', 'Error enviando') });
    });
  });

  // Validar (devolver a estado 1)
  $(document).on('click', '.btn-cambiarValidar', function () {
    var id = $(this).data('id');
    $.ajax({
      url: API.estadoValidar, method: 'POST', data: { IdHijOT: id },
      success: function (r) {
        var res = typeof r === 'string' ? JSON.parse(r) : r;
        if (res.success) { toast('success', res.message); mainTable.ajax.reload(null, false); fetchSubQuery(); }
        else toast('error', res.message);
      }
    });
  });

  // Cerrar todas las semanas de una OT (con auto-distribución de Av.Físico)
  $(document).on('click', '.btn-cerrar-semanas', function () {
    var id      = $(this).data('id');
    var project = $(this).data('project');
    confirmAction(
      '¿Cerrar todas las semanas?',
      'Se distribuirá el Av.Físico faltante y se cerrarán todas las semanas abiertas de esta OT.',
      'warning'
    ).then(function (r) {
      if (!r.isConfirmed) return;
      $.ajax({
        url: API.cerrarSemanasOT,
        method: 'POST',
        data: { idPadre: id },
        dataType: 'json',
        success: function (res) {
          if (res.success) {
            toast('success', res.message);
            if (res.procesos && res.procesos.length) {
              res.procesos.forEach(function (p) {
                recalcularAvanceRealProyecto({ idPadreOT: p.idPadreOT, codPdre: p.codPdre, projectCode: p.projectCode });
              });
            }
            mainTable.ajax.reload(null, false);
            if (currentIdPadre) fetchSubQuery(currentIdPadre);
            refreshCelda();
          } else {
            Swal.fire({ icon: 'error', title: 'No se pudo cerrar', html: res.message });
          }
        },
        error: function () {
          toast('error', 'Error de comunicación al cerrar semanas');
        }
      });
    });
  });

  // Cerrar OT
  $(document).on('click', '.btn-cambiar', function () {
    var id = $(this).data('id');
    confirmAction('¿Cerrar proyecto?', 'Solo si todas las semanas están cerradas.', 'warning').then(r => {
      if (!r.isConfirmed) return;
      $.ajax({
        url: API.estadoCerrar, method: 'POST', data: { IdHijOT: id },
        success: function (r) {
          var res = typeof r === 'string' ? JSON.parse(r) : r;
          if (res.success) { toast('success', res.message); mainTable.ajax.reload(null, false); fetchSubQuery(); }
          else Swal.fire({ icon: 'error', title: 'No se puede cerrar', html: res.message });
        }
      });
    });
  });
}

