/* ════════════════════════════════════════════════════════
   5. COLORES POR AVANCE / ESTADO (celdas MO)
   ════════════════════════════════════════════════════════ */
function obtenerAvance(rowData, colName, cb) {
  $.ajax({
    url: API.sumAvance, method: 'POST',
    data: { idPadreOT: rowData.IdPadreOT, codPdre: rowData.CodPdre, proceso: colName },
    success: function (r) { var j = typeof r === 'string' ? JSON.parse(r) : r; cb(parseFloat(j.total) || 0); },
    error: function () { cb(0); }
  });
}
function aplicarColorAvance(cell, total) {
  if (total >= 100) $(cell).css('background-color', '#90EE90');
  else if (total >= 75) $(cell).css('background-color', '#FFFF99');
  else $(cell).css('background-color', '');
}
function aplicarColoresEnFilas() {
  if (!subTable) return;
  subTable.rows().every(function (rowIdx) {
    var rowData = this.data();
    subTable.columns().every(function (colIdx) {
      var col = subTable.settings()[0].aoColumns[colIdx];
      var name = col.mData || col.data;
      if (name && name.startsWith('MO')) {
        var cell = subTable.cell(rowIdx, colIdx).node();
        if (cell) obtenerAvance(rowData, name, t => aplicarColorAvance(cell, t));
      }
    });
  });
}

function obtenerEstadoProgramado(rowData, colName, cb) {
  $.ajax({
    url: API.estadoProgramado, method: 'POST',
    data: { idPadreOT: rowData.IdPadreOT, codPdre: rowData.CodPdre, proceso: colName },
    success: function (r) { var j = typeof r === 'string' ? JSON.parse(r) : r; cb(parseFloat(j.RESULT) || 0); },
    error: function () { cb(0); }
  });
}
function aplicarColoresEnBORDES() {
  if (!subTable) return;
  subTable.rows().every(function (rowIdx) {
    var rowData = this.data();
    subTable.columns().every(function (colIdx) {
      var col = subTable.settings()[0].aoColumns[colIdx];
      var name = col.mData || col.data;
      if (name && (name.startsWith('MO') || name === 'SUT')) {
        var cell = subTable.cell(rowIdx, colIdx).node();
        if (cell) obtenerEstadoProgramado(rowData, name, R => {
          $(cell).css('border', R == 2 ? '2px solid #f7071f' : '');
        });
      }
    });
  });
}

// Refresca en tiempo real los colores de la celda activa en tblSub
function refreshCelda() {
  if (!subTable || !window._floatCell || !window.columnName) return;
  try {
    var cellNode = window._floatCell.node();
    if (!cellNode) return;
    var rowData = subTable.row(window._floatCell.index().row).data();
    if (!rowData) return;
    obtenerAvance(rowData, window.columnName, function(t) {
      aplicarColorAvance(cellNode, t);
    });
    obtenerEstadoProgramado(rowData, window.columnName, function(R) {
      $(cellNode).css('border', R == 2 ? '2px solid #f7071f' : '');
    });
  } catch(e) { /* celda no disponible */ }
}

