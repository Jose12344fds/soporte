function initFloatTableEvents() {
  // Checkboxes para selección
  $('#floatTable tbody').off('change', '.float-chk-select').on('change', '.float-chk-select', function() {
    let $tr = $(this).closest('tr'), id = $tr.data('id');
    if ($(this).is(':checked')) {
      if (!window.selectedToOpen.includes(id)) window.selectedToOpen.push(id);
    } else {
      window.selectedToOpen = window.selectedToOpen.filter(x => x !== id);
    }
  });

  // Doble clic editable
  $('#floatTable tbody').off('dblclick', '.float-cell-edit').on('dblclick', '.float-cell-edit', function() {
    let $td = $(this), estado = $td.closest('tr').data('estado'), $tr = $td.closest('tr');
    if (estado == 2) return;
    let field = $td.data('field'), val = $td.text().replace('%', '').trim();
    let $inp = $(`<input type='${field === 'Avance' || field === 'AvanceReal' ? 'number' : 'text'}' class='form-control' style='width:100%'>`).val(val);
    $td.html($inp).find('input').focus().select();
    $inp.on('blur', function() {
      let nv = $(this).val();
      if (nv && nv !== val) {
        updateFloatCell($tr, field, nv);
        // Auto-calcular horas si cambió el avance
        if (field === 'Avance') calculateHoursByAvance($tr);
      }
      $td.text((field === 'Avance' || field === 'AvanceReal' ? nv + '%' : nv) || val);
    }).on('keydown', e => { if (e.key === 'Enter') $inp.blur(); if (e.key === 'Escape') $td.text(val); });
  });
  
  // Cambio fabricación
  $('#floatTable tbody').off('change', '.float-select-fab').on('change', '.float-select-fab', function() {
    let $tr = $(this).closest('tr'), id = $tr.data('id'), val = $(this).val();
    if (!id) return;
    $.ajax({ url: API.actualizarFabric, method: 'POST', data: { idPrograma: id, fabricacion: val }, dataType: 'json',
      success: (r) => {
        if (r.success) {
          if (Array.isArray(window.modalFloatData)) {
            var filaActual = window.modalFloatData.find(x => String(x.IdPrograma) === String(id));
            if (filaActual) filaActual.Fabricacion = val;
            programacionCache.set([window.idPadreOT, window.codPdre, window.columnName].join('|'), window.modalFloatData);
          }
          $(this).addClass('ps-select-saved');
          setTimeout(() => $(this).removeClass('ps-select-saved'), 700);
        }
      }
    });
  });
  
  // Auto-incremento de semanas cuando cambia el select
  $('#floatTable tbody').off('change', '.float-week-select').on('change', '.float-week-select', function() {
    let $tr = $(this).closest('tr');
    let selectedWeek = parseInt($(this).val());
    let rowId = $tr.data('id');

    // Cascade solo aplica cuando la fila modificada es NUEVA (no guardada aún)
    if (!rowId || rowId === 'NEW') {
      let nextWeek = selectedWeek;
      $tr.nextAll().each(function() {
        let $nextTr = $(this);
        let nextId = $nextTr.data('id');
        // Solo cascadear hacia filas que también sean nuevas
        if (!nextId || nextId === 'NEW') {
          nextWeek++;
          if (nextWeek <= 52) {
            $nextTr.find('.float-week-select').val(nextWeek);
            $nextTr.find('[data-field="Semana"]').text(nextWeek);
          }
        }
      });
    }

    // Actualizar semana en la fila actual
    $tr.find('[data-field="Semana"]').text(selectedWeek);
    // Guardar en BD si es fila existente
    if (rowId && rowId !== 'NEW') updateFloatCell($tr, 'Semana', selectedWeek);
  });

  // Cambio de año en filas existentes — guardar en BD inmediatamente
  $('#floatTable tbody').off('change', '.float-year-select').on('change', '.float-year-select', function() {
    let $tr = $(this).closest('tr');
    let rowId = $tr.data('id');
    if (rowId && rowId !== 'NEW') updateFloatCell($tr, 'Aniio', $(this).val());
  });
  
  // ═══ CERRAR / ABRIR SEMANA ═══ (click en botón "Abierto"/"Cerrado" — igual que original)
  $('#floatTable tbody').off('click', '.cerrar-row-btn').on('click', '.cerrar-row-btn', function() {
    var $btn = $(this);
    var $row = $btn.closest('tr');
    var estado = String($row.data('estado'));
    var idPrograma = $row.data('id');
    if (!idPrograma || idPrograma === 'NEW') return;

    if (estado === '1') {
      // Contar semanas abiertas
      var semanasAbiertas = 0;
      $('#floatTable tbody tr').each(function() {
        if (String($(this).data('estado')) === '1') semanasAbiertas++;
      });

      // Si es la ÚLTIMA semana abierta → validar sum(AvanceReal) = 100%
      if (semanasAbiertas <= 1) {
        var sumaAvanceReal = 0;
        $('#floatTable tbody tr').each(function() {
          var av = parseFloat($(this).find('[data-field="AvanceReal"]').text().replace('%', '')) || 0;
          sumaAvanceReal += Math.max(0, Math.min(av, 100));
        });
        if (Math.abs(sumaAvanceReal - 100) > 0.01) {
          Swal.fire({
            icon: 'warning',
            title: 'No se puede cerrar la última semana',
            html: 'La suma de los porcentajes de <strong>Avance Físico (Real)</strong> debe ser <strong>100%</strong> para cerrar la última semana.<br><br>' +
                  'Suma actual: <strong>' + sumaAvanceReal.toFixed(2) + '%</strong><br><br>' +
                  'Por favor, ajusta los porcentajes de avance físico antes de cerrar.',
            confirmButtonColor: '#3085d6'
          });
          return;
        }
      }

      // Confirmar cierre
      Swal.fire({
        title: '¿Cerrar semana?',
        text: '¿Estás seguro de que quieres cerrar esta semana?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Sí, cerrar',
        cancelButtonText: 'Cancelar'
      }).then(function(result) {
        if (result.isConfirmed) {
          $.ajax({
            url: API.actualizarEstado, method: 'POST',
            data: { idPrograma: idPrograma, estado: 2 }, dataType: 'json',
            success: function(response) {
              if (response && response.success) {
                $btn.text('Cerrado').css('background-color', '#95a5a6');
                $row.data('estado', 2);
                $row.find('.float-cell-edit').css('color', '#999');
                $row.find('select').prop('disabled', true);
                $row.find('.float-chk-select').prop({ checked: false, disabled: true });
                window.selectedToOpen = (window.selectedToOpen || []).filter(function(x) { return x !== idPrograma; });
                toast('success', 'Semana cerrada');
                refreshCelda();
                if (response.warnings && response.warnings.length > 0) {
                  var warnHtml = response.warnings.map(function(w) { return w.message; }).join('<br>');
                  Swal.fire({ icon: 'info', title: 'Advertencias', html: warnHtml });
                }
              } else {
                Swal.fire({ icon: 'error', title: 'No se pudo cerrar', html: (response && response.message) || 'Error desconocido' });
              }
            },
            error: function(jqXHR, textStatus, errorThrown) {
              console.error('Error cerrar semana:', textStatus, errorThrown, jqXHR.responseText);
              Swal.fire({ icon: 'error', title: 'Error de comunicación', html: 'No se pudo conectar al servidor.<br>Detalle: ' + (jqXHR.responseText || textStatus).substring(0, 200) });
            }
          });
        }
      });

    } else if (estado === '2') {
      // Toggle selección para "Abrir Semanas" (igual que original)
      if (!window.selectedToOpen) window.selectedToOpen = [];
      if (!window.selectedToOpen.includes(idPrograma)) {
        window.selectedToOpen.push(idPrograma);
        $btn.css('background-color', '#ff6b6b');
      } else {
        window.selectedToOpen = window.selectedToOpen.filter(function(x) { return x !== idPrograma; });
        $btn.css('background-color', '#95a5a6');
      }
    }
  });
  
  // ═══ ELIMINAR ═══ (solo funciona si Estado = 1, igual que original)
  $('#floatTable tbody').off('click', '.delete-row-btn').on('click', '.delete-row-btn', function() {
    var $row = $(this).closest('tr');
    var estado = String($row.data('estado'));
    var id = $row.data('id');

    if (estado === '2') {
      Swal.fire({ icon: 'warning', title: 'Semana cerrada', text: 'No se puede eliminar una semana cerrada' });
      return;
    }

    if (!id || id === 'NEW') { $row.remove(); return; }

    Swal.fire({
      title: '¿Confirmar eliminación?',
      text: '¿Seguro que deseas eliminar este registro?',
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#d33',
      cancelButtonColor: '#3085d6',
      confirmButtonText: 'Sí, eliminar',
      cancelButtonText: 'Cancelar'
    }).then(function(result) {
      if (result.isConfirmed) {
        $.ajax({ url: API.eliminar, method: 'POST', data: { IdPrograma: id }, dataType: 'json',
          success: function(res) { if (res.success) { $row.remove(); toast('success', 'Eliminado'); } }
        });
      }
    });
  });
}

function updateFloatCell($tr, field, val) {
  let id = $tr.data('id');
  if (!id || id === 'SIN_ID') return;
  
  $.ajax({
    url: API.actualizarCampo, method: 'POST',
    data: { idPrograma: id, field: field, newValue: val },
    success: (r) => {
      let d = typeof r === 'string' ? JSON.parse(r) : r;
      if (!d.success) toast('error', 'Error actualizando');
      // Auto-calcular horas si se actualiza el avance
      if (field === 'Avance') calculateHoursByAvance($tr);
      if (field === 'AvanceReal') recalcularAvanceRealProyecto({ idPadreOT: window.idPadreOT, codPdre: window.codPdre, projectCode: window.projectCode });
    },
    error: () => toast('error', 'Error de conexión')
  });
}

function addFloatRow() {
  let totalAv = 0;
  let $tbody = $('#floatTable tbody');
  let rowCount = $tbody.find('tr').length;
  
  $tbody.find('tr').each(function() {
    let $avCell = $(this).find('[data-field="Avance"]');
    let $avInp  = $avCell.find('input');
    totalAv += $avInp.length > 0
      ? parseFloat($avInp.val()) || 0
      : parseFloat($avCell.text().replace('%', '')) || 0;
  });
  let remaining = 100 - totalAv;
  if (remaining <= 0) { toast('warning', 'Avance ya alcanza 100%'); return; }

  let currentYear = new Date().getFullYear();
  let isPE = ['MO050','MO060','MO070','MO080'].includes(window.columnName || '');
  
  let fabOpts = isPE 
    ? `<option value='svt-especiales'>SVT-ESP</option>` 
    : `<option value='tama'>TAMA</option><option value='svt'>SVT</option>`;
  
  // Crear opciones de año (año actual ± 1)
  let yearOpts = '';
  for (let y = currentYear - 1; y <= currentYear + 1; y++) {
    yearOpts += `<option value='${y}' ${y === currentYear ? 'selected' : ''}>${y}</option>`;
  }
  
  // Auto-semana: si hay filas, la semana siguiente = última semana + 1
  let nextWeek = 1;
  let lastRow = $tbody.find('tr:last');
  if (lastRow.length) {
    let lastWeek = parseInt(lastRow.find('[data-field="Semana"]').text()) || 0;
    nextWeek = lastWeek + 1;
  }
  
  // Crear opciones de semana (1-52)
  let weekOpts = '';
  for (let w = 1; w <= 52; w++) {
    weekOpts += `<option value='${w}' ${w === nextWeek ? 'selected' : ''}>${w}</option>`;
  }
  
  let $tr = $(`<tr data-id='NEW' data-estado='1'>
    <td style='width:30px'><input type='checkbox' class='float-chk-select'></td>
    <td><select class='form-control form-control-sm float-year-select'>${yearOpts}</select></td>
    <td><select class='form-control form-control-sm float-week-select'>${weekOpts}</select></td>
    <td class='float-cell-edit float-cell-avance' data-field='Avance' style='cursor:pointer;min-width:60px'>0%</td>
    <td class='float-horas-calc' style='min-width:60px'>0</td>
    <td class='float-cell-edit float-cell-avance' data-field='AvanceReal' style='cursor:pointer;min-width:70px'>0%</td>
    <td><select class='float-select-fab form-control form-control-sm'>${fabOpts}</select></td>
    <td style='text-align:center'><button type='button' class='cerrar-row-btn' style='background-color:#5ef518;color:black;border:none;border-radius:5px;cursor:pointer;padding:3px 10px'>Abierto</button></td>
    <td style='text-align:center'><button type='button' class='delete-row-btn' style='background-color:#e74c3c;color:white;border:none;border-radius:5px;cursor:pointer;padding:3px 10px'>Eliminar</button></td>
  </tr>`);
  
  $tbody.append($tr);
  
  // Inicializar eventos para los nuevos selects
  $tr.find('.float-year-select').on('change', function() {
    // Propagar año a todas las filas
    let year = $(this).val();
    $('#floatTable tbody').find('.float-year-select').val(year);
    // Actualizar data-field Aniio en todas las filas
    $('#floatTable tbody').find('tr').each(function() {
      $(this).find('[data-field="Aniio"]').text(year);
    });
  });
  
  $tr.find('.float-week-select').on('change', function() {
    // Auto-incrementar semanas en filas siguientes
    let selectedWeek = parseInt($(this).val());
    let nextRows = $tr.nextAll();
    
    nextRows.each(function(index) {
      let nextWeek = selectedWeek + index + 1;
      if (nextWeek <= 52) {
        $(this).find('.float-week-select').val(nextWeek);
        $(this).find('[data-field="Semana"]').text(nextWeek);
      }
    });
    
    // Actualizar semana en la fila actual
    $tr.find('[data-field="Semana"]').text(selectedWeek);
  });
  
  // Auto-cálculo de horas cuando cambia el avance
  $tr.find('[data-field="Avance"]').on('blur', function() {
    calculateHoursByAvance($tr);
  });
  
  toast('info', `Fila nueva - Semana ${nextWeek} - Avance disponible: ${remaining.toFixed(1)}%`);
}

// Calcular horas automáticamente basado en avance
function calculateHoursByAvance($tr) {
  let avance = parseFloat($tr.find('[data-field="Avance"]').text().replace('%', '')) || 0;
  // Usar window.Peso si existe (horas totales disponibles), si no usar 100
  let totalPeso = window.Peso || 100;
  let calculatedHours = (avance / 100) * totalPeso;
  $tr.find('.float-horas-calc').text(calculatedHours.toFixed(2));
}


