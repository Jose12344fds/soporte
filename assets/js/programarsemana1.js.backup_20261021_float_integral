/* Helper: badge coloreado por grupo de proceso */
function renderNum(grp) {
  return function (data, type) {
    if (type !== 'display') return data == null ? 0 : data;
    var val = parseFloat(data) || 0;
    if (val === 0) return '<span class="ps-val-zero">—</span>';
    return '<span class="ps-val-pos ps-val-pos-' + grp + '">' + val + '</span>';
  };
}

