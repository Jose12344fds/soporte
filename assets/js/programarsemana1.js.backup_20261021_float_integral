   9. FLOATING — Cargar / Renderizar datos
   ════════════════════════════════════════════════════════ */
function ListarDatos(idPadreOT, codPdre, columnName, cb, errorCb) {
  return $.ajax({
    url: API.programacion, method: 'POST',
    data: { idPadreOT: idPadreOT, codPdre: codPdre, proceso: columnName },
    dataType: 'json',
    success: function (r) { Array.isArray(r) ? cb(r) : toast('error', r.error || 'Datos inválidos'); },
    error: function (x, s, e) {
      if (s === 'abort') return;
      if (typeof errorCb === 'function') errorCb(x, s, e);
      toast('error', 'Error cargando programación');
    }
  });
}

