function verificarBaseline(idProg) {
  return $.ajax({ url: API.baselineManager, method: 'POST', data: { accion: 'verificar_baseline', id_programa: idProg }, dataType: 'json' })
    .then(r => r.success ? r : Promise.reject(r.error));
}

function crearBaseline(idProg) {
  return $.ajax({ url: API.baselineManager, method: 'POST', data: { accion: 'crear_baseline', id_programa: idProg }, dataType: 'json' })
    .then(r => r.success ? r : Promise.reject(r.message));
}

function obtenerComparacion(idProg) {
  return $.ajax({ url: API.baselineManager, method: 'POST', data: { accion: 'obtener_comparacion', id_programa: idProg }, dataType: 'json' })
    .then(r => r.success ? r : Promise.reject(r.error));
}

function agregarBotonesBaseline(idProg, tiene) {
  $('.baseline-controls').remove();
  var html = '<div class="baseline-controls">';
  if (tiene) {
    html += '<button type="button" class="btn btn-info btn-sm" onclick="mostrarComparacionBaseline(\'' + idProg + '\')">📊 Ver Comparación con Línea Base</button>';
  } else {
    html += '<div class="alert alert-warning alert-sm mb-2"><small><strong>⚠️ Sin línea base.</strong> Crea una para futuras comparaciones.</small></div>';
    html += '<button type="button" class="btn btn-success btn-sm" onclick="crearBaselineManual(\'' + idProg + '\')">📌 Crear Línea Base</button>';
  }
  html += '</div>';
  $('#floatTable').after(html);
}

function crearBaselineManual(idProg) {
  confirmAction('📌 Crear Línea Base', '¿Guardar la programación actual como línea base?').then(r => {
    if (!r.isConfirmed) return;
    crearBaseline(idProg).then(() => { toast('success', 'Línea base creada'); agregarBotonesBaseline(idProg, true); }).catch(e => toast('error', e));
  });
}

function mostrarComparacionBaseline(idProg) {
  window._preservedFloatState = { idPadreOT: window.idPadreOT, codPdre: window.codPdre, columnName: window.columnName, projectCode: window.projectCode, NPdre: window.NPdre };

  obtenerComparacion(idProg).then(function (data) {
    var map = new Map();
    data.datos_baseline.forEach(i => { var k = i.anio + '-' + i.semana; map.set(k, { anio: i.anio, semana: i.semana, ab: i.avance, hb: i.tot_horas, aa: null, ha: null, st: 'ELIMINADO' }); });
    data.datos_actuales.forEach(i => { var k = i.anio + '-' + i.semana; if (map.has(k)) { var s = map.get(k); s.aa = i.avance; s.ha = i.tot_horas; s.st = (s.ab == i.avance && s.hb == i.tot_horas) ? 'SIN CAMBIOS' : 'MODIFICADO'; } else map.set(k, { anio: i.anio, semana: i.semana, ab: null, hb: null, aa: i.avance, ha: i.tot_horas, st: 'AGREGADO' }); });

    var html = '<table class="table table-sm"><thead><tr><th>Año/Sem</th><th>Av.Base</th><th>Av.Actual</th><th>Hrs.Base</th><th>Hrs.Actual</th><th>Estado</th></tr></thead><tbody>';
    Array.from(map.entries()).sort((a, b) => (a[1].anio - b[1].anio) || (a[1].semana - b[1].semana)).forEach(([, s]) => {
      var bg = { 'SIN CAMBIOS': '#f8f9fa', 'MODIFICADO': '#fff3cd', 'AGREGADO': '#d4edda', 'ELIMINADO': '#f8d7da' }[s.st] || '#fff';
      var ico = { 'SIN CAMBIOS': '✓', 'MODIFICADO': '!', 'AGREGADO': '+', 'ELIMINADO': '✕' }[s.st] || '';
      html += '<tr style="background:' + bg + '"><td>' + s.anio + '/' + s.semana + '</td><td>' + (s.ab != null ? s.ab + '%' : '-') + '</td><td>' + (s.aa != null ? s.aa + '%' : '-') + '</td><td>' + (s.hb || '-') + '</td><td>' + (s.ha || '-') + '</td><td>' + ico + ' ' + s.st + '</td></tr>';
    });
    html += '</tbody></table><div style="text-align:center;margin-top:10px"><button class="btn btn-sm btn-info" onclick="volverADatosActuales()">← Volver</button></div>';
    $('#floatTableWrap').html(html);
  }).catch(e => toast('error', 'Error: ' + e));
}

function volverADatosActuales() {
  if (window._preservedFloatState) {
    let state = window._preservedFloatState;
    renderFloatTableDiv(window.modalFloatData);
  }
}

