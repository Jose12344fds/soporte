let mainTable, subTable;

function initMainTable() {
  mainTable = $('#tblOTs').DataTable({
    searching: true, paging: true, pageLength: 10, lengthChange: false, info: false, ordering: true,
    dom: 'rtip',
    ajax: {
      url: API.otsValidadas,
      method: 'POST',
      dataSrc: function (json) {
        if (Array.isArray(json)) return json;
        toast('error', (json && json.message) || 'No se pudieron cargar las OTs');
        return [];
      },
      error: function (xhr) {
        var message = xhr.status === 401 ? 'La sesion vencio. Ingrese nuevamente.' : 'No se pudieron cargar las OTs.';
        toast('error', message);
      }
    },
    columns: [
      { data: 'IdPadre' },
      { data: 'ProjectCode' },
      { data: 'NPdre' },
      { data: 'IdPadre', render: () => '<button class="btn-xs-acc" disabled title="Envio de correo pendiente de configuracion">Correo</button>' },
      { data: 'IdPadre', render: d => `<button class="btn-xs-acc validar btn-cambiarValidar" data-id="${d}">VALIDAR</button>` },
      { data: 'IdPadre', render: d => `<button class="btn-xs-acc cerrar btn-cambiar" data-id="${d}">CERRAR</button>` },
      { data: 'IdPadre', render: function(d, type, row) { return `<button class="btn-xs-acc cerrar btn-cerrar-semanas" data-id="${d}" data-project="${row.ProjectCode}" title="Cerrar todas las semanas abiertas de esta OT">🔒 Sem.</button>`; } }
    ],
    drawCallback: function () {
      var total  = this.api().rows().count();
      var filter = this.api().rows({ search: 'applied' }).count();
      var txt = total === filter
        ? total + ' OTs'
        : filter + ' / ' + total + ' OTs';
      $('#badgeCount').html('<i class="fa fa-database"></i> ' + total + ' OTs');
      $('#otCount').text(txt);
    }
  });

  // Buscador personalizado en header
  var searchTimer;
  $('#otSearch').on('input', function () {
    var val = $(this).val();
    $('#otSearchClear').toggle(val.length > 0);
    clearTimeout(searchTimer);
    searchTimer = setTimeout(function () {
      mainTable.search(val).draw();
    }, 250);
  });
  $('#otSearchClear').on('click', function () {
    $('#otSearch').val('');
    $(this).hide();
    mainTable.search('').draw();
  });

  // Clic en fila → cargar subconsulta
  $('#tblOTs tbody').on('click', 'tr', function () {
    var data = mainTable.row(this).data();
    if (!data) return;
    $('#tblOTs tbody tr').removeClass('fila-activa');
    $(this).addClass('fila-activa');
    currentIdPadre = data.IdPadre;
    fetchSubQuery(currentIdPadre);
  });
}

