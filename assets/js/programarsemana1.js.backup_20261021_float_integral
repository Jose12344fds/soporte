/* Cargar subconsulta */
function fetchSubQuery(idPadre) {
  if (idPadre) currentIdPadre = idPadre;
  if (!currentIdPadre) return;

  $('#subHint').hide();
  $('#subWrapper').show();

  $.ajax({
    url: API.items,
    method: 'POST',
    data: { idPadre: currentIdPadre, tipoConsulta: 1 },
    dataType: 'json',
    success: function (data) {
      subTable.clear().rows.add(data).draw();
      setTimeout(function() {
        subTable.columns.adjust();
        syncPEColumns();
        // Auto-scroll al bloque de ítems para que el footer quede debajo
        $('html, body').animate({ scrollTop: $('#cardSub').offset().top - 72 }, 380);
      }, 100);
    },
    error: function (xhr, st, err) {
      console.error('Error subconsulta:', err, xhr.responseText);
      toast('error', 'Error cargando ítems');
    }
  });
}

