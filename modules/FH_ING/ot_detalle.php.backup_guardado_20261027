                    '<td>' + fmtFecha(r.fecha_inicio || (r.created_at || '').substring(0, 10)) + '</td>' +
            '<td>' + fmtFecha(r.actualizado_al) + '</td>' +
                    '<td style="text-align:center;">' + btnVerHtml(r.ot) + '</td>' +
                    '</tr>';
            });
            tbody.innerHTML = html;
