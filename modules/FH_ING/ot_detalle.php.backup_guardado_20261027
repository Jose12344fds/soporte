        .then(function(data) {
            var rows = Array.isArray(data) ? data : [];
            if (badge) badge.textContent = rows.length || '0';
            if (!rows.length) {
                if (empty) empty.style.display = 'block';
                return;
            }
            if (wrapper) wrapper.style.display = '';
