var API_PROYECTOS   = '../../api/hhmeta/get_proyectos.php';
var API_GUARDAR     = '../../api/fh_ing/guardar_ot_detalle.php';
var API_REGISTROS   = '../../api/fh_ing/get_ot_detalle.php';
