    function _abrirHistorial(idPlanos, codPlano) {
        _histIdPlanos = idPlanos;
        _histCodPlano = codPlano;
        document.getElementById('histSubtitle').textContent = codPlano;
        var body = document.getElementById('histBody');
        body.innerHTML = '<div id="histLoading"><i class="fas fa-spinner fa-spin" style="font-size:1.5rem;margin-bottom:8px;display:block;"></i>Cargando historial…</div>';
        document.getElementById('histOverlay').classList.add('open');
        _cargarHistorial();
    }
    function _cerrarHistorial() {
        document.getElementById('histOverlay').classList.remove('open');
    }
    function _cargarHistorial() {
        fetch(API_DWG_HIST + '?id_planos=' + encodeURIComponent(_histIdPlanos))
            .then(function(r){ return r.json(); })
            .then(function(data) {
                if (!data.success) { _histRenderError(data.error || 'Error'); return; }
                // Subtitle
                document.getElementById('histSubtitle').textContent =
                    (data.cod_plano || '') + (data.desc_plano ? ' · ' + data.desc_plano : '');

                var body = document.getElementById('histBody');
                body.innerHTML = '';

                var historial = data.historial || [];   // versiones antiguas desc
                var actual    = data.actual || null;

                if (!historial.length) {
                    body.innerHTML = '<div id="histEmpty"><i class="fas fa-folder-open"></i>Solo hay una versión de este plano.<br><small>Cuando cambies el archivo CAD, las versiones anteriores aparecerán aquí.</small></div>';
                    return;
                }

                var totalVer = historial.length + 1; // +1 for current

                // ── Versión actual (siempre arriba) ──────────────────
                var currName = actual ? (actual.arch_original || actual.arch_plano || '—') : '—';
                var currBaseName = currName.split('/').pop();
                var currExt  = currBaseName.split('.').pop().toLowerCase();
                var currExt2 = _histExtClass(currExt);
                var currCard = '<div class="hv-entry current-ver">' +
                    '<div class="hv-dot current">v' + totalVer + '</div>' +
                    '<div class="hv-card">' +
                    '<div class="hv-card-top">' +
                    '<span class="hv-badge-curr">ACTUAL</span>' +
                    '<span class="hv-filename">' + _escH(currBaseName) + '</span>' +
                    '<span class="hv-ext ' + currExt2 + '">' + currExt.toUpperCase() + '</span>' +
                    '</div>' +
                    '<div class="hv-meta"><i class="fas fa-calendar-alt"></i> Versión vigente</div>' +
                    '<div class="hv-actions">' +
                    (actual && actual.arch_plano ? '<a class="hv-btn view" href="' + _histViewUrl(actual.arch_plano) + '" target="_blank"><i class="fas fa-eye"></i> Ver</a>' : '') +
                    (actual && actual.arch_plano ? '<a class="hv-btn dl" href="' + _histDlUrl(actual.arch_plano) + '"><i class="fas fa-download"></i> Descargar</a>' : '') +
                    '</div>' +
                    '</div></div>';
                body.insertAdjacentHTML('beforeend', currCard);

                // ── Versiones anteriores ─────────────────────────────
                historial.forEach(function(h, idx) {
                    var vnum  = totalVer - 1 - idx; // e.g. v2, v1...
                    var fname = h.arch_original || h.arch_plano || '—';
                    var bname = fname.split('/').pop();
                    var ext   = bname.split('.').pop().toLowerCase();
                    var extC  = _histExtClass(ext);
                    var size  = h.tamano ? _histFmtSize(h.tamano) : '';
                    var meta  = [h.usuario, h.fecha_str, size].filter(Boolean).join(' · ');
                    var card  = '<div class="hv-entry">' +
                        '<div class="hv-dot old">v' + vnum + '</div>' +
                        '<div class="hv-card">' +
                        '<div class="hv-card-top">' +
                        '<span class="hv-badge-ver">v' + vnum + '</span>' +
                        '<span class="hv-filename">' + _escH(bname) + '</span>' +
                        '<span class="hv-ext ' + extC + '">' + ext.toUpperCase() + '</span>' +
                        '</div>' +
                        '<div class="hv-meta"><i class="fas fa-user"></i> ' + _escH(meta) + '</div>' +
                        '<div class="hv-actions">' +
                        '<a class="hv-btn view" href="' + API_HIST_DOWN + '?id=' + h.id + '&ver=1" target="_blank"><i class="fas fa-eye"></i> Ver</a>' +
                        '<a class="hv-btn dl"   href="' + API_HIST_DOWN + '?id=' + h.id + '"       ><i class="fas fa-download"></i> Descargar</a>' +
                        '</div>' +
                        '</div></div>';
                    body.insertAdjacentHTML('beforeend', card);
                });
            })
            .catch(function(e) { _histRenderError(e.message); });
    }
    function _histRenderError(msg) {
        document.getElementById('histBody').innerHTML =
            '<div id="histEmpty"><i class="fas fa-exclamation-triangle" style="color:#e74c3c;"></i>' + _escH(msg) + '</div>';
    }
    function _histFmtSize(bytes) {
        if (!bytes) return '';
        if (bytes >= 1048576) return (bytes / 1048576).toFixed(1) + ' MB';
        if (bytes >= 1024)    return (bytes / 1024).toFixed(0) + ' KB';
        return bytes + ' B';
    }
    function _histExtClass(ext) {
        if (['dwg','dxf','dws','dwt'].indexOf(ext) >= 0) return 't-cad';
        if (ext === 'pdf') return 't-pdf';
        return 't-other';
    }
    function _histViewUrl(arch) {
        // Use existing diag_ver_plano for viewing CAD files
        var ext = (arch.split('.').pop() || '').toLowerCase();
        if (['dwg','dxf','dws','dwt'].indexOf(ext) >= 0)
            return '../../api/fh_ing/diag_ver_plano.php?id=' + _histIdPlanos;
        return '#';
    }
    function _histDlUrl(arch) {
        return '../../api/fh_ing/descargar_plano_dwg.php?id=' + _histIdPlanos;
    }
    function _escH(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

