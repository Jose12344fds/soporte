    function renderizarDXF(id, nombre) {
        if(APS_ENABLED) _renderizarConAPS(id, nombre); else _renderizarConThreeDxf(id, nombre);
    }

    function _renderizarConAPS(id, nombre) {
        var loading=document.getElementById('fileViewerLoading');
        var apsCanvas=document.getElementById('fileViewerApsCanvas');
        var dxfCanvas=document.getElementById('fileViewerDxfCanvas');
        var progressBar=document.getElementById('apsProgressBar');
        var progressMsg=document.getElementById('apsProgressMsg');
        loading.style.display='flex'; apsCanvas.style.display='none'; dxfCanvas.style.display='none';
        if(_apsPollTimer){clearTimeout(_apsPollTimer);_apsPollTimer=null;}
        var _apsStartTime=Date.now();
        var _apsFallbackShown=false;
        function pollEnsure(){
            fetch(API_APS_ENSURE+'?id='+encodeURIComponent(id))
                .then(function(r){return r.json();})
                .then(function(data){
                    if(!document.getElementById('fileViewerOverlay').classList.contains('open'))return;
                    if(data.status==='success'){_apsFallbackShown=false;_loadApsViewer(data.urn,apsCanvas,loading,id,nombre);}
                    else if(data.status==='failed'){loading.style.display='none';_renderizarConThreeDxf(id,nombre);}
                    else{
                        loading.style.display='none'; apsCanvas.style.display='block';
                        progressBar.style.width=Math.max(data.progress||0,2)+'%';
                        // Mensaje según etapa
                        var secs=Math.round((Date.now()-_apsStartTime)/1000);
                        var msg=data.message||'Procesando…';
                        if(data.progress<=3){msg='Subiendo archivo a la nube… ('+secs+'s)';}
                        else if(data.progress<100){msg='Traduciendo plano: '+(data.progress||0)+'% ('+secs+'s)';}
                        progressMsg.textContent=msg;
                        // Mostrar botón de descarga si lleva más de 90 segundos
                        if(!_apsFallbackShown && secs>90){
                            _apsFallbackShown=true;
                            var dlHtml='<div style="margin-top:8px;font-size:12px;color:#888;">Procesando en segundo plano…'+
                                '<a href="'+API_DOWN+'?id='+encodeURIComponent(id)+'" download="'+(nombre||'plano')+
                                '" style="margin-left:6px;color:#3498db;">Descargar DWG</a></div>';
                            var existing=apsCanvas.querySelector('.aps-dl-hint');
                            if(!existing){var el=document.createElement('div');el.className='aps-dl-hint';el.innerHTML=dlHtml;apsCanvas.appendChild(el);}
                        }
                        _apsPollTimer=setTimeout(pollEnsure,3000);
                    }
                })
                .catch(function(){loading.style.display='none';_renderizarConThreeDxf(id,nombre);});
        }
        pollEnsure();
    }

    function _loadApsViewer(urn, container, loading, id, nombre) {
        document.getElementById('apsProgressBar').style.width='0%';
        document.getElementById('apsProgressMsg').textContent='';
        function _initAndLoad(){
            if(_apsViewer){_apsLoadDoc(_apsViewer,urn,id,nombre);return;}
            Autodesk.Viewing.Initializer({env:'AutodeskProduction2',api:'streamingV2',
                getAccessToken:function(cb){fetch(API_APS_TOKEN).then(function(r){if(!r.ok)throw new Error('Token APS no disponible');return r.json();}).then(function(d){if(!d.access_token)throw new Error('Token APS vacío');cb(d.access_token,d.expires_in);}).catch(function(){_renderizarConThreeDxf(id,nombre);});}
            },function(){
                _apsViewer=new Autodesk.Viewing.GuiViewer3D(container,{extensions:['Autodesk.DocumentBrowser']});
                if(_apsViewer.start()>0){loading.style.display='none';_renderizarConThreeDxf(id,nombre);return;}
                _apsLoadDoc(_apsViewer,urn,id,nombre);
            });
        }
        if(typeof Autodesk==='undefined'){
            var link=document.createElement('link');link.rel='stylesheet';link.href='https://developer.api.autodesk.com/modelderivative/v2/viewers/7.*/style.min.css';document.head.appendChild(link);
            var script=document.createElement('script');script.src='https://developer.api.autodesk.com/modelderivative/v2/viewers/7.*/viewer3D.min.js';
            script.onload=function(){loading.style.display='none';container.style.display='block';_initAndLoad();};
            script.onerror=function(){loading.style.display='none';_renderizarConThreeDxf(id,nombre);};
            document.body.appendChild(script);
        } else {loading.style.display='none';container.style.display='block';_initAndLoad();}
    }

    function _apsLoadDoc(viewer, urn, id, nombre) {
        Autodesk.Viewing.Document.load('urn:'+urn,function(doc){
            var root=doc.getRoot();
            var views2d=root.search({type:'geometry',role:'2d'}); var views3d=root.search({type:'geometry',role:'3d'});
            var allViews=views2d.concat(views3d); if(!allViews.length) allViews=root.search({type:'geometry'});
            if(!allViews.length){_renderizarConThreeDxf(id,nombre);return;}
            var defaultView=views2d.length?views2d[0]:allViews[0];
            viewer.loadDocumentNode(doc,defaultView).then(function(){_apsLoadedPlanoId=Number(id);}).catch(function(){_renderizarConThreeDxf(id,nombre);});
            if(allViews.length>1) _buildApsSheetTabs(viewer,doc,allViews,0);
        },function(code,msg){console.warn('[APS]',code,msg);_renderizarConThreeDxf(id,nombre);});
    }

    function _buildApsSheetTabs(viewer, doc, views, activeIdx) {
        var ex=document.getElementById('apsSheetTabs'); if(ex) ex.remove();
        var tabsDiv=document.createElement('div'); tabsDiv.id='apsSheetTabs';
        tabsDiv.style.cssText='position:absolute;top:0;left:0;right:0;z-index:100;background:#1a1e23;border-bottom:1px solid #333;display:flex;overflow-x:auto;flex-shrink:0;';
        views.forEach(function(view,idx){
            var tab=document.createElement('button'); tab.textContent=view.data.name||('Vista '+(idx+1)); tab.dataset.idx=idx;
            tab.style.cssText='padding:5px 14px;background:'+(idx===activeIdx?'#27ae60':'transparent')+';color:#ddd;border:none;border-right:1px solid #333;cursor:pointer;white-space:nowrap;font-size:12px;flex-shrink:0;';
            tab.addEventListener('click',function(){
                viewer.loadDocumentNode(doc,view);
                Array.from(tabsDiv.children).forEach(function(b){b.style.background='transparent';b.style.color='#ddd';});
                tab.style.background='#27ae60'; tab.style.color='#fff';
            });
            tabsDiv.appendChild(tab);
        });
        document.getElementById('fileViewerApsCanvas').appendChild(tabsDiv);
    }

    function _destroyRenderer(){
        if(_threeDxfRenderer){try{_threeDxfRenderer.dispose?_threeDxfRenderer.dispose():null;}catch(e){}_threeDxfRenderer=null;}
    }
    function _getLayouts(dxf){
        var allEnts=dxf.entities||[]; var modelEnts=allEnts.filter(function(e){return !e.inPaperSpace;});
        return [{name:'Model',entities:modelEnts.length?modelEnts:allEnts}];
