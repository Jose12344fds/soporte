    function _mountLayout(layoutEntities, viewport){
        _destroyRenderer(); viewport.innerHTML='';
        var container=document.getElementById('fileViewerDxfCanvas');
        var w=container.offsetWidth||900; var h=Math.max(480,Math.round(w*0.6));
        viewport.style.width=w+'px'; viewport.style.height=h+'px';
        var dxfCopy={}; for(var k in _dxfParsed){if(_dxfParsed.hasOwnProperty(k))dxfCopy[k]=_dxfParsed[k];}
        dxfCopy.entities=layoutEntities;
        try{_threeDxfRenderer=new ThreeDxf.Viewer(dxfCopy,viewport,w,h,{font:null});}
        catch(e){viewport.innerHTML='<div style="color:#e74c3c;padding:20px;">Error: '+e.message+'</div>';}
    }
    function _renderizarConThreeDxf(id, nombre){
        document.getElementById('fileViewerApsCanvas').style.display='none';
        var container=document.getElementById('fileViewerDxfCanvas');
        var loading=document.getElementById('fileViewerLoading');
        loading.style.display='flex'; container.style.display='none'; container.innerHTML='';
        _destroyRenderer(); _dxfParsed=null;
        if(!id){loading.style.display='none';_visorShowFallback('APS Viewer no disponible',null,nombre);return;}
        fetch(API_DXF+'?id='+encodeURIComponent(id))
            .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.text();})
            .then(function(dxfText){
                var parser=new DxfParser();
                try{_dxfParsed=parser.parseSync(dxfText);}catch(e){throw new Error('Error al parsear DXF: '+e.message);}
                var layouts=_getLayouts(_dxfParsed);
                container.style.display='block';
                var viewport=document.createElement('div'); viewport.id='threeDxfViewport'; container.appendChild(viewport);
                loading.style.display='none'; _mountLayout(layouts[0].entities,viewport);
            })
            .catch(function(err){loading.style.display='none';_renderizarDXFcomoSVG(id,nombre);});
    }
    function _renderizarDXFcomoSVG(id, nombre){
        var canvas=document.getElementById('fileViewerDxfCanvas');
        var loading=document.getElementById('fileViewerLoading');
        loading.style.display='flex';
        fetch(API_VER+'?id='+encodeURIComponent(id),{cache:'no-store'})
            .then(function(r){
                var ct=r.headers.get('Content-Type')||'';
                if(ct.indexOf('json')!==-1)return r.json().then(function(d){if(d.error==='pending')throw new Error('__pending__');throw new Error(d.error||'Error');});
                if(!r.ok)throw new Error('HTTP '+r.status);return r.text();
            })
            .then(function(svg){
                if(!svg||svg.indexOf('<svg')===-1)throw new Error('SVG inválido');
                canvas.innerHTML=svg;
                var svgEl=canvas.querySelector('svg');
                if(svgEl){svgEl.removeAttribute('width');svgEl.removeAttribute('height');svgEl.style.cssText='width:100%;height:auto;display:block;';svgEl.setAttribute('preserveAspectRatio','xMidYMid meet');}
                loading.style.display='none'; canvas.style.display='block';
            })
            .catch(function(err){
                var msg=err.message||'';
                if(msg==='__pending__'){_visorShowPending(id,nombre);return;}
                loading.style.display='none'; _visorShowFallback(msg,id,nombre);
            });
    }
    function _visorShowPending(id, nombre){
        document.getElementById('fileViewerLoading').style.display='none';
        var fb=document.getElementById('fileViewerFallback');
        fb.style.display='flex';
        fb.innerHTML='<div class="fvf-icon"><i class="fas fa-cog fa-spin"></i></div>'+
            '<div class="fvf-title">Previsualización en generación</div>'+
            '<div class="fvf-msg">El archivo está siendo convertido. Reintentando en <span id="pendingCountdown">15</span>s…</div>';
        var secs=15;
        if(_pendingTimer) clearInterval(_pendingTimer);
        _pendingTimer=setInterval(function(){
            secs--; var cd=document.getElementById('pendingCountdown'); if(cd) cd.textContent=secs;
            if(secs<=0){clearInterval(_pendingTimer);_pendingTimer=null;
                if(document.getElementById('fileViewerOverlay').classList.contains('open')){fb.style.display='none';document.getElementById('fileViewerLoading').style.display='flex';renderizarDXF(id,nombre);}
            }
        },1000);
    }
    function _visorShowFallback(errMsg, id, nombre){
        var titleEl=document.getElementById('fvfTitle'); var msgEl=document.getElementById('fvfMsg'); var dlBtn=document.getElementById('fvfDownloadBtn');
        if(id){dlBtn.href=API_DOWN+'?id='+encodeURIComponent(id);dlBtn.setAttribute('download',nombre||'archivo');}
        titleEl.textContent='No se pudo previsualizar el archivo';
        msgEl.innerHTML=(errMsg||'Error al procesar.')+' Descárgalo para abrirlo con un programa compatible.';
        document.getElementById('fileViewerFallback').style.display='flex';
    }

    /* ─── Anotaciones ────────────────────────────────────────────────── */
    function _setObsPanel(open){
        _obsPanelOpen=open;
        var panel=document.getElementById('obsPanel'); var btn=document.getElementById('obsToggleBtn');
        if(open){panel.style.display='flex';btn.classList.add('active');_cargarObs(_obsIdPlanos);}
        else{panel.style.display='none';btn.classList.remove('active');}
    }
    function _cargarObs(id){
        _obsGalerias={};
        if(!id) return;
        var wrap=document.getElementById('obsListWrap');
        var loading=document.getElementById('obsLoading'); if(loading) loading.style.display='';
        var empty=document.getElementById('obsEmpty'); if(empty) empty.style.display='none';
        wrap.querySelectorAll('.obs-item').forEach(function(e){e.remove();});
        fetch(API_OBS_GET+'?id_planos='+encodeURIComponent(id))
            .then(function(r){return r.json();})
            .then(function(data){
                if(loading) loading.style.display='none';
                if(Number(id)!==Number(_obsIdPlanos))return;
                var list=Array.isArray(data)?data:(data.obs||[]);
                if(!list.length){if(empty) empty.style.display='';return;}
                list.forEach(function(o){
                    var div=document.createElement('div'); div.className='obs-item';
                    var imgHtml='';
                    if(o.imagenes&&o.imagenes.length){
                        var galeria=o.imagenes.map(function(im){return {url:API_OBS_IMG_VER+'?id='+encodeURIComponent(im.id),title:im.nombre||'Imagen adjunta'};});
                        o.imagenes.forEach(function(im,i){_obsGalerias[im.id]={items:galeria,index:i};});
                        imgHtml='<div class="obs-img-row">';
                        o.imagenes.forEach(function(im){
                            imgHtml+='<button type="button" style="border:0;padding:0;background:none;" aria-label="Ampliar '+escHtml(im.nombre||'imagen')+'" onclick="window._verObsImg('+im.id+')"><img class="obs-thumb" src="'+API_OBS_IMG_VER+'?id='+im.id+'" alt="'+escHtml(im.nombre||'Imagen adjunta')+'"></button>';
                        });
                        imgHtml+='</div>';
                    }
                    div.innerHTML='<div class="obs-item-meta"><span>'+escHtml(o.usuario||'')+'</span><span>'+escHtml(o.fecha||'')+'</span></div>'+
                        '<div class="obs-item-text">'+escHtml(o.texto||'')+'</div>'+imgHtml;
                    wrap.appendChild(div);
                });
            })
            .catch(function(){if(loading)loading.style.display='none';});
    }
    var _obsPendiente=null;
    function _guardarObs(){
        var texto=document.getElementById('obsTexto').value.trim(),plano=_obsIdPlanos;
        var msg=document.getElementById('obsMsg'),btn=document.getElementById('obsGuardar');
        if(!texto){msg.textContent='Escribe una anotación antes de guardar.';return;}
        if(!plano){msg.textContent='Guarda el plano antes de agregar anotaciones.';return;}
        btn.disabled=true;msg.textContent='Guardando anotación…';
        var pendientes=_obsImgFiles.slice();
        var request=(_obsPendiente&&_obsPendiente.plano===plano&&_obsPendiente.texto===texto)
            ?Promise.resolve({success:true,obs:{id:_obsPendiente.id}})
            :fetch(API_OBS_SAVE,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id_planos:plano,ot:selectedOT,cod_plano:_obsCodPlano,texto:texto})}).then(function(r){return r.json();});
        return request.then(function(data){
            if(!data.success||!data.obs||!data.obs.id)throw new Error(data.error||data.message||'No se pudo guardar la nota.');
            _obsPendiente={id:data.obs.id,plano:plano,texto:texto};
            return Promise.all(pendientes.map(function(file){
                var fd=new FormData();fd.append('image',file);fd.append('id_obs',data.obs.id);
                return fetch(API_OBS_IMG,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
                    if(!res.ok)throw new Error(res.error||'No se pudo subir la imagen.');
                    var i=_obsImgFiles.indexOf(file);if(i>=0)_obsImgFiles.splice(i,1);return null;
                }).catch(function(err){return err.message||'Error al subir imagen.';});
            }));
        }).then(function(errores){
            if(plano!==_obsIdPlanos)return;
            _renderObsImgPreview();_cargarObs(plano);
            var fallos=errores.filter(Boolean);
            if(fallos.length){msg.style.color='#b45309';msg.textContent='Nota guardada; '+fallos.length+' imagen(es) pendientes. '+fallos[0]+' Pulsa Guardar para reintentar.';return;}
            _obsPendiente=null;document.getElementById('obsTexto').value='';
            msg.style.color='#15803d';msg.textContent='Anotación e imágenes guardadas.';
        }).catch(function(err){msg.style.color='#b91c1c';msg.textContent='No se completó el guardado: '+err.message;})
          .finally(function(){btn.disabled=false;});
    }
    var _obsPreviewUrls=[];
    function _renderObsImgPreview(){
        _obsPreviewUrls.forEach(function(u){URL.revokeObjectURL(u);});_obsPreviewUrls=[];
        var preview=document.getElementById('obsImgPreview');preview.innerHTML='';
        _obsImgFiles.forEach(function(f,i){
            var item=document.createElement('div');item.className='obs-img-prev-item';
            var url=URL.createObjectURL(f);_obsPreviewUrls.push(url);
            var im=document.createElement('img');im.src=url;im.alt=f.name;
            im.addEventListener('click',function(){FHReview.openGallery(_obsImgFiles.map(function(file,j){return {url:_obsPreviewUrls[j],title:file.name};}),i);});
            var del=document.createElement('button');del.type='button';del.className='obs-img-prev-del';del.textContent='×';del.title='Quitar imagen';
            del.addEventListener('click',function(){_obsImgFiles.splice(i,1);_renderObsImgPreview();});
            item.appendChild(im);item.appendChild(del);preview.appendChild(item);
        });
    }
    function _obsImgSelected(filesArg){
        var input=document.getElementById('obsImgInput');
        var files=filesArg&&filesArg.target?filesArg.target.files:(filesArg||input.files);
        Array.from(files).forEach(function(f){if(/^image\//.test(f.type))_obsImgFiles.push(f);});
        _renderObsImgPreview();input.value='';
    }
    function _marcarCaptura(){
        _setObsPanel(true);
        var msg=document.getElementById('obsMsg');
        if(!_apsViewer||!_apsViewer.model||_apsLoadedPlanoId!==Number(_obsIdPlanos)||document.getElementById('fileViewerApsCanvas').style.display==='none'){
            msg.textContent='Abre el DWG en el visor Autodesk y espera a que termine de cargar para marcar una captura.';return;
        }
        var plano=_obsIdPlanos;var boton=document.getElementById('obsMarcarBtn');boton.disabled=true;msg.textContent='Preparando captura…';
        var espera=setTimeout(function(){boton.disabled=false;msg.textContent='La captura tarda en generarse. Puedes intentarlo nuevamente.';},20000);
        try{_apsViewer.getScreenShot(1600,1000,function(url){
            clearTimeout(espera);boton.disabled=false;
            if(plano!==_obsIdPlanos||!document.getElementById('fileViewerOverlay').classList.contains('open')){if(url)URL.revokeObjectURL(url);return;}
            if(!url){msg.textContent='No se pudo capturar la vista actual.';return;}
            msg.textContent='';
            FHReview.openMarkup(url,{title:_obsCodPlano||'Plano DWG',revokeURL:true,onAttach:function(file){
                _obsImgSelected([file]);var text=document.getElementById('obsTexto');
                if(!text.value.trim())text.value='Revisión gráfica del plano '+(_obsCodPlano||'DWG');
                msg.textContent='Captura marcada adjunta. Pulsa Guardar anotación para conservarla.';text.focus();
            }});
        });}catch(err){clearTimeout(espera);boton.disabled=false;msg.textContent='No se pudo preparar la captura. Intenta nuevamente.';}
    }

    /* ─── Vista previa (backward compat) ────────────────────────────── */
    function abrirPreview(evt, ot) {
        if(evt){evt.stopPropagation();evt.preventDefault();}
        var modal=document.getElementById('modalPreview');
        if(!modal) return;
        document.getElementById('modalOTLabel').textContent='OT: '+ot;
        document.getElementById('modalProyLabel').textContent='Cargando…';
        document.getElementById('modalEstadoBadge').textContent='';
        document.getElementById('modalResumenMods').innerHTML='<span style="color:#6c757d;font-size:.85rem;"><i class="fas fa-spinner fa-spin"></i> Cargando resumen…</span>';
        document.getElementById('modalGanttContainer').innerHTML='';
        modal.style.display='';
        fetch(API_RESUMEN+'?ot='+encodeURIComponent(ot))
            .then(function(r){return r.json();})
            .then(function(d){if(!d.success)throw new Error(d.message||'Error'); renderModalContenido(d);})
            .catch(function(err){document.getElementById('modalResumenMods').innerHTML='<span style="color:#e74c3c;"><i class="fas fa-exclamation-triangle"></i> '+escHtml(err.message)+'</span>';});
    }
    function cerrarModal(){var m=document.getElementById('modalPreview');if(m)m.style.display='none';}
    window.cerrarModal=cerrarModal; window.abrirPreview=abrirPreview;

    var ESTADO_LABELS={'-1':'Sin cronograma','0':'En progreso','1':'En progreso','2':'Módulo 2','3':'Finalizado'};
    var ESTADO_COLORS={'-1':'#6c757d','0':'#f39c12','1':'#2980b9','2':'#8e44ad','3':'#27ae60'};
    var MOD_COLORS={
        'm1':['#2980b9','#3498db','#1abc9c','#16a085','#27ae60','#1e8449','#2ecc71','#117a65'],
        'm2':['#e67e22','#d35400','#e74c3c','#c0392b','#f39c12','#e67e22','#e84393','#9b59b6'],
        'm3':['#8e44ad','#9b59b6','#6c3483','#a569bd','#7d3c98','#5b2c6f','#c39bd3','#7fb3d3'],
    };

    function renderModalContenido(d){
        var estado=String(d.estado);
        document.getElementById('modalProyLabel').textContent=d.proyecto||'—';
        var badge=document.getElementById('modalEstadoBadge');
        badge.textContent=ESTADO_LABELS[estado]||('Estado '+estado);
        badge.style.background=ESTADO_COLORS[estado]||'#6c757d';
        var resHtml=''; var modDefs=[
            {key:'m1',icon:'fa-list-ol',label:'Módulo 1 — Actividades',color:'#2980b9'},
            {key:'m2',icon:'fa-table',label:'Módulo 2 — Planos',color:'#e67e22'},
            {key:'m3',icon:'fa-drafting-compass',label:'Módulo 2 — Detalle',color:'#8e44ad'},
        ];
        modDefs.forEach(function(m){
            var mod=d['mod'+m.key.substring(1)]; if(!mod) return;
            resHtml+='<div style="background:'+m.color+'18;border:1.5px solid '+m.color+'44;border-radius:8px;padding:10px 16px;min-width:180px;flex:1;">'+
                '<div style="font-size:.78rem;font-weight:700;color:'+m.color+';margin-bottom:4px;"><i class="fas '+m.icon+'"></i> '+m.label+'</div>'+
                '<div style="font-size:1.1rem;font-weight:700;color:#2c3e50;">'+(m.key==='m3'?Number((mod.total_dias/8).toFixed(2)):mod.total_dias)+' días · '+Number((m.key==='m3'?mod.total_dias:mod.total_dias*8).toFixed(2))+' h</div>'+
                (mod.fecha_inicio?'<div style="font-size:.75rem;color:#6c757d;">desde '+fmtDateStr(mod.fecha_inicio)+'</div>':'')+
                '<div style="font-size:.75rem;color:#6c757d;">'+(mod.items?mod.items.length:0)+' elemento'+((mod.items||[]).length!==1?'s':'')+'</div>'+
                '</div>';
        });
        document.getElementById('modalResumenMods').innerHTML=resHtml;
        renderModalGantt(d);
    }

    function renderModalGantt(d){
        var grupos={}, acts=[];
        (d.mod2&&d.mod2.items||[]).forEach(function(p){
            var id=p.actividad_id||0;
            if(!grupos[id]){grupos[id]={actividad_id:id,nombre:p.actividad_nombre||'Planos de ingeniería',planos:[]};acts.push(grupos[id]);}
            grupos[id].planos.push(p);
        });
        var detalle=(d.mod3&&d.mod3.items||[]).map(function(p){return {cod_plano:p.cod_plano,desc_plano:p.desc_mod3,dias:(Number(p.dias)||0)/8};});
        if(detalle.length)acts.push({actividad_id:'detalle',nombre:'Detalle · duración convertida de horas',planos:detalle});
        if(!acts.length){document.getElementById('modalGanttContainer').innerHTML='<p>Sin planos con duración.</p>';return;}
        renderGantt(acts,'modalGanttContainer',d.fecha_inicio);
    }

    if(document.getElementById('modalPreview')){
        document.getElementById('modalPreview').addEventListener('click', function(e){ if(e.target===this) cerrarModal(); });
    }

}());
</script>

