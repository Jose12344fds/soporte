    function _antFileIcon(ext){
        var cad=['dwg','dxf','dws','dwt'];
        var img=['jpg','jpeg','png','gif','bmp','tif','tiff','webp'];
        var zip=['zip','rar','7z'];
        var doc=['doc','docx','txt'];
        var xls=['xls','xlsx'];
        if(cad.indexOf(ext)>=0) return {icon:'fas fa-drafting-compass', cls:'t-cad', label:'CAD'};
        if(ext==='pdf')          return {icon:'fas fa-file-pdf',        cls:'t-pdf', label:'PDF'};
        if(img.indexOf(ext)>=0)  return {icon:'fas fa-image',           cls:'t-img', label:'IMG'};
        if(zip.indexOf(ext)>=0)  return {icon:'fas fa-file-archive',    cls:'t-zip', label:'ZIP'};
        if(doc.indexOf(ext)>=0)  return {icon:'fas fa-file-alt',        cls:'t-doc', label:'DOC'};
        if(xls.indexOf(ext)>=0)  return {icon:'fas fa-file-excel',      cls:'t-xls', label:'XLS'};
        return {icon:'fas fa-file', cls:'t-other', label:ext.toUpperCase()||'?'};
    }
    function _antFmtSize(bytes){
        if(bytes>1024*1024) return (bytes/1024/1024).toFixed(1)+' MB';
        return Math.ceil(bytes/1024)+' KB';
    }
    function _cargarAntArchivos(){
        var grid=document.getElementById('antGrid');
        var empty=document.getElementById('antEmpty');
        var cntEl=document.getElementById('antCount');
        grid.querySelectorAll('.ant-file-card').forEach(function(e){e.remove();});
        if(empty) empty.style.display='flex';
        document.getElementById('antAlert').innerHTML='';
        fetch(API_ANT_LIST+'?ot='+encodeURIComponent(selectedOT)+'&actividad_id='+encodeURIComponent(_antActId))
            .then(function(r){
                var ct=r.headers.get('content-type')||'';
                if(!ct.includes('json')){ return r.text().then(function(t){ throw new Error('Respuesta no-JSON del servidor. ¿Las tablas SQL están creadas? Detalle: '+t.substring(0,120)); }); }
                return r.json();
            })
            .then(function(data){
                var list=data.archivos||[];
                cntEl.innerHTML='<i class="fas fa-paperclip"></i> '+list.length+' '+(list.length===1?'archivo':'archivos');
                // update table badge
                var badge=document.getElementById('antCountBadge_'+_antActId);
                if(badge) badge.innerHTML='<i class="fas fa-paperclip"></i> '+list.length+' '+(list.length===1?'archivo':'archivos');
                if(!list.length){ if(empty) empty.style.display='flex'; return; }
                if(empty) empty.style.display='none';
                list.forEach(function(f){
                    var ext=(f.nombre_original||'').split('.').pop().toLowerCase();
                    var ico=_antFileIcon(ext);
                    var isImg=['jpg','jpeg','png','gif','bmp','webp'].indexOf(ext)>=0;
                    var isPdf=ext==='pdf';
                    var card=document.createElement('div'); card.className='ant-file-card';
                    card.innerHTML=
                        '<span class="afc-badge '+ico.cls+'">'+ico.label+'</span>'+
                        '<div class="afc-icon '+ico.cls+'"><i class="'+ico.icon+'"></i></div>'+
                        '<div class="afc-name" title="'+escHtml(f.nombre_original||'')+'">'+escHtml(f.nombre_original||'')+'</div>'+
                        '<div class="afc-meta">'+escHtml(f.usuario||'')+' · '+_antFmtSize(parseInt(f.tamano||0))+'</div>'+
                        '<div class="afc-meta">'+escHtml(f.fecha_str||'')+'</div>'+
                        '<div class="afc-actions">'+
                          '<a class="afc-btn dl" href="'+API_ANT_DOWN+'?id='+f.id+'" target="_blank" title="Descargar"><i class="fas fa-download"></i></a>'+
                          ((isImg||isPdf)?'<a class="afc-btn dl" href="'+API_ANT_DOWN+'?id='+f.id+'&inline=1" target="_blank" title="Ver"><i class="fas fa-eye"></i></a>':'')+
                          '<button class="afc-btn del" onclick="_antDelArchivo('+f.id+')" title="Eliminar"><i class="fas fa-trash"></i></button>'+
                        '</div>';
                    grid.appendChild(card);
                });
            }).catch(function(err){
                document.getElementById('antAlert').innerHTML='<span style="color:#e74c3c"><b>Error al cargar archivos:</b> '+(err&&err.message?escHtml(err.message):'Verifica que la tabla fh_ing_ant_archivos existe en la BD')+'</span>';
            });
    }
    function _antFilesSelected(files){
        if(!files||!files.length) return;
        if(!selectedOT){ document.getElementById('antAlert').innerHTML='<span style="color:#e74c3c">Selecciona una OT primero.</span>'; return; }
        var prog=document.getElementById('antUploadProgress');
        prog.innerHTML=''; prog.style.display='block';
        document.getElementById('antAlert').innerHTML='';
        var arr=Array.from(files);
        var done=0;
        arr.forEach(function(file){
            var item=document.createElement('div'); item.className='ant-prog-item';
            item.innerHTML='<span style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">'+escHtml(file.name)+'</span>'+
                '<div class="ant-prog-bar-wrap"><div class="ant-prog-bar" style="width:0%"></div></div>'+
                '<span class="ant-prog-status">0%</span>';
            prog.appendChild(item);
            var bar=item.querySelector('.ant-prog-bar');
            var stat=item.querySelector('.ant-prog-status');
            var fd=new FormData();
            fd.append('file', file);
            fd.append('ot', selectedOT);
            fd.append('actividad_id', _antActId);
            var xhr=new XMLHttpRequest();
            xhr.open('POST', API_ANT_UPLOAD);
            var csrfToken = window.CSRF_TOKEN || (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
            if (csrfToken) {
                xhr.setRequestHeader('X-CSRF-Token', csrfToken);
                fd.append('_csrf', csrfToken);
            }
            xhr.upload.addEventListener('progress', function(e){
                if(e.lengthComputable){var pct=Math.round(e.loaded/e.total*100); bar.style.width=pct+'%'; stat.textContent=pct+'%';}
            });
            xhr.onload=function(){
                done++;
                try{ var res=JSON.parse(xhr.responseText);
                    if(res.ok){ bar.style.width='100%'; stat.style.color='#27ae60'; stat.textContent='✓'; }
                    else{ stat.style.color='#e74c3c'; stat.textContent='Error'; document.getElementById('antAlert').innerHTML='<span style="color:#e74c3c"><b>Error al subir:</b> '+escHtml(res.error||'Respuesta inesperada del servidor')+'</span>'; }
                }catch(e){ stat.style.color='#e74c3c'; stat.textContent='Error'; document.getElementById('antAlert').innerHTML='<span style="color:#e74c3c"><b>Error del servidor:</b> '+escHtml(xhr.responseText.substring(0,200))+'</span>'; }
                if(done===arr.length){ setTimeout(function(){ prog.style.display='none'; prog.innerHTML=''; _cargarAntArchivos(); },1200); }
            };
            xhr.onerror=function(){ done++; stat.style.color='#e74c3c'; stat.textContent='Fallo'; document.getElementById('antAlert').innerHTML='<span style="color:#e74c3c">Error de red al subir archivos.</span>'; if(done===arr.length){ setTimeout(function(){ prog.style.display='none'; prog.innerHTML=''; _cargarAntArchivos(); },1200); } };
            xhr.send(fd);
        });
    }
    function _antDelArchivo(id){
        if(!confirm('¿Eliminar este archivo? Esta acción no se puede deshacer.')) return;
        fetch(API_ANT_DEL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})})
