    /* ─── Gantt ──────────────────────────────────────────────────────── */
    function renderGantt(actividades, targetId, fechaBase) {
        var section=document.getElementById(targetId||'ganttSection');
        var container=document.getElementById(targetId||'ganttContainer');
        var allPlanos=[];
        var inicio=fechaBase||document.getElementById('fechaInicioProy').value;
        if(inicio)actividades=FHCalendar.activities(actividades,inicio);
        actividades.forEach(function(act,ai){
            (act.planos||[]).forEach(function(p){
                if(p.fecha_inicio&&p.fecha_fin&&parseFloat(p.dias)>0){
                    allPlanos.push({
                        actId:act.actividad_id, actNome:act.nombre||'',
                        actColor:COLORS[ai%COLORS.length], actIdx:ai,
                        cod:p.cod_plano||'', desc:p.desc_plano||'',
                        segmentos:p.segmentos||[],
                        dias:parseFloat(p.dias), fi:parseDate(p.fecha_inicio), ff:parseDate(p.fecha_fin),
                    });
                }
            });
        });
        if(!allPlanos.length){section.style.display='none'; return;}
        var pStart=allPlanos.reduce(function(m,p){return p.fi<m?p.fi:m;},allPlanos[0].fi);
        var pEnd=allPlanos.reduce(function(m,p){return p.ff>m?p.ff:m;},allPlanos[0].ff);
        var totalDays=daysBetween(pStart,pEnd)+1;
        if(!targetId)document.getElementById('btnReporteCronograma').href=API_GANTT+'?ot='+encodeURIComponent(selectedOT);
        var meses=['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
        var segments=[]; var cur=new Date(pStart.getFullYear(),pStart.getMonth(),1);
        while(cur<=pEnd){
            var segS=cur<pStart?new Date(pStart):new Date(cur);
            var nextM=new Date(cur.getFullYear(),cur.getMonth()+1,1);
            var segE=nextM>pEnd?new Date(pEnd):new Date(nextM.getTime()-86400000);
            segments.push({label:meses[cur.getMonth()]+' '+cur.getFullYear(),pct:((daysBetween(segS,segE)+1)/totalDays*100).toFixed(3)});
            cur=nextM;
        }
        var html='<p style="color:#475569;font-size:.82rem;margin:8px 0;">Planificación · lunes a viernes · 8 h por jornada · 0,5 días = 4 h. Sin feriados.</p><div class="gantt-wrapper">';
        html+='<div class="gantt-row gantt-header-row"><div class="gantt-left-col"><div class="gh-act"><i class="fas fa-tasks" style="margin-right:5px;"></i>Plano</div><div class="gh-dias">Duración</div></div>';
        html+='<div class="gantt-timeline-col"><div class="gantt-months">';
        segments.forEach(function(s){html+='<div class="gantt-month-seg" style="width:'+s.pct+'%">'+s.label+'</div>';});
        html+='</div></div></div>';
        var calendario='', fondos='';
        for(var di=0;di<totalDays;di++){
            var dia=addDays(pStart,di),finSemana=dia.getDay()===0||dia.getDay()===6;
            if(finSemana)fondos+='<span style="position:absolute;inset:0 auto 0 '+(di/totalDays*100)+'%;width:'+(100/totalDays)+'%;background:#e8edf3;"></span>';
            calendario+='<span style="width:'+(100/totalDays)+'%;background:'+(finSemana?'#e8edf3':'#f8fafc')+';">'+(totalDays<=90?dia.getDate()+'/'+(dia.getMonth()+1):(di%7===0?dia.getDate()+'/'+(dia.getMonth()+1):''))+'</span>';
        }
        html+='<div class="gantt-row" style="min-height:27px;"><div class="gantt-left-col"><div class="gh-act" style="font-size:.72rem;">Calendario · gris = fin de semana</div></div><div class="gantt-timeline-col"><div class="gantt-calendar-days">'+calendario+'</div></div></div>';
        var currentActId=null;
        allPlanos.forEach(function(p){
            if(p.actId!==currentActId){
                currentActId=p.actId;
                html+='<div class="gantt-row" style="background:'+p.actColor+'22;border-left:4px solid '+p.actColor+';">';
                html+='<div class="gantt-left-col" style="padding:5px 10px;"><div class="gh-act" style="font-weight:700;font-size:.78rem;color:#374151;"><i class="fas fa-layer-group" style="margin-right:4px;color:'+p.actColor+'"></i>'+escHtml(p.actNome)+'</div><div class="gh-dias" style="font-size:.75rem;color:#888">act.</div></div>';
                html+='<div class="gantt-timeline-col"><div class="gantt-bar-track" style="background:transparent;"></div></div></div>';
            }
            var offsetPct=(daysBetween(pStart,p.fi)/totalDays*100).toFixed(3);
            var widthPct=(p.dias/totalDays*100).toFixed(3);
            var tooltip=fmtDate(p.fi)+' → '+fmtDate(p.ff)+' ('+p.dias+' días / '+(p.dias*8)+'h)';
            var barLabel=fmtShort(p.fi)+' – '+fmtShort(p.ff);
            html+='<div class="gantt-row gantt-act-row">';
            html+='<div class="gantt-left-col"><div class="gh-act" style="padding-left:18px;font-size:.82rem;"><span class="act-dot" style="background:'+p.actColor+'"></span>'+escHtml(p.cod?p.cod:p.desc)+'</div><div class="gh-dias">'+fmtDias(p.dias)+' d<small>'+Number((p.dias*8).toFixed(2))+' h</small></div></div>';
            var barras=p.segmentos.map(function(seg){
                var left=(daysBetween(pStart,parseDate(seg.fecha))+seg.inicio)/totalDays*100;
                var width=seg.fraccion/totalDays*100;
                return '<div class="gantt-bar" style="position:absolute;left:'+left+'%;width:'+width+'%;min-width:0;background:'+p.actColor+';" title="'+escHtml(tooltip+' · '+seg.fecha+' · '+Number(seg.horas.toFixed(2))+' h')+'"><span class="gantt-bar-label">'+Number(seg.horas.toFixed(2))+' h</span></div>';
            }).join('');
            html+='<div class="gantt-timeline-col"><div class="gantt-bar-track" style="position:relative;">'+fondos+barras+'</div></div></div>';
        });
        var totalDiasSum=allPlanos.reduce(function(s,p){return s+p.dias;},0);
        html+='<div class="gantt-row gantt-summary-row"><div class="gantt-left-col"><div class="gh-act"><strong>Total Proyecto</strong></div><div class="gh-dias"><strong>'+totalDiasSum+'</strong></div></div>';
        html+='<div class="gantt-timeline-col"><div class="gantt-summary-info"><i class="fas fa-calendar-check"></i> '+fmtDate(pStart)+' → '+fmtDate(pEnd)+' &nbsp;|&nbsp; <strong>'+totalDays+'</strong> días calendario &nbsp;|&nbsp; <strong>'+(totalDiasSum*8)+'h</strong></div></div></div>';
        html+='</div>';
        container.innerHTML=html;
        if(!targetId)document.getElementById('ganttBadge').textContent=allPlanos.length+' planos';
        section.style.display='';
    }

