    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('filterOTs').addEventListener('input', filtrarOTs);
        document.getElementById('btnCambiarOT').addEventListener('click', volverAlListado);
        document.getElementById('fechaInicioProy').addEventListener('change', recalcAll);
        document.getElementById('btnGuardar').addEventListener('click', guardarCronograma);
        document.getElementById('btnAprobarMod3').addEventListener('click', aprobarModulo3);
        document.getElementById('btnRetroceder').addEventListener('click', retrocederOT);
        document.getElementById('finalizadosToggle').addEventListener('click', toggleFinalizados);
        document.getElementById('obsMarcarBtn').addEventListener('click',_marcarCaptura);
        document.getElementById('obsToggleBtn').addEventListener('click', function(){ _setObsPanel(!_obsPanelOpen); });
        document.getElementById('obsCloseBtn').addEventListener('click', function(){ _setObsPanel(false); });
        document.getElementById('obsGuardar').addEventListener('click', _guardarObs);
        document.getElementById('fileViewerClose').addEventListener('click', cerrarVisor);
        document.getElementById('fileViewerOverlay').addEventListener('click', function(e){ if(e.target===this) cerrarVisor(); });
        document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ cerrarVisor(); _cerrarAnt(); _cerrarHistorial(); } });
        /* Antecedentes modal */
        document.getElementById('antCloseBtn').addEventListener('click', _cerrarAnt);
        document.getElementById('antOverlay').addEventListener('click', function(e){ if(e.target===this) _cerrarAnt(); });
        document.getElementById('antFileInput').addEventListener('change', function(){ _antFilesSelected(this.files); this.value=''; });
        document.getElementById('obsImgInput').addEventListener('change', _obsImgSelected);
        /* Drag & drop en el label de imagen de anotaciones */
        var obsImgLbl = document.getElementById('obsImgLabel');
        obsImgLbl.addEventListener('dragover',  function(e){ e.preventDefault(); obsImgLbl.classList.add('drag-over'); });
        obsImgLbl.addEventListener('dragleave', function(e){ if(!obsImgLbl.contains(e.relatedTarget)) obsImgLbl.classList.remove('drag-over'); });
        obsImgLbl.addEventListener('drop', function(e){
            e.preventDefault(); obsImgLbl.classList.remove('drag-over');
            if(e.dataTransfer.files && e.dataTransfer.files.length) _obsImgSelected(e.dataTransfer.files);
        });
        /* Pegar imagen con Ctrl+V cuando el panel de anotaciones está abierto */
        document.addEventListener('paste', function(e){
            if(!_obsPanelOpen) return;
            var items = e.clipboardData && e.clipboardData.items;
            if(!items) return;
            var imgFiles = [];
            for(var i=0;i<items.length;i++){
                if(items[i].type.match(/^image\//)){
                    var f = items[i].getAsFile();
                    if(f) imgFiles.push(f);
                }
            }
            if(!imgFiles.length) return;
            e.preventDefault();
            _obsImgSelected(imgFiles);
            /* Feedback visual en el label */
            obsImgLbl.classList.remove('paste-ok');
            void obsImgLbl.offsetWidth; /* reflow para reiniciar animación */
            obsImgLbl.classList.add('paste-ok');
            setTimeout(function(){ obsImgLbl.classList.remove('paste-ok'); }, 600);
        });
        var antDZ = document.getElementById('antDropZone');
        antDZ.addEventListener('dragover',  function(e){ e.preventDefault(); antDZ.classList.add('drag-over'); });
        antDZ.addEventListener('dragleave', function(){ antDZ.classList.remove('drag-over'); });
        antDZ.addEventListener('drop', function(e){ e.preventDefault(); antDZ.classList.remove('drag-over'); if(e.dataTransfer.files.length) _antFilesSelected(e.dataTransfer.files); });
        /* Historial DWG */
        document.getElementById('histCloseBtn').addEventListener('click', _cerrarHistorial);
        document.getElementById('histOverlay').addEventListener('click', function(e){ if(e.target===this) _cerrarHistorial(); });
        cargarActividades();
        cargarOTsRegistradas();
    });

    /* ─── Cargar actividades ─────────────────────────────────────────── */
    function cargarActividades() {
        fetch(API_ACTIVIDADES)
            .then(function(r){ return r.json(); })
            .then(function(data){
                if(data.error) throw new Error(data.error);
                todasActividades = Array.isArray(data) ? data : [];
            })
            .catch(function(err){ console.error('Error actividades:', err.message); });
    }

    /* ─── Cargar OTs ─────────────────────────────────────────────────── */
    function cargarOTsRegistradas() {
        fetch(API_OTS)
            .then(function(r){ return r.json(); })
            .then(function(data){
                if(data.error) throw new Error(data.error);
                todasOTs = Array.isArray(data) ? data : [];
                renderOTList(todasOTs);
            })
            .catch(function(err){
                document.getElementById('otListLoading').innerHTML =
                    '<i class="fas fa-exclamation-triangle"></i><p>Error: '+escHtml(err.message)+'</p>';
            });
    }

    function renderOTList(lista) {
        var loading=document.getElementById('otListLoading');
        var empty=document.getElementById('otListEmpty');
        var wrapper=document.getElementById('otListWrapper');
        var badge=document.getElementById('badgeOTs');
        loading.style.display='none';
        badge.textContent=lista.length+' OT'+(lista.length!==1?'s':'');
        if(!lista.length){ empty.style.display=''; wrapper.style.display='none'; return; }
        empty.style.display='none'; wrapper.style.display='';
        var html='';
        lista.forEach(function(r){
            var ep=parseInt(r.estado_plano);
            var estadoBadge;
            if(ep<0||!parseInt(r._tiene_plano))
                estadoBadge='<span class="badge badge-secondary"><i class="fas fa-minus"></i> Sin cronograma</span>';
            else if(ep===0)
                estadoBadge='<span class="badge" style="background:#f39c12;color:#fff;"><i class="fas fa-pencil-alt"></i> En progreso</span>';
            else
                estadoBadge='<span class="badge badge-info"><i class="fas fa-check"></i> Con planos</span>';
            html+='<tr data-ot="'+escHtml(r.ot)+'" data-proy="'+escHtml(r.proyecto)+'" data-estado="'+ep+'" style="cursor:pointer;">'+
                '<td><strong>'+escHtml(r.ot)+'</strong></td>'+
                '<td>'+escHtml(r.proyecto)+'</td>'+
                '<td>'+(r.elaborado_por?escHtml(r.elaborado_por):'<span class="text-muted">—</span>')+'</td>'+
                '<td>'+(r.actualizado_al?fmtDateStr(r.actualizado_al):'<span class="text-muted">—</span>')+'</td>'+
                '<td style="text-align:center;">'+estadoBadge+'</td>'+
                '</tr>';
        });
        document.getElementById('tblOTsBody').innerHTML=html;
        document.querySelectorAll('#tblOTsBody tr[data-ot]').forEach(function(tr){
            tr.addEventListener('click', function(){
                seleccionarOT(tr.getAttribute('data-ot'), tr.getAttribute('data-proy'), parseInt(tr.getAttribute('data-estado')||'-1'));
            });
        });
    }

    function filtrarOTs() {
        var term=document.getElementById('filterOTs').value.toLowerCase().trim();
        if(!term){ renderOTList(todasOTs); return; }
        renderOTList(todasOTs.filter(function(r){
            return (r.ot||'').toLowerCase().includes(term)||(r.proyecto||'').toLowerCase().includes(term);
        }));
    }

    function volverAlListado() {
        selectedOT=''; selectedProy=''; rowCounter=0;
        document.getElementById('otSelectorSection').style.display='';
        document.getElementById('infoCard').style.display='none';
        document.getElementById('actCard').style.display='none';
        document.getElementById('ganttSection').style.display='none';
        document.getElementById('aprobarSection').style.display='none';
        document.getElementById('filterOTs').value='';
        renderOTList(todasOTs);
    }

    /* ─── Seleccionar OT ─────────────────────────────────────────────── */
    function seleccionarOT(ot, proyecto, estadoPlano) {
        _pendingOT=ot; _pendingProy=proyecto;
        fetch(API_GET+'?ot='+encodeURIComponent(ot))
            .then(function(r){ return r.json(); })
            .then(function(data){
                if(data.fecha_inicio && data.fecha_inicio!=='0000-00-00') _abrirOT(ot, proyecto, data.fecha_inicio);
                else _mostrarModalFecha();
            })
            .catch(function(){ _mostrarModalFecha(); });
    }

    function _mostrarModalFecha() {
        var mi=document.getElementById('modalFechaInput'); mi.value=today();
        document.getElementById('modalFechaInicio').style.display='flex'; mi.focus();
    }

    function confirmarFechaInicio() {
        var mi=document.getElementById('modalFechaInput'); var fecha=mi.value;
        if(!fecha){ mi.style.border='2px solid #dc2626'; mi.focus(); return; }
        mi.style.border='';
        document.getElementById('modalFechaInicio').style.display='none';
        _abrirOT(_pendingOT, _pendingProy, fecha);
    }
    window.confirmarFechaInicio=confirmarFechaInicio;

    function cancelarSeleccionOT() {
        document.getElementById('modalFechaInicio').style.display='none';
        _pendingOT=null; _pendingProy=null;
    }
    window.cancelarSeleccionOT=cancelarSeleccionOT;

    function _abrirOT(ot, proyecto, fechaInicio) {
        selectedOT=ot; selectedProy=proyecto;
        document.getElementById('infoOT').textContent=ot;
        document.getElementById('infoProyecto').innerHTML='<small>Nombre del proyecto</small>'+escHtml(proyecto);
        document.getElementById('otSelectorSection').style.display='none';
        document.getElementById('infoCard').style.display='';
        document.getElementById('actCard').style.display='';
        document.getElementById('ganttSection').style.display='none';
        document.getElementById('aprobarSection').style.display='none';
        document.getElementById('fechaInicioProy').value=fechaInicio;
        hideAlert('actAlert'); hideAlert('aprobarAlert');
        cargarDatosCombinados(ot);
    }

    /* ─── Cargar datos combinados ────────────────────────────────────── */
    function cargarDatosCombinados(ot) {
        var loading=document.getElementById('actLoading');
        var wrapper=document.getElementById('actTableWrapper');
        loading.style.display=''; wrapper.style.display='none'; rowCounter=0;

        fetch(API_GET+'?ot='+encodeURIComponent(ot))
            .then(function(r){ return r.json(); })
            .then(function(data){
                if(data.error) throw new Error(data.error);
                if(data.fecha_inicio) document.getElementById('fechaInicioProy').value=data.fecha_inicio;
                loading.style.display='none'; wrapper.style.display='';
                var acts=todasActividades.length?todasActividades:(data.actividades||[]);
                renderCombined(acts, data);
                var hasPlanos=(data.actividades||[]).some(function(a){ return a.planos&&a.planos.length; });
                if(hasPlanos) renderGantt(data.actividades);
                mostrarSeccionAprobacion(parseInt(data.estado||0));
            })
            .catch(function(err){
                loading.style.display='none'; wrapper.style.display='';
                renderCombined(todasActividades, null);
                showAlert('actAlert','error','Error al cargar: '+escHtml(err.message));
            });
    }

    /* ─── Renderizar tabla combinada ─────────────────────────────────── */
    function renderCombined(actividades, savedData) {
        var tbody=document.getElementById('combTbody');
        tbody.innerHTML=''; rowCounter=0;
        if(!actividades||!actividades.length){
            document.getElementById('actLoading').innerHTML='<i class="fas fa-exclamation-circle"></i><p>No se encontraron actividades.</p>';
            document.getElementById('actLoading').style.display='';
            document.getElementById('actTableWrapper').style.display='none';
            return;
        }
        var savedMap={};
        if(savedData&&savedData.actividades){
            savedData.actividades.forEach(function(a){ savedMap[a.actividad_id]=a; });
        }
        actividades.forEach(function(act, i){
            var color=COLORS[i%COLORS.length];
            var saved=savedMap[act.id||act.actividad_id];
            var actId=String(act.id||act.actividad_id);
            var isAnt=(i===0);

            var actTr=document.createElement('tr');
            actTr.className='act-header-row';
            actTr.setAttribute('data-act-id', actId);

            if(isAnt){
                actTr.innerHTML=
                    '<td><span class="act-num" style="background:'+color+'">'+(act.orden||(i+1))+'</span></td>'+
                    '<td colspan="2" class="act-name">'+escHtml(act.nombre)+'</td>'+
                    '<td></td><td></td><td></td><td></td>'+
                    '<td style="text-align:right;padding-right:8px;">'+
                      '<button class="btn-ant-open" data-act-id="'+actId+'" data-act-nombre="'+escHtml(act.nombre)+'"><i class="fas fa-folder-open"></i> Ver documentos &nbsp;<span class="ant-file-badge" id="antCountBadge_'+actId+'"><i class="fas fa-paperclip"></i> …</span></button>'+
                    '</td>';
                tbody.appendChild(actTr);
                // description row
                var descTr=document.createElement('tr');
                descTr.className='ant-act-row';
                descTr.setAttribute('data-act-id', actId);
                descTr.innerHTML='<td colspan="8"><i class="fas fa-info-circle" style="color:#d97706;margin-right:7px;"></i>Esta actividad concentra todos los documentos de antecedentes (planos CAD, PDF, fotografías, etc.). No forma parte del cronograma de planos.</td>';
                tbody.appendChild(descTr);
                actTr.querySelector('.btn-ant-open').addEventListener('click', function(){
                    _abrirAnt(this.getAttribute('data-act-id'), this.getAttribute('data-act-nombre'));
                });
                _cargarAntCount(actId);
            } else {
                var totalDias=saved?(parseFloat(saved.total_dias)||0):0;
                var diasLabel=totalDias>0
                    ? '<span class="dias-val">'+fmtDias(totalDias)+' días</span><br><span class="horas-val">('+parseFloat((totalDias*8).toFixed(2))+' h)</span>'
                    : '<span class="dias-val" style="opacity:.5">— días</span>';
                var fi=saved&&saved.fecha_inicio?fmtDateStr(saved.fecha_inicio):'—';
                var ff=saved&&saved.fecha_fin?fmtDateStr(saved.fecha_fin):'—';
                actTr.innerHTML=
                    '<td><span class="act-num" style="background:'+color+'">'+(act.orden||(i+1))+'</span></td>'+
                    '<td colspan="2" class="act-name">'+escHtml(act.nombre)+'</td>'+
                    '<td></td>'+
                    '<td class="act-sum-dias" id="sumDias_'+actId+'">'+diasLabel+'</td>'+
                    '<td class="act-date" id="actFi_'+actId+'">'+fi+'</td>'+
                    '<td class="act-date" id="actFf_'+actId+'">'+ff+'</td>'+
                    '<td style="text-align:right;padding-right:8px;">'+
                      '<button class="btn-add-plano" data-act-id="'+actId+'"><i class="fas fa-plus"></i> Plano</button>'+
                    '</td>';
                tbody.appendChild(actTr);
                actTr.querySelector('.btn-add-plano').addEventListener('click', function(){
                    addPlanoRow(this.getAttribute('data-act-id'), null);
                });
                var planos=saved&&saved.planos?saved.planos:[];
                if(planos.length){ planos.forEach(function(p){ addPlanoRow(actId, p); }); }
                else { _addEmptyRow(actId, tbody); }
            }
        });
        updateBadge(); recalcAll();
    }

    function _addEmptyRow(actId, tbody) {
        var existing=tbody.querySelectorAll('.plano-row[data-act-id="'+actId+'"]');
        if(existing.length) return;
        var tr=document.createElement('tr');
        tr.className='empty-planos-row'; tr.setAttribute('data-act-id', actId); tr.id='emptyRow_'+actId;
        tr.innerHTML='<td colspan="8">Sin planos — haz clic en <strong>+ Plano</strong> para agregar</td>';
        var rows=tbody.querySelectorAll('tr[data-act-id="'+actId+'"]');
        var last=rows[rows.length-1];
        if(last) last.insertAdjacentElement('afterend', tr); else tbody.appendChild(tr);
    }

    /* ─── Agregar fila de plano ──────────────────────────────────────── */
    function addPlanoRow(actId, data) {
        var tbody=document.getElementById('combTbody');
        var emp=document.getElementById('emptyRow_'+actId); if(emp) emp.remove();
        rowCounter++;
        var rid='row_'+rowCounter;
        var idDB=data?(data.id_planos||''):'';
        var cod=data?escHtml(data.cod_plano||''):'';
        var desc=data?escHtml(data.desc_plano||''):'';
        var arch=data?(data.arch_plano||''):'';
        var archOr=data?(data.arch_original||''):'';
        var dias=data?(parseFloat(data.dias)||0):0;
        var existing=tbody.querySelectorAll('.plano-row[data-act-id="'+actId+'"]');
        var rowNum=existing.length+1;
        var color=COLORS[(rowNum-1)%COLORS.length];
        var archHtml=_buildArchHtml(rid, idDB, arch, archOr, cod);

        var tr=document.createElement('tr');
        tr.className='plano-row'; tr.id=rid;
        tr.setAttribute('data-act-id', actId);
        tr.setAttribute('data-id-db', idDB);
        tr.setAttribute('data-arch-plano', arch);
        tr.setAttribute('data-arch-original', archOr);
        tr.innerHTML=
            '<td><span class="row-num" style="background:'+color+'">'+rowNum+'</span></td>'+
            '<td><input class="inp-cod"  type="text"   placeholder="T033138"             value="'+cod+'"></td>'+
            '<td><input class="inp-desc" type="text"   placeholder="ENSAMBLE - SPOOL 1"  value="'+desc+'"></td>'+
            '<td>'+archHtml+'</td>'+
            '<td><input class="inp-dias" type="number" min="0" step="0.01" value="'+dias+'" placeholder="0.5"><small class="plano-horas" style="display:block;color:#64748b;font-size:.72rem;"></small></td>'+
            '<td class="td-fecha" id="fi_'+rid+'">—</td>'+
            '<td class="td-fecha" id="ff_'+rid+'">—</td>'+
            '<td><button class="btn-del-plano" data-act-id="'+actId+'" data-row="'+rid+'" title="Eliminar"><i class="fas fa-times"></i></button></td>';

        var rows=tbody.querySelectorAll('tr[data-act-id="'+actId+'"]');
        var lastRow=rows[rows.length-1];
        if(lastRow) lastRow.insertAdjacentElement('afterend', tr); else tbody.appendChild(tr);

        tr.querySelector('.inp-dias').addEventListener('input', recalcAll);
        tr.querySelector('.btn-del-plano').addEventListener('click', function(){
            delPlanoRow(this.getAttribute('data-row'), this.getAttribute('data-act-id'));
        });
        var fileInp=tr.querySelector('input[type=file]');
        if(fileInp) fileInp.addEventListener('change', function(){ subirArchivo(this, rid, tr); });
        var btnVer=tr.querySelector('.dwg-ver[data-id]');
        if(btnVer) btnVer.addEventListener('click', function(){
            abrirVisor(this.getAttribute('data-id'), this.getAttribute('data-name'), this.getAttribute('data-cod'));
        });
        var btnHist=tr.querySelector('.btn-hist[data-id-planos]');
        if(btnHist) btnHist.addEventListener('click', function(){
            _abrirHistorial(parseInt(this.getAttribute('data-id-planos')), this.getAttribute('data-cod'));
        });

        recalcAll(); updateBadge(); return tr;
    }

    function _buildArchHtml(rid, idDB, arch, archOr, cod) {
        if(arch){
            var histBtn = idDB ? '<button class="btn-hist" type="button" data-id-planos="'+escHtml(idDB)+'" data-cod="'+escHtml(cod)+'" title="Ver historial de versiones"><i class="fas fa-history"></i> Hist.</button>' : '';
            return '<div class="dwg-upload-wrap">'+
                '<div class="dwg-actions">'+
                '<button class="dwg-ver" type="button" data-id="'+escHtml(idDB)+'" data-name="'+escHtml(archOr||arch)+'" data-cod="'+escHtml(cod)+'" title="Ver plano"><i class="fas fa-eye"></i> Ver</button>'+
                '<a class="dwg-download" href="'+API_DOWN+'?id='+encodeURIComponent(idDB)+'" title="Descargar"><i class="fas fa-download"></i></a>'+
                histBtn+
                '<span class="dwg-done" title="'+escHtml(archOr||arch)+'">'+escHtml(archOr||arch)+'</span>'+
                '</div>'+
                '<label class="dwg-label" title="Reemplazar"><i class="fas fa-sync-alt"></i>'+
                '<input type="file" accept=".dwg,.dxf,.pdf,.dws,.dwt" data-row="'+rid+'"></label>'+
                '<span class="dwg-uploading" id="uploading_'+rid+'" style="display:none;"><i class="fas fa-spinner fa-spin"></i></span>'+
                '<span class="dwg-done" id="done_'+rid+'" style="display:none;"></span>'+
                '</div>';
        } else {
            return '<div class="dwg-upload-wrap">'+
                '<label class="dwg-label"><i class="fas fa-upload"></i> Elegir DWG'+
                '<input type="file" accept=".dwg,.dxf,.pdf,.dws,.dwt" data-row="'+rid+'"></label>'+
                '<span class="dwg-uploading" id="uploading_'+rid+'" style="display:none;"><i class="fas fa-spinner fa-spin"></i></span>'+
                '<span class="dwg-done" id="done_'+rid+'" style="display:none;"></span>'+
                '</div>';
        }
    }

    function delPlanoRow(rid, actId) {
        var tr=document.getElementById(rid); if(!tr) return; tr.remove();
        _renumerarActividad(actId); recalcAll(); updateBadge();
        var tbody=document.getElementById('combTbody');
        if(!tbody.querySelectorAll('.plano-row[data-act-id="'+actId+'"]').length) _addEmptyRow(actId, tbody);
    }

    function _renumerarActividad(actId) {
        var rows=document.querySelectorAll('#combTbody .plano-row[data-act-id="'+actId+'"]');
        rows.forEach(function(tr,i){
            var badge=tr.querySelector('.row-num');
            if(badge){ badge.textContent=(i+1); badge.style.background=COLORS[i%COLORS.length]; }
        });
    }

    function updateBadge() {
        var n=document.querySelectorAll('#combTbody .plano-row').length;
        document.getElementById('badgeTotal').textContent=n+' plano'+(n!==1?'s':'');
    }

    /* ─── Recalcular todas las fechas ────────────────────────────────── */
    function recalcAll() {
        var fechaVal=document.getElementById('fechaInicioProy').value;
        var actHeaders=document.querySelectorAll('#combTbody .act-header-row');
        if(!fechaVal){
            document.querySelectorAll('#combTbody .plano-row').forEach(function(tr){
                var rid=tr.id;
                var fi=document.getElementById('fi_'+rid); if(fi){fi.textContent='—';fi.classList.remove('has-date');}
                var ff=document.getElementById('ff_'+rid); if(ff){ff.textContent='—';ff.classList.remove('has-date');}
            });
            actHeaders.forEach(function(ar){
                var aid=ar.getAttribute('data-act-id');
                var s=document.getElementById('sumDias_'+aid); if(s) s.innerHTML='<span class="dias-val" style="opacity:.5">— días</span>';
                var fi=document.getElementById('actFi_'+aid); if(fi) fi.textContent='—';
                var ff=document.getElementById('actFf_'+aid); if(ff) ff.textContent='—';
            });
            return;
        }
        var cursor=0;
        var previewActs=[];
        actHeaders.forEach(function(actRow){
            var actId=actRow.getAttribute('data-act-id');
            var planoRows=document.querySelectorAll('#combTbody .plano-row[data-act-id="'+actId+'"]');
            var actFi=null, actFf=null, totalDias=0;
            var preview={actividad_id:actId,nombre:(actRow.querySelector('.act-name')||{}).textContent||'',planos:[]};
            planoRows.forEach(function(tr){
                var rid=tr.id;
                var dias=parseFloat(tr.querySelector('.inp-dias').value)||0;
                var tdFi=document.getElementById('fi_'+rid);
                var tdFf=document.getElementById('ff_'+rid);
                var horasFila=tr.querySelector('.plano-horas');if(horasFila)horasFila.textContent=Number((Math.max(0,dias)*8).toFixed(2))+' horas';
                if(dias>0){
                    var tramo=FHCalendar.slot(fechaVal,cursor,dias); cursor=tramo.cursor;
                    var fi=parseDate(tramo.fecha_inicio), ff=parseDate(tramo.fecha_fin);
                    var detalle=' · '+Number(tramo.inicio_jornada.toFixed(2))+' h de jornada';
                    if(tdFi){tdFi.textContent=fmtDate(fi)+detalle;tdFi.classList.add('has-date');}
                    if(tdFf){tdFf.textContent=fmtDate(ff)+' · '+Number(tramo.fin_jornada.toFixed(2))+' h de jornada';tdFf.classList.add('has-date');}
                    var horas=tr.querySelector('.plano-horas'); if(horas)horas.textContent=Number((dias*8).toFixed(2))+' horas';
                    if(!actFi)actFi=fi;actFf=ff;totalDias+=dias;
                    preview.planos.push(Object.assign({dias:dias,cod_plano:tr.querySelector('.inp-cod').value,desc_plano:tr.querySelector('.inp-desc').value},tramo));
                } else {
                    if(tdFi){tdFi.textContent='—';tdFi.classList.remove('has-date');}
                    if(tdFf){tdFf.textContent='—';tdFf.classList.remove('has-date');}
                }
            });
            var sumEl=document.getElementById('sumDias_'+actId);
            if(sumEl){
                if(totalDias>0) sumEl.innerHTML='<span class="dias-val">'+fmtDias(totalDias)+' días</span><br><span class="horas-val">('+parseFloat((totalDias*8).toFixed(2))+' h)</span>';
                else sumEl.innerHTML='<span class="dias-val" style="opacity:.5">— días</span>';
            }
            previewActs.push(preview);
            var fiEl=document.getElementById('actFi_'+actId); if(fiEl) fiEl.textContent=actFi?fmtDate(actFi):'—';
            var ffEl=document.getElementById('actFf_'+actId); if(ffEl) ffEl.textContent=actFf?fmtDate(actFf):'—';
        });
        renderGantt(previewActs);
    }

    /* ─── Subir archivo DWG ──────────────────────────────────────────── */
    function subirArchivo(input, rid, tr) {
        if(!input.files||!input.files[0]) return;
        var uploading=document.getElementById('uploading_'+rid);
        var done=document.getElementById('done_'+rid);
        uploading.style.display=''; if(done) done.style.display='none';
        var fd=new FormData(); fd.append('file', input.files[0]);
        fetch(API_UPLOAD,{method:'POST',body:fd})
            .then(function(r){return r.json();})
            .then(function(res){
                uploading.style.display='none';
                if(res.ok){
                    tr.setAttribute('data-arch-plano', res.saved_name);
                    tr.setAttribute('data-arch-original', res.original_name);
                    if(done){done.style.display='';done.innerHTML='<i class="fas fa-check-circle" style="color:#27ae60;"></i> '+escHtml(res.original_name);}
                    showAlert('actAlert','success','Archivo subido: <b>'+escHtml(res.original_name)+'</b>');
                } else {
                    showAlert('actAlert','error','Error al subir: '+escHtml(res.error||'desconocido'));
                }
            })
            .catch(function(err){uploading.style.display='none';showAlert('actAlert','error','Error de conexión: '+escHtml(err.message));});
    }

    /* ─── Guardar cronograma ─────────────────────────────────────────── */
    function guardarCronograma() {
        if(!selectedOT){ showAlert('actAlert','error','Selecciona una OT primero.'); return; }
        var fechaInicio=document.getElementById('fechaInicioProy').value;
        if(!fechaInicio){ showAlert('actAlert','error','Ingresa la fecha de inicio del proyecto.'); return; }
        var upl=document.querySelectorAll('.dwg-uploading');
        for(var u=0;u<upl.length;u++){ if(upl[u].style.display!=='none'){ showAlert('actAlert','warning','Espera a que terminen las subidas de archivo.'); return; } }

        var actHeaders=document.querySelectorAll('#combTbody .act-header-row');
        var actividades=[];
        actHeaders.forEach(function(actRow){
            var actId=actRow.getAttribute('data-act-id');
            var planoRows=document.querySelectorAll('#combTbody .plano-row[data-act-id="'+actId+'"]');
            var planos=[];
            planoRows.forEach(function(tr){
                planos.push({
                    id_planos:    parseInt(tr.getAttribute('data-id-db')) || 0,
                    cod_plano:    tr.querySelector('.inp-cod').value.trim(),
                    desc_plano:   tr.querySelector('.inp-desc').value.trim(),
                    arch_plano:   tr.getAttribute('data-arch-plano')||'',
                    arch_original:tr.getAttribute('data-arch-original')||'',
                    dias:         parseFloat(tr.querySelector('.inp-dias').value)||0,
                });
            });
            actividades.push({actividad_id:actId, planos:planos});
        });

        var btn=document.getElementById('btnGuardar');
        btn.disabled=true; btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Guardando...';
        hideAlert('actAlert');

        fetch(API_GUARDAR,{
            method:'POST', headers:{'Content-Type':'application/json'},
            body:JSON.stringify({ot:selectedOT, proyecto:selectedProy, fecha_inicio:fechaInicio, actividades:actividades}),
        })
        .then(function(r){return r.json();})
        .then(function(data){
            if(data.success){
                showAlert('actAlert','success', data.message||'Cronograma guardado correctamente.');
                // Actualizar data-id-db en cada fila con el id_planos retornado
                if(data.actividades && data.actividades.length) {
                    var actHeaders2 = document.querySelectorAll('#combTbody .act-header-row');
                    data.actividades.forEach(function(act) {
                        var actId = act.actividad_id;
                        var planoRows2 = document.querySelectorAll('#combTbody .plano-row[data-act-id="'+actId+'"]');
                        if(act.planos && act.planos.length) {
                            act.planos.forEach(function(p, idx) {
                                if(planoRows2[idx] && p.id_planos) {
                                    var tr2 = planoRows2[idx];
                                    tr2.setAttribute('data-id-db', p.id_planos);
                                    if(p.arch_plano) {
                                        // Siempre reconstruir la celda de archivo para que el nombre
                                        // se actualice en pantalla sin necesidad de refrescar la página
                                        tr2.setAttribute('data-arch-plano',   p.arch_plano);
                                        tr2.setAttribute('data-arch-original', p.arch_original||p.arch_plano);
                                        var cod2     = tr2.querySelector('.inp-cod') ? tr2.querySelector('.inp-cod').value : '';
                                        var rid2     = tr2.getAttribute('id');
                                        var archWrap = tr2.querySelector('.dwg-upload-wrap');
                                        if(archWrap) {
                                            archWrap.outerHTML = _buildArchHtml(rid2, p.id_planos, p.arch_plano, p.arch_original||p.arch_plano, cod2);
                                            // Re-registrar eventos del nuevo HTML
                                            var bv2 = tr2.querySelector('.dwg-ver[data-id]');
                                            if(bv2) bv2.addEventListener('click', function(){ abrirVisor(this.getAttribute('data-id'),this.getAttribute('data-name'),this.getAttribute('data-cod')); });
                                            var bh2 = tr2.querySelector('.btn-hist[data-id-planos]');
                                            if(bh2) bh2.addEventListener('click', function(){ _abrirHistorial(parseInt(this.getAttribute('data-id-planos')),this.getAttribute('data-cod')); });
                                            var fi2 = tr2.querySelector('input[type="file"][data-row]');
                                            if(fi2) fi2.addEventListener('change', function(){ subirArchivo(this, rid2, tr2); });
                                        }
                                    }
                                }
                            });
                        }
                    });
                    renderGantt(data.actividades);
                }
                document.getElementById('aprobarSection').style.display='';
                mostrarSeccionAprobacion(0);
                // ── Pre-calentar APS para todos los CAD guardados ──────
                if (APS_ENABLED) {
                    document.querySelectorAll('#combTbody .plano-row').forEach(function(tr2) {
                        var idDb  = parseInt(tr2.getAttribute('data-id-db')) || 0;
                        var arch  = tr2.getAttribute('data-arch-plano') || '';
                        if (!idDb || !arch) return;
                        var ext = arch.split('.').pop().toLowerCase();
                        if (['dwg','dxf','dws','dwt'].indexOf(ext) === -1) return;
                        fetch(API_APS_ENSURE + '?id=' + encodeURIComponent(idDb))
                            .catch(function() {});
                    });
                }
            } else {
                showAlert('actAlert','error', data.error||data.message||'Error al guardar.');
            }
        })
        .catch(function(err){showAlert('actAlert','error','Error: '+err.message);})
        .finally(function(){btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Guardar Cronograma';});
    }

