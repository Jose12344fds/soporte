 <div class="row"><div class="col-lg-6 mb-3"><div class="ind-section"><div class="ind-section-title"><i class="fas fa-hourglass-end mr-2 text-danger"></i>Órdenes vencidas del periodo</div><div class="table-responsive"><table class="table table-sm table-hover ind-table mb-0"><thead><tr><th>Orden</th><th>Equipo</th><th>Fecha</th><th>Prioridad</th><th></th></tr></thead><tbody><?php foreach($overdueRows as $row):?><tr><td><?=mti_ind_h($row['folio'])?></td><td><?=mti_ind_h($row['Host'])?></td><td><?=date('d/m/Y',strtotime($row['fecha_programada']))?></td><td><?=mti_ind_h($row['prioridad'])?></td><td><a href="detalle.php?id=<?=(int)$row['id']?>" class="btn btn-xs btn-outline-info">Ver</a></td></tr><?php endforeach;?><?php if(!$overdueRows):?><tr><td colspan="5" class="text-center text-muted py-4">Sin órdenes vencidas.</td></tr><?php endif;?></tbody></table></div></div></div><div class="col-lg-6 mb-3"><div class="ind-section"><div class="ind-section-title"><i class="fas fa-triangle-exclamation mr-2 text-warning"></i>Hallazgos altos y críticos pendientes</div><div class="table-responsive"><table class="table table-sm table-hover ind-table mb-0"><thead><tr><th>Código</th><th>Equipo</th><th>Hallazgo</th><th>Criticidad</th><th></th></tr></thead><tbody><?php foreach($criticalRows as $row):?><tr><td><?=mti_ind_h($row['codigo'])?></td><td><?=mti_ind_h($row['Host'])?></td><td><?=mti_ind_h($row['titulo'])?></td><td><span class="badge badge-danger"><?=mti_ind_h($row['criticidad'])?></span></td><td><a href="hallazgo.php?id=<?=(int)$row['id']?>" class="btn btn-xs btn-outline-info">Ver</a></td></tr><?php endforeach;?><?php if(!$criticalRows):?><tr><td colspan="5" class="text-center text-muted py-4">Sin hallazgos altos o críticos pendientes.</td></tr><?php endif;?></tbody></table></div></div></div></div>
