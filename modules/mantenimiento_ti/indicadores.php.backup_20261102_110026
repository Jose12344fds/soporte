 <div class="row mb-3"><div class="col-lg-8"><div class="ind-section h-100"><div class="ind-section-title"><i class="fas fa-calendar-alt mr-2 text-info"></i>Cumplimiento trimestral <?=$year?></div><div class="row p-3"><?php for($q=1;$q<=4;$q++):$row=$quarterMap[$q]??[];$p=(int)($row['programados']??0);$c=(int)($row['completados']??0);$pct=mti_ind_pct($c,$p);?><div class="col-6 col-md-3 mb-3"><div class="ind-quarter"><span class="small font-weight-bold">TRIMESTRE <?=$q?></span><strong class="d-block"><?=number_format($pct,1)?>%</strong><span class="small text-muted"><?=$c?> / <?=$p?> completados</span><div class="ind-track mt-2"><div class="ind-fill <?=mti_ind_tone($pct,100)?>" style="width:<?=min(100,$pct)?>%"></div></div></div></div><?php endfor;?></div></div></div><div class="col-lg-4 mt-3 mt-lg-0"><div class="ind-section h-100"><div class="ind-section-title"><i class="fas fa-gauge-high mr-2 text-warning"></i>Control operativo</div><div class="p-3"><div class="d-flex justify-content-between border-bottom py-2"><span>Órdenes vencidas</span><strong class="text-danger"><?=$overdue?></strong></div><div class="d-flex justify-content-between border-bottom py-2"><span>Hallazgos abiertos</span><strong><?= (int)($findings['abiertos']??0) ?></strong></div><div class="d-flex justify-content-between border-bottom py-2"><span>Críticos abiertos</span><strong class="text-danger"><?= (int)($findings['criticos_abiertos']??0) ?></strong></div><div class="d-flex justify-content-between border-bottom py-2"><span>Acciones ejecutadas</span><strong><?=number_format($actionPct,1)?>%</strong></div><div class="d-flex justify-content-between border-bottom py-2"><span>Acciones vencidas</span><strong class="text-danger"><?= (int)($actions['vencidas']??0) ?></strong></div><div class="d-flex justify-content-between py-2"><span>Promedio cierre hallazgo</span><strong><?=number_format((float)($findings['dias_cierre']??0),1)?> días</strong></div><div class="alert ind-note mt-3 mb-0 small"><strong>L