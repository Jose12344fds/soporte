<script>
let datosCompletos = [];
let seleccion = new Set(); let tablaReporte = null;

// Cargar datos del reporte
document.addEventListener('DOMContentLoaded', function() {
    console.log('Cargando reporte de procesos no cerrados...');
    cargarDatos();
    cargarFiltros();
});

async function cargarDatos() {
    const loading = document.getElementById('loading');
    const contenido = document.getElementById('contenido');
    loading.style.display = 'block';
    contenido.style.display = 'none';
    try {
        const response = await fetch('../../api/prgsemana/reporte_semanas_abiertas.php', {cache: 'no-store'});
        const data = await response.json();
        if (!response.ok || !data.success) throw new Error(data.message || data.error || 'No pudimos cargar el reporte.');
        datosCompletos = Array.isArray(data.datos) ? data.datos : [];
        // Los filtros no dependen de la inicialización de DataTables.
        extraerValoresFiltros(datosCompletos);
        actualizarEstadisticasFiltradas(datosCompletos);
        contenido.style.display = 'block';
        mostrarDatos(datosCompletos);
        loading.style.display = 'none';
    } catch (error) {
        console.error('Carga del reporte:', error);
        loading.style.display = 'block';
        loading.innerHTML = '<h4>No se pudo cargar el reporte</h4><p id="reporte-error"></p><button type="button" class="btn-filtrar" onclick="cargarDatos()">Volver a intentar</button>';
        document.getElementById('reporte-error').textContent = error.message;
    }
}
function cargarFiltros() {
    // Cargar años disponibles (últimos 3 años)
    const añoActual = new Date().getFullYear();
    const selectAño = document.getElementById('filtro-anio');
    
    for (let i = 0; i < 3; i++) {
        const año = añoActual - i;
        const option = document.createElement('option');
        option.value = año;
        option.textContent = año;
        selectAño.appendChild(option);
    }
}

function extraerValoresFiltros(datos) {
    // Extraer OTs únicas desde projectCode (otpadre)
    const proyectosMap = new Map();
    datos.forEach(item => {
        const key = (item.projectCode ?? item.proyecto ?? '').toString().trim();
        if (!key || proyectosMap.has(key)) return;
        const desc = (item.descripcion ?? '').toString().trim();
        const label = desc && desc !== key ? `${key} - ${desc}` : `${key}`;
        proyectosMap.set(key, label);
    });
    const proyectos = Array.from(proyectosMap.keys()).sort();
    const selectProyecto = document.getElementById('filtro-proyecto');
    
    // Limpiar opciones existentes (excepto "Todos")
    selectProyecto.innerHTML = '<option value="">Todos</option>';
    
    proyectos.forEach(proyecto => {
        const option = document.createElement('option');
        option.value = proyecto;
        option.textContent = proyectosMap.get(proyecto) || `${proyecto}`;
        selectProyecto.appendChild(option);
    });
}

function aplicarFiltros() {
    const filtroProyecto = document.getElementById('filtro-proyecto').value;
    const filtroProceso = document.getElementById('filtro-proceso').value;
    const filtroAño = document.getElementById('filtro-anio').value;

    let datosFiltrados = datosCompletos.filter(item => {
        let cumple = true;
        
        const proyecto = (item.projectCode ?? item.proyecto ?? '').toString().trim();
        if (filtroProyecto && proyecto !== filtroProyecto) cumple = false;
        const categoria = (item.categoria_proceso || '').toString();
        if (filtroProceso && !categoria.toLowerCase().includes(filtroProceso.toLowerCase())) cumple = false;
        if (filtroAño && item.anio != filtroAño) cumple = false;
        
        return cumple;
    });

    mostrarDatos(datosFiltrados);
    actualizarEstadisticasFiltradas(datosFiltrados);
}

function actualizarEstadisticas(stats) {
    document.getElementById('total-procesos').textContent = stats.total_procesos || 0;
    document.getElementById('total-proyectos').textContent = stats.total_proyectos || 0;
    document.getElementById('total-semanas').textContent = stats.total_semanas || 0;
    document.getElementById('promedio-retraso').textContent = (stats.promedio_dias_retraso || 0).toFixed(1);
}

function actualizarEstadisticasFiltradas(datos) {
    const proyectosUnicos = new Set(datos.map(item => item.projectCode || item.proyecto));
    const semanasUnicas = new Set(datos.map(item => `${item.anio}-${item.semana}`));
    
    document.getElementById('total-procesos').textContent = datos.length;
    document.getElementById('total-proyectos').textContent = proyectosUnicos.size;
    document.getElementById('total-semanas').textContent = semanasUnicas.size;
}

function mostrarDatos(datos) {
    seleccion.clear();
    if (tablaReporte) { tablaReporte.destroy(); tablaReporte = null; }
    const tbody = document.getElementById('tabla-datos');
    tbody.innerHTML = '';
    const escape = value => String(value ?? '-').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    datos.forEach(item => {
        const row = tbody.insertRow();
        const id = String(item.clave_seleccion || '');
        const cells = [item.projectCode || item.proyecto, item.descripcion, item.item, item.descripcion_item, item.proceso || item.codigo_proceso, item.anio, item.semana, Number(item.porcentaje || 0).toFixed(1) + '%', Number(item.avance_fisico || 0).toFixed(1) + '%', Number(item.horas || 0).toFixed(1), item.fecha_calculo ? new Date(item.fecha_calculo).toLocaleDateString('es-ES') : '-', 'PENDIENTE'];
        row.innerHTML = '<td><input type="checkbox" class="chk-row" data-id="' + id + '" aria-label="Seleccionar semana ' + escape(item.semana) + '" ' + (id ? '' : 'disabled') + '></td>' + cells.map(value => '<td>' + escape(value) + '</td>').join('');
    });
    if (!window.jQuery || !jQuery.fn.DataTable) { wireSeleccionEventos(); return; }
    tablaReporte = $('#tabla-reporte').DataTable({
        pageLength: 25, lengthMenu: [10, 25, 50, 100], scrollX: true,
        order: [[6, 'desc'], [7, 'desc']], columnDefs: [{targets: 0, orderable: false, searchable: false}],
        language: {search: 'Buscar:', searchPlaceholder: 'Proyecto, ítem o proceso…', lengthMenu: 'Mostrar _MENU_ filas', info: 'Mostrando _START_ a _END_ de _TOTAL_ registros', infoEmpty: 'Sin registros', infoFiltered: '(de _MAX_ registros)', zeroRecords: 'No hay coincidencias con tu búsqueda', emptyTable: 'No hay semanas pendientes con estos filtros', paginate: {first: 'Primera', last: 'Última', next: 'Siguiente', previous: 'Anterior'}}
    });
    $('#tabla-reporte').off('draw.dt.seleccion').on('draw.dt.seleccion', refreshSeleccion);
    wireSeleccionEventos();
}
function wireSeleccionSinPlugin() {
    const checks = () => Array.from(document.querySelectorAll('#tabla-datos .chk-row:not(:disabled)'));
    const refresh = () => {
        document.getElementById('sel-count').textContent = seleccion.size;
        document.getElementById('btn-cerrar-seleccion').disabled = seleccion.size === 0;
    };
    checks().forEach(chk => { chk.onchange = () => { const id = chk.dataset.id; if (chk.checked) seleccion.add(id); else seleccion.delete(id); refresh(); }; });
    document.getElementById('chk-all').onchange = function() { checks().forEach(chk => { chk.checked = this.checked; const id = chk.dataset.id; if (this.checked) seleccion.add(id); else seleccion.delete(id); }); refresh(); };
    document.getElementById('btn-cerrar-seleccion').onclick = cerrarSeleccionadas;
    refresh();
}
function truncarTexto(texto, limite) {
    if (!texto || texto === '-') return '-';
    return texto.length > limite ? texto.substring(0, limite) + '...' : texto;
}

function getColorProceso(categoria) {
    if (!categoria) return '#6c757d';
    switch(categoria.toLowerCase()) {
        case 'habilitado': return '#2ecc71';
        case 'fabricación': case 'fabricacion': return '#e67e22';
        case 'mecanizado': return '#f39c12';
        case 'soldadura': case 'soldeo': return '#e74c3c';
        case 'calderería': case 'caldereria': case 'armado': return '#9b59b6';
        case 'acabados': case 'acabado': return '#3498db';
        default: return '#6c757d';
    }
}

// Gestionar selección y cierre
function refreshSeleccion() {
    document.getElementById('sel-count').textContent = seleccion.size;
    document.getElementById('btn-cerrar-seleccion').disabled = seleccion.size === 0 || cerrandoSemanas;
    let total = 0, marcadas = 0;
    {
        const rows = tablaReporte ? tablaReporte.rows({search: 'applied'}).nodes().toArray() : Array.from(document.querySelectorAll('#tabla-datos tr'));
        rows.forEach(row => {
            const chk = row.querySelector('.chk-row');
            if (!chk || chk.disabled) return;
            chk.checked = seleccion.has(chk.dataset.id);
            row.classList.toggle('fila-seleccionada', chk.checked);
            total++; if (chk.checked) marcadas++;
        });
    }
    document.querySelectorAll('#chk-all').forEach(chk => { chk.checked = total > 0 && marcadas === total; chk.indeterminate = marcadas > 0 && marcadas < total; });
}
function wireSeleccionEventos() {
    // Delegar en un contenedor estable: DataTables mueve las filas al paginar.
    const container = document.querySelector('.table-container');
    container.onchange = function(event) {
        const input = event.target;
        if (input.matches('.chk-row')) {
            const id = input.dataset.id;
            if (!id) return;
            if (input.checked) seleccion.add(id); else seleccion.delete(id);
            refreshSeleccion();
        } else if (input.id === 'chk-all') {
            const checked = input.checked;
            const rows = tablaReporte ? tablaReporte.rows({search: 'applied'}).nodes().toArray() : Array.from(document.querySelectorAll('#tabla-datos tr'));
            rows.forEach(row => {
                const chk = row.querySelector('.chk-row');
                if (!chk || chk.disabled) return;
                const id = chk.dataset.id;
                if (checked) seleccion.add(id); else seleccion.delete(id);
            });
            refreshSeleccion();
        }
    };
    container.onclick = function(event) {
        if (event.target.closest('input, button, a, select, label, thead')) return;
        const row = event.target.closest('#tabla-datos tr');
        const chk = row && row.querySelector('.chk-row:not(:disabled)');
        if (chk) { chk.checked = !chk.checked; chk.dispatchEvent(new Event('change', {bubbles: true})); }
    };
    document.getElementById('btn-cerrar-seleccion').onclick = cerrarSeleccionadas;
    refreshSeleccion();
}
let cerrandoSemanas = false;
async function cerrarSeleccionadas() {
    if (cerrandoSemanas) return;
    const ids = Array.from(seleccion).filter(id => typeof id === "string" && id.length > 0);
    if (!ids.length) {
        await Swal.fire({icon: 'info', title: 'Selecciona las semanas', text: 'Marca al menos una fila válida. Si el problema continúa, recarga el reporte.', confirmButtonText: 'Entendido'});
        return;
    }
    cerrandoSemanas = true;
    const btn = document.getElementById('btn-cerrar-seleccion');
    btn.disabled = true;
    try {
        const porClave = new Map(datosCompletos.map(item => [String(item.clave_seleccion || ''), item]));
        const sinAvance = ids.map(id => porClave.get(id)).filter(item => item && Number(item.avance_fisico || 0) <= 0);
        const avances = [];
        if (sinAvance.length) {
            const seguro = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
            const campos = sinAvance.map((item, index) =>
                '<label style="display:block;text-align:left;margin:10px 0 4px;font-weight:600">Semana ' + seguro(item.semana) + '/' + seguro(item.anio) + ' - ' + seguro(item.proceso || item.codigo_proceso) + '</label>' +
                '<input id="avance-cierre-' + index + '" class="swal2-input" type="number" min="0.01" max="100" step="0.01" placeholder="Avance físico %" style="margin:0;width:100%">'
            ).join('');
            const captura = await Swal.fire({
                icon: 'info',
                title: 'Completar avance físico',
                html: '<p style="text-align:left">Solo estas filas no tienen avance físico. Registra el porcentaje realizado para poder cerrarlas.</p>' + campos,
                showCancelButton: true,
                confirmButtonText: 'Guardar y continuar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#218838',
                focusConfirm: false,
                preConfirm: () => {
                    const valores = sinAvance.map((item, index) => Number(document.getElementById('avance-cierre-' + index).value));
                    if (valores.some(value => !Number.isFinite(value) || value <= 0 || value > 100)) {
                        Swal.showValidationMessage('Cada avance físico debe ser mayor que 0 y como máximo 100 %.');
                        return false;
                    }
                    return valores;
                }
            });
            if (!captura.isConfirmed) return;
            sinAvance.forEach((item, index) => avances.push({clave: item.clave_seleccion, valor: captura.value[index]}));
        }
        const confirma = await Swal.fire({icon: 'question', title: '¿Cerrar las semanas seleccionadas?', text: 'Se cerrarán ' + ids.length + ' registro(s) de programación.', showCancelButton: true, confirmButtonText: 'Sí, cerrar semanas', cancelButtonText: 'Cancelar', confirmButtonColor: '#218838', focusCancel: true});
        if (!confirma.isConfirmed) return;
        Swal.fire({title: 'Cerrando semanas', text: 'Espera mientras guardamos los cambios.', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading()});
        const form = new URLSearchParams();
        form.append('_csrf', document.querySelector('meta[name="csrf-token"]').content);
        ids.forEach(id => form.append('filas[]', id));
        form.append('avances', JSON.stringify(avances));
        const resp = await fetch('../../api/prgsemana/cerrar_semanas_reporte.php', {method: 'POST', body: form});
        const data = await resp.json();
        if (!resp.ok || !data.success) throw new Error(data.message || data.error || 'No pudimos guardar el cierre. Inténtalo nuevamente.');
        const cerradas = new Set(data.claves || ids);
        datosCompletos = datosCompletos.filter(it => !cerradas.has(it.clave_seleccion));
        seleccion.clear();
        aplicarFiltros();
        await Swal.fire({icon: 'success', title: 'Cierre completado', text: 'Se cerraron ' + data.afectados + ' registro(s) de programación.' + (data.warnings && data.warnings.length ? '\n' + data.warnings.join('\n') : ''), confirmButtonText: 'Aceptar', confirmButtonColor: '#218838'});
    } catch (err) {
        console.error(err);
        const mensaje = /IDs|identificadores/i.test(err.message) ? 'No pudimos identificar las semanas seleccionadas. Recarga el reporte y vuelve a seleccionarlas.' : /Failed to fetch|NetworkError/i.test(err.message) ? 'No pudimos conectar con el servidor. Revisa tu conexión y vuelve a intentarlo.' : err.message;
        await Swal.fire({icon: 'error', title: 'No se pudieron cerrar las semanas', text: mensaje, confirmButtonText: 'Entendido'});
    } finally {
        cerrandoSemanas = false;
        btn.disabled = seleccion.size === 0;
    }
}
</script>

