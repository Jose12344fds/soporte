<?php
$page_title = 'Proyectos SAP HANA - Consulta PCP';
require_once dirname(dirname(__DIR__)) . '/includes/load.php';
require_permiso('hh-meta', 'ver');

// Catálogo de horas meta para distribución automática (tabla calculohoras)
$calculoHorasCatalog = [];
$rawCalculoHoras = find_by_sql("SELECT Tipo, MO001, MO002, MO004, MO014, MO008, MO007, MO003, MO015, MO005, MO009, MO004P, MO006, MO012, MO011, MO020, MO010 FROM calculohoras");
foreach ($rawCalculoHoras as $row) {
    $tipoKey = strtoupper(trim($row['Tipo'] ?? ''));
    if ($tipoKey === '' || isset($calculoHorasCatalog[$tipoKey])) continue;
    $calculoHorasCatalog[$tipoKey] = [
        'MO001' => (float)($row['MO001'] ?? 0), 'MO002' => (float)($row['MO002'] ?? 0),
        'MO004' => (float)($row['MO004'] ?? 0), 'MO014' => (float)($row['MO014'] ?? 0),
        'MO008' => (float)($row['MO008'] ?? 0), 'MO007' => (float)($row['MO007'] ?? 0),
        'MO003' => (float)($row['MO003'] ?? 0), 'MO015' => (float)($row['MO015'] ?? 0),
        'MO005' => (float)($row['MO005'] ?? 0), 'MO009' => (float)($row['MO009'] ?? 0),
        'MO004P' => (float)($row['MO004P'] ?? 0), 'MO006' => (float)($row['MO006'] ?? 0),
        'MO012' => (float)($row['MO012'] ?? 0), 'MO011' => (float)($row['MO011'] ?? 0),
        'MO020' => (float)($row['MO020'] ?? 0), 'MO010' => (float)($row['MO010'] ?? 0),
    ];
}
// ID para la tabla otpadre (siguiente correlativo)
$all_countOTPADRE = CountVariabel();
$numValue = $all_countOTPADRE[0]['NUM'];

include_once dirname(dirname(__DIR__)) . '/layouts/header.php';
?>

