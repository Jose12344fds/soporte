window.calculoHorasConfig = <?php echo json_encode($calculoHorasCatalog, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES); ?>;
window.numValuePE = <?php echo json_encode($numValue + 1); ?>;
</script>

