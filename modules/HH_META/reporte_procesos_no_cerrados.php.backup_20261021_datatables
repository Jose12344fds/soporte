<script>
let datosCompletos = [];
let seleccion = new Set();

// Cargar datos del reporte
document.addEventListener('DOMContentLoaded', function() {
    console.log('Cargando reporte de procesos no cerrados...');
    cargarDatos();
    cargarFiltros();
});

function cargarDatos() {
    fetch('../../api/prgsemana/consulta_procesos_no_cerrados.php', { cache: 'no-store' })
        .then(response => {
            console.log('Respuesta recibida:', response);
            return response.json();
        })
        .then(data => {
            console.log('Datos recibidos:', data);
            
            document.getElementById('loading').style.display = 'none';
            document.getElementById('contenido').style.display = 'block';
            
            if (data.success && data.datos.length > 0) {
                datosCompletos = data.datos.map(item => ({ ...item, id_programa: item.id_programa ?? item.IdPrograma ?? item.idprograma ?? item.ID_PROGRAMA }));
                mostrarDatos(datosCompletos);
                actualizarEstadisticas(data.estadisticas);
                extraerValoresFiltros(datosCompletos);
            } else {
                document.getElementById('tabla-datos').innerHTML = 
                    '<tr><td colspan="12" style="text-align: center; padding: 20px;">No se encontraron procesos pendientes</td></tr>';
            }
        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById('loading').innerHTML = 
                '<h4 style="color: red;">Error al cargar los datos</h4><p>' + error + '</p>';
        });
}

function cargarFiltros() {
    // Cargar años disponibles (últimos 3 años)
    const añoActual = new Date().getFullYear();
    const selectAño = document.getElementById('filtro-anio');
    
    for (let i = 0; i < 3; i++) {
        const año = añoActual - i;
        const option = document.createElement('option');
        option.value = año;
        option.textContent = año;
        selectAño.appendChild(option);
    }
}

function extraerValoresFiltros(datos) {
    // Extraer OTs únicas desde projectCode (otpadre)
    const proyectosMap = new Map();
    datos.forEach(item => {
        const key = (item.projectCode ?? item.proyecto ?? '').toString().trim();
        if (!key || proyectosMap.has(key)) return;
        const desc = (item.descripcion ?? '').toString().trim();
        const label = desc && desc !== key ? `${key} - ${desc}` : `${key}`;
        proyectosMap.set(key, label);
    });
    const proyectos = Array.from(proyectosMap.keys()).sort();
    const selectProyecto = document.getElementById('filtro-proyecto');
    
    // Limpiar opciones existentes (excepto "Todos")
    selectProyecto.innerHTML = '<option value="">Todos</option>';
    
    proyectos.forEach(proyecto => {
        const option = document.createElement('option');
        option.value = proyecto;
        option.textContent = proyectosMap.get(proyecto) || `${proyecto}`;
        selectProyecto.appendChild(option);
    });
}

function aplicarFiltros() {
    const filtroProyecto = document.getElementById('filtro-proyecto').value;
    const filtroProceso = document.getElementById('filtro-proceso').value;
    const filtroAño = document.getElementById('filtro-anio').value;

    let datosFiltrados = datosCompletos.filter(item => {
        let cumple = true;
        
        const proyecto = (item.projectCode ?? item.proyecto ?? '').toString().trim();
        if (filtroProyecto && proyecto !== filtroProyecto) cumple = false;
        const categoria = (item.categoria_proceso || '').toString();
        if (filtroProceso && !categoria.toLowerCase().includes(filtroProceso.toLowerCase())) cumple = false;
        if (filtroAño && item.anio != filtroAño) cumple = false;
        
        return cumple;
    });

    mostrarDatos(datosFiltrados);
    actualizarEstadisticasFiltradas(datosFiltrados);
}

function actualizarEstadisticas(stats) {
    document.getElementById('total-procesos').textContent = stats.total_procesos || 0;
    document.getElementById('total-proyectos').textContent = stats.total_proyectos || 0;
    document.getElementById('total-semanas').textContent = stats.total_semanas || 0;
    document.getElementById('promedio-retraso').textContent = (stats.promedio_dias_retraso || 0).toFixed(1);
}

function actualizarEstadisticasFiltradas(datos) {
    const proyectosUnicos = new Set(datos.map(item => item.projectCode || item.proyecto));
    const semanasUnicas = new Set(datos.map(item => `${item.anio}-${item.semana}`));
    
    document.getElementById('total-procesos').textContent = datos.length;
    document.getElementById('total-proyectos').textContent = proyectosUnicos.size;
    document.getElementById('total-semanas').textContent = semanasUnicas.size;
}

function mostrarDatos(datos) {
    const tbody = document.getElementById('tabla-datos');
    tbody.innerHTML = ''; seleccion.clear();

    if (!Array.isArray(datos) || datos.length === 0) {
        tbody.innerHTML = '<tr><td colspan="12" style="text-align: center; padding: 20px; color:#7f8c8d;">No hay resultados con los filtros seleccionados</td></tr>';
        wireSeleccionEventos();
        return;
    }
    
    datos.forEach(item => {
        const row = tbody.insertRow();
        
        // Formatear fecha si existe
        let fechaCalculo = '-';
        if (item.fecha_calculo) {
            const fecha = new Date(item.fecha_calculo);
            fechaCalculo = fecha.toLocaleDateString('es-ES');
        }
        
        row.innerHTML = `
            <td><input type="checkbox" class="chk-row" data-id="${item.id_programa}"></td>
            <td><strong>${(item.projectCode || item.proyecto) ? (item.projectCode || item.proyecto) : '-'}</strong></td>
            <td title="${item.descripcion || ''}">${truncarTexto(item.descripcion || '-', 25)}</td>
            <td><strong>${item.item || '-'}</strong></td>
            <td title="${item.descripcion_item || ''}">${truncarTexto(item.descripcion_item || '-', 20)}</td>
            <td>
                <span style="background-color: ${getColorProceso(item.categoria_proceso)}; color: white; padding: 2px 4px; border-radius: 3px; font-size: 10px;" title="${item.codigo_proceso || ''} - ${item.proceso || ''}">
                    ${truncarTexto(item.proceso || item.codigo_proceso || '-', 20)}
                </span>
            </td>
            <td>${item.anio || '-'}</td>
            <td><strong>${item.semana || '-'}</strong></td>
            <td>${parseFloat(item.porcentaje || 0).toFixed(1)}%</td>
            <td>${parseFloat(item.horas || 0).toFixed(1)}</td>
            <td>${fechaCalculo}</td>
            <td><span style="background-color: #e74c3c; color: white; padding: 2px 4px; border-radius: 3px; font-size: 10px;">PENDIENTE</span></td>
        `;
    });

    wireSeleccionEventos();
}

function truncarTexto(texto, limite) {
    if (!texto || texto === '-') return '-';
    return texto.length > limite ? texto.substring(0, limite) + '...' : texto;
}

function getColorProceso(categoria) {
    if (!categoria) return '#6c757d';
    switch(categoria.toLowerCase()) {
        case 'habilitado': return '#2ecc71';
        case 'fabricación': case 'fabricacion': return '#e67e22';
        case 'mecanizado': return '#f39c12';
        case 'soldadura': case 'soldeo': return '#e74c3c';
        case 'calderería': case 'caldereria': case 'armado': return '#9b59b6';
        case 'acabados': case 'acabado': return '#3498db';
        default: return '#6c757d';
    }
}

// Gestionar selección y cierre
function wireSeleccionEventos() {
    const selCount = document.getElementById('sel-count');
    const btnCerrar = document.getElementById('btn-cerrar-seleccion');
    const chkAll = document.getElementById('chk-all');

    function refreshUI() {
        selCount.textContent = seleccion.size;
        btnCerrar.disabled = seleccion.size === 0;
        if (chkAll) {
            const totalRows = document.querySelectorAll('#tabla-datos .chk-row').length;
            const selectedRows = seleccion.size;
            chkAll.checked = totalRows > 0 && selectedRows === totalRows;
            chkAll.indeterminate = selectedRows > 0 && selectedRows < totalRows;
        }
    }

    // filas
    document.querySelectorAll('#tabla-datos .chk-row').forEach(chk => {
        chk.addEventListener('change', function() {
            const id = Number(this.getAttribute('data-id'));
            if (!Number.isSafeInteger(id) || id <= 0) { this.checked = false; Swal.fire({icon: "warning", title: "Actualiza el reporte", text: "No pudimos identificar esta fila. Recarga la página y vuelve a seleccionarla.", confirmButtonText: "Entendido"}); return; } if (this.checked) seleccion.add(id); else seleccion.delete(id);
            refreshUI();
        });
    });

    // seleccionar todo
    if (chkAll && !chkAll._bound) {
        chkAll.addEventListener('change', function() {
            const check = this.checked;
            document.querySelectorAll('#tabla-datos .chk-row').forEach(chk => {
                chk.checked = check;
                const id = Number(chk.getAttribute('data-id'));
                if (!Number.isSafeInteger(id) || id <= 0) { chk.checked = false; return; } if (check) seleccion.add(id); else seleccion.delete(id);
            });
            refreshUI();
        });
        chkAll._bound = true;
    }

    // botón cerrar
    if (btnCerrar && !btnCerrar._bound) {
        btnCerrar.addEventListener('click', cerrarSeleccionadas);
        btnCerrar._bound = true;
    }

    refreshUI();
}

let cerrandoSemanas = false;
async function cerrarSeleccionadas() {
    if (cerrandoSemanas) return;
    const ids = Array.from(seleccion).filter(id => Number.isSafeInteger(id) && id > 0);
    if (!ids.length) {
        await Swal.fire({icon: 'info', title: 'Selecciona las semanas', text: 'Marca al menos una fila válida. Si el problema continúa, recarga el reporte.', confirmButtonText: 'Entendido'});
        return;
    }
    cerrandoSemanas = true;
    const btn = document.getElementById('btn-cerrar-seleccion');
    btn.disabled = true;
    try {
        const confirma = await Swal.fire({icon: 'question', title: '¿Cerrar las semanas seleccionadas?', text: 'Se cerrarán ' + ids.length + ' registro(s) de programación.', showCancelButton: true, confirmButtonText: 'Sí, cerrar semanas', cancelButtonText: 'Cancelar', confirmButtonColor: '#218838', focusCancel: true});
        if (!confirma.isConfirmed) return;
        Swal.fire({title: 'Cerrando semanas', text: 'Espera mientras guardamos los cambios.', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => Swal.showLoading()});
        const form = new URLSearchParams();
        form.append('_csrf', document.querySelector('meta[name="csrf-token"]').content);
        ids.forEach(id => form.append('ids[]', String(id)));
        const resp = await fetch('../../api/prgsemana/cerrar_semanas.php', {method: 'POST', body: form});
        const data = await resp.json();
        if (!resp.ok || !data.success) throw new Error(data.message || data.error || 'No pudimos guardar el cierre. Inténtalo nuevamente.');
        const cerradas = new Set((data.ids || ids).map(Number));
        datosCompletos = datosCompletos.filter(it => !cerradas.has(Number(it.id_programa)));
        seleccion.clear();
        aplicarFiltros();
        await Swal.fire({icon: 'success', title: 'Cierre completado', text: 'Se cerraron ' + data.afectados + ' registro(s) de programación.', confirmButtonText: 'Aceptar', confirmButtonColor: '#218838'});
    } catch (err) {
        console.error(err);
        const mensaje = /IDs|identificadores/i.test(err.message) ? 'No pudimos identificar las semanas seleccionadas. Recarga el reporte y vuelve a seleccionarlas.' : /Failed to fetch|NetworkError/i.test(err.message) ? 'No pudimos conectar con el servidor. Revisa tu conexión y vuelve a intentarlo.' : err.message;
        await Swal.fire({icon: 'error', title: 'No se pudieron cerrar las semanas', text: mensaje, confirmButtonText: 'Entendido'});
    } finally {
        cerrandoSemanas = false;
        btn.disabled = seleccion.size === 0;
    }
}
</script>

