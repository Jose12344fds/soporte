if (!function_exists('inc_datetime')) {
    function inc_datetime(?string $value, string $format = 'd/m/Y H:i'): string
    {
        if (!$value || $value === '0000-00-00 00:00:00') return '-';
        $time = strtotime($value);
        return $time ? date($format, $time) : '-';
    }
}

if (!function_exists('inc_duration')) {
    function inc_duration($minutes): string
    {
        if ($minutes === null || $minutes === '') return '-';
        $minutes = max(0, (int)round((float)$minutes));
        $days = intdiv($minutes, 1440);
        $hours = intdiv($minutes % 1440, 60);
        $mins = $minutes % 60;
        $parts = [];
        if ($days) $parts[] = $days.' d';
        if ($hours) $parts[] = $hours.' h';
        if ($mins || !$parts) $parts[] = $mins.' min';
        return implode(' ', $parts);
    }
}

