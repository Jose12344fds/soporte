if (!function_exists('inc_normalize_uploads')) {
    function inc_normalize_uploads(string $field): array
    {
        if (empty($_FILES[$field]) || !is_array($_FILES[$field])) return [];
        $file = $_FILES[$field];
        if (!is_array($file['name'] ?? null)) return [$file];
        $items = [];
        foreach ($file['name'] as $index => $name) {
            $items[] = [
                'name' => $name,
                'type' => $file['type'][$index] ?? '',
                'tmp_name' => $file['tmp_name'][$index] ?? '',
                'error' => $file['error'][$index] ?? UPLOAD_ERR_NO_FILE,
                'size' => $file['size'][$index] ?? 0,
            ];
        }
        return $items;
    }
}

if (!function_exists('inc_store_uploads')) {
    function inc_store_uploads(int $ticketId, string $field = 'adjuntos', int $trackingId = 0): array
    {
        global $db;
        $result = ['added' => 0, 'errors' => []];
        $allowed = [
            'jpg' => ['image/jpeg'], 'jpeg' => ['image/jpeg'], 'png' => ['image/png'], 'webp' => ['image/webp'],
            'pdf' => ['application/pdf'], 'txt' => ['text/plain'], 'csv' => ['text/plain', 'text/csv', 'application/vnd.ms-excel'],
            'doc' => ['application/msword', 'application/octet-stream', 'application/x-ole-storage', 'application/CDFV2'],
            'docx' => ['application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/zip', 'application/octet-stream'],
            'xls' => ['application/vnd.ms-excel', 'application/octet-stream', 'application/x-ole-storage', 'application/CDFV2'],
            'xlsx' => ['application/vnd.openxmlformats-officedocument.spreadsheetml.sheet', 'application/zip', 'application/octet-stream'],
            'msg' => ['application/vnd.ms-outlook', 'application/octet-stream', 'application/x-ole-storage', 'application/CDFV2'],
            'eml' => ['message/rfc822', 'text/plain', 'application/octet-stream'],
        ];
        $files = inc_normalize_uploads($field);
        if (count($files) > 8) {
            $result['errors'][] = 'Puede adjuntar como maximo 8 archivos por operacion.';
            $files = array_slice($files, 0, 8);
        }
        $directory = inc_upload_root().DIRECTORY_SEPARATOR.date('Y').DIRECTORY_SEPARATOR.date('m');
        if (!is_dir($directory) && !mkdir($directory, 0775, true) && !is_dir($directory)) {
            $result['errors'][] = 'No se pudo preparar la carpeta de evidencias.';
            return $result;
        }
        foreach ($files as $file) {
            $error = (int)($file['error'] ?? UPLOAD_ERR_NO_FILE);
            if ($error === UPLOAD_ERR_NO_FILE) continue;
            if ($error !== UPLOAD_ERR_OK) {
                $result['errors'][] = 'No se pudo recibir '.basename((string)($file['name'] ?? 'archivo')).'.';
                continue;
            }
            $size = (int)($file['size'] ?? 0);
            if ($size <= 0 || $size > 15 * 1024 * 1024) {
                $result['errors'][] = basename((string)$file['name']).' supera el limite de 15 MB o esta vacio.';
                continue;
            }
            $original = basename((string)$file['name']);
            $extension = strtolower(pathinfo($original, PATHINFO_EXTENSION));
            if (!isset($allowed[$extension])) {
                $result['errors'][] = $original.' tiene un formato no permitido.';
                continue;
            }
            $mime = 'application/octet-stream';
            if (function_exists('finfo_open')) {
                $finfo = finfo_open(FILEINFO_MIME_TYPE);
                if ($finfo) {
                    $detected = finfo_file($finfo, (string)$file['tmp_name']);
                    if (is_string($detected) && $detected !== '') $mime = $detected;
                    finfo_close($finfo);
                }
            }
            if (!in_array($mime, $allowed[$extension], true)) {
                $result['errors'][] = $original.' no coincide con el tipo de archivo esperado.';
                continue;
            }
            $stored = date('Ymd_His').'_'.$ticketId.'_'.bin2hex(random_bytes(8)).'.'.$extension;
            $target = $directory.DIRECTORY_SEPARATOR.$stored;
            if (!move_uploaded_file((string)$file['tmp_name'], $target)) {
                $result['errors'][] = 'No se pudo guardar '.$original.'.';
                continue;
            }
            $relative = date('Y').'/'.date('m').'/'.$stored;
            $originalSql = $db->escape($original);
            $storedSql = $db->escape($stored);
            $relativeSql = $db->escape($relative);
            $mimeSql = $db->escape($mime);
            $user = inc_user();
            $userId = (int)($user['id'] ?? 0);
            $userName = $db->escape((string)($user['name'] ?? $user['username'] ?? 'Sistema'));
            $trackingSql = $trackingId > 0 ? (string)$trackingId : 'NULL';
            $db->query("INSERT INTO inc_adjuntos (IdTicket,IdSeguimiento,NombreOriginal,NombreArchivo,Ruta,Mime,Tamano,SubidoPor,SubidoPorNombre)
                VALUES ({$ticketId},{$trackingSql},'{$originalSql}','{$storedSql}','{$relativeSql}','{$mimeSql}',{$size},{$userId},'{$userName}')");
            $result['added']++;
        }
        return $result;
    }
}

if (!function_exists('inc_sla_for_priority')) {
    function inc_sla_for_priority(string $priority): ?array
    {
        global $db;
        $priority = $db->escape($priority);
        $query = $db->query("SELECT * FROM inc_sla_politicas WHERE Prioridad='{$priority}' AND Activa=1 LIMIT 1");
        return $db->num_rows($query) ? $db->fetch_assoc($query) : null;
    }
}

if (!function_exists('inc_redirect')) {
    function inc_redirect(string $message, string $type = 's', string $url = 'index.php'): void
    {
        global $session;
        $session->msg($type, $message);
        redirect($url, false);
    }
}
