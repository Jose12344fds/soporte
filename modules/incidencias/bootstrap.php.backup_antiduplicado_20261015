if (!function_exists('inc_add_timeline')) {
    function inc_add_timeline(int $ticketId, string $type, string $comment, bool $public = true, ?string $oldStatus = null, ?string $newStatus = null): int
    {
        global $db;
        $user = inc_user();
        $userId = (int)($user['id'] ?? 0);
        $userName = $db->escape((string)($user['name'] ?? $user['username'] ?? 'Sistema'));
        $type = $db->escape($type);
        $comment = $db->escape($comment);
        $oldSql = $oldStatus === null ? 'NULL' : "'".$db->escape($oldStatus)."'";
        $newSql = $newStatus === null ? 'NULL' : "'".$db->escape($newStatus)."'";
        $db->query("INSERT INTO inc_seguimiento (IdTicket,UsuarioId,UsuarioNombre,Tipo,Comentario,EsPublico,EstadoAnterior,EstadoNuevo)
            VALUES ({$ticketId},{$userId},'{$userName}','{$type}','{$comment}',".($public ? 1 : 0).",{$oldSql},{$newSql})");
        return (int)$db->insert_id();
    }
}

