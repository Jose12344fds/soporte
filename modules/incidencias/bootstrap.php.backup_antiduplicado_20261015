}

if (!function_exists('inc_is_agent')) {
    function inc_is_agent(): bool
    {
        if (function_exists('tiene_permiso') && tiene_permiso('incidencias', 'editar')) return true;
        $user = inc_user();
        return (int)($user['status'] ?? 0) === 1 && (int)($user['es_personal_ti'] ?? 0) === 1;
    }
}

if (!function_exists('inc_priority')) {
    function inc_priority(int $impact, int $urgency): string
    {
        $score = max(1, min(4, $impact)) * max(1, min(4, $urgency));
        if ($score >= 12) return 'CRITICA';
        if ($score >= 8) return 'ALTA';
        if ($score >= 4) return 'MEDIA';
        return 'BAJA';
    }
}

