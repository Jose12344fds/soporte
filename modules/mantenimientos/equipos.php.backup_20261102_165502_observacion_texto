function badgeEstado(s){
    var st = normEstado(s);
    if (st.indexOf('BAJA') >= 0 || st === 'INACTIVO') return '<span class="badge badge-pill badge-eq-off px-2">' + esc(st || 'INACTIVO') + '</span>';
    if (st === 'OPERATIVO' || st === 'ACTIVO') return '<span class="badge badge-pill badge-eq-ok px-2">' + esc(st) + '</span>';
    return '<span class="badge badge-pill badge-eq-mid px-2">' + esc(st || 'SIN ESTADO') + '</span>';
}
function criticidadValida(row){
    return criticidadFactores.every(function(factor){
        var value = Number(row[factor.key]);
        return Number.isInteger(value) && value >= 1 && value <= 5;
    });
}
function badgeCriticidad(row){
    var level = normEstado(row.Nivel_Criterio);
    var risk = Number(row.Riesgo_EVA);
    if (!criticidadValida(row) || !['ALTO','MEDIO','BAJO'].includes(level) || !Number.isFinite(risk) || risk <= 0) {
        return '<span class="criticidad-badge SIN_EVALUAR"><i class="fas fa-circle-minus"></i>Sin evaluar</span>';
    }
    return '<span class="criticidad-badge ' + level + '">' + esc(level) + '</span><div class="criticidad-percent">' + risk.toFixed(2) + '%</div>';
}
function renderCriticidadFactores(row){
    var html = criticidadFactores.map(function(factor){
        var selected = parseInt(row[factor.key], 10);
        var buttons = [1,2,3,4,5].map(function(value){
            return '<button type="button" class="criticidad-score' + (selected === value ? ' active' : '') + '" data-value="' + value + '" title="' + attr(criticidadEtiquetas[value]) + '">' + value + '</button>';
        }).join('');
        return '<div class="criticidad-factor-card" data-factor="' + attr(factor.key) + '" data-value="' + (selected >= 1 && selected <= 5 ? selected : '') + '">'
            + '<button type="button" class="criticidad-factor-title" data-toggle="popover" data-trigger="hover focus" data-placement="top" data-content="' + attr(factor.help) + '">'
            + '<span>' + esc(factor.code) + '</span><div><strong>' + esc(factor.name) + '</strong><small>Pase aqui para ver su significado</small></div><i class="fas fa-circle-info"></i></button>'
            + '<div class="criticidad-scores">' + buttons + '</div>'
            + '<div class="criticidad-score-label">' + (criticidadEtiquetas[selected] || 'Seleccione una calificacion') + '</div></div>';
    }).join('');
    $('#criticidadFactores').html(html);
    $('#modalCriticidad [data-toggle="popover"]').popover({container:'#modalCriticidad'});
    calcularCriticidad();
}
function calcularCriticidad(){
    var values = {};
    $('.criticidad-factor-card').each(function(){
        var value = parseInt(this.dataset.value, 10);
        if (value >= 1 && value <= 5) values[this.dataset.factor] = value;
    });
    if (Object.keys(values).length !== criticidadFactores.length) {
        $('#criticidadNivel').text('SIN EVALUAR');
        $('#criticidadRiesgo').text('0.00%');
        $('#criticidadBarra').css('width','0%').removeClass('bg-danger bg-warning bg-success');
        $('#criticidadResultado').attr('data-level','SIN_EVALUAR');
        $('#criticidadAyuda').text('Complete los siete factores para obtener el resultado.');
        return null;
    }
    var avgFrequency = (values.F1_EVA + values.R_EVA) / 2;
    var avgImpact = (values.SHA_EVA + values.IC_EVA + values.IP_EVA + values.BM_EVA + values.CM_EVA) / 5;
    var risk = Math.round(((avgFrequency * avgImpact / 25) * 100) * 100) / 100;
    var level = risk > 36.99 ? 'ALTO' : (risk >= 16.99 ? 'MEDIO' : 'BAJO');
    var color = level === 'ALTO' ? 'bg-danger' : (level === 'MEDIO' ? 'bg-warning' : 'bg-success');
    $('#criticidadNivel').text(level);
    $('#criticidadRiesgo').text(risk.toFixed(2) + '%');
    $('#criticidadBarra').css('width',Math.min(100,risk) + '%').removeClass('bg-danger bg-warning bg-success').addClass(color);
    $('#criticidadResultado').attr('data-level',level);
    $('#criticidadAyuda').text(level === 'ALTO' ? 'Equipo prioritario: requiere mayor control y seguimiento.' : (level === 'MEDIO' ? 'Equipo con riesgo moderado: mantenga el plan preventivo.' : 'Equipo con riesgo controlado segun la evaluacion actual.'));
    return {values:values, risk:risk, level:level};
}
function abrirCriticidad(code){
    var row = allEquiposRows.find(function(item){ return String(item.Code) === String(code); });
    if (!row) return;
    $('#criticidadCode').val(row.Code);
    $('#criticidadEquipoNombre').text((row.ItemCode || row.Name || '-') + ' - ' + (row.ItemName || ''));
    $('#criticidadEquipoDetalle').text((row.TIP_EMH || 'Sin tipo') + ' / ' + (row.Ubicacion || 'Sin ubicacion'));
    renderCriticidadFactores(row);
    if (criticidadConfigurada) {
        $('#criticidadSetupAlert').hide().empty();
    } else {
        $('#criticidadSetupAlert').html('<strong><i class="fas fa-triangle-exclamation mr-1"></i>Configuracion SAP pendiente.</strong> Cree estos campos en @TAMA_EQUIPOS_TM: <code>' + criticidadCamposFaltantes.map(esc).join('</code>, <code>') + '</code>.').show();
    }
    $('#btnGuardarCriticidad').prop('disabled', !criticidadConfigurada);
    $('#modalCriticidad').modal('show');
}
function guardarCriticidad(){
    var result = calcularCriticidad();
    if (!result) { Swal.fire('Evaluacion incompleta','Califique los siete factores del 1 al 5.','warning'); return; }
    var payload = Object.assign({code:formVal('criticidadCode')}, result.values);
    var button = $('#btnGuardarCriticidad');
