function guardarEquipo(bajaConfirmada){
    var payload = payloadEquipo();
    var tieneFotoNueva = !!(document.getElementById('neFotoEquipo').files || [])[0];
    var tieneManualNuevo = !!(document.getElementById('neManualEquipo').files || [])[0];
    if (!payload.itemcode || !payload.itemname) { Swal.fire('Campos requeridos','Complete código y nombre del equipo.','warning'); return; }
    var original = allEquiposRows.find(function(row){ return String(row.Code) === String(payload.code); });
    var esNuevaBaja = payload.action === 'update' && normEstado(payload.estado) === 'DE BAJA'
        && (!original || normEstado(original.Estado) !== 'DE BAJA');
    if (esNuevaBaja && bajaConfirmada !== true) {
        Swal.fire({
            title:'Dar de baja el equipo?',
            html:'Se inactivaran sus planes y se cancelaran las ocurrencias pendientes desde la fecha de baja.<br><br>'
                + '<b>No se borraran</b> mantenimientos ejecutados ni ocurrencias que tengan una OT.',
            icon:'warning',
            showCancelButton:true,
            confirmButtonText:'Si, guardar la baja',
            cancelButtonText:'Volver',
            confirmButtonColor:'#dc3545'
        }).then(function(result){ if (result.isConfirmed) guardarEquipo(true); });
        return;
    }
    var btn = $('#btnGuardarEquipo'); var old = btn.html();
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Guardando');
    fetch(BASE + '/api/mantenimientos/guardar_equipo.php', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) })
        .then(function(r){ return r.json().then(function(j){ if (!r.ok || !j.success) throw new Error(j.error || 'Error al guardar.'); return j; }); })
        .then(function(j){
            btn.html('<i class="fas fa-spinner fa-spin mr-1"></i>Guardando archivos');
            var code=String(j.Code||payload.code);
            return Promise.allSettled([subirEquipoFoto(code,payload.itemcode),subirEquipoManual(code,payload.itemcode)]).then(function(files){
                return {sap:j,fotoOk:files[0].status==='fulfilled',fotoError:files[0].status==='rejected'?files[0].reason.message:'',manualOk:files[1].status==='fulfilled',manualError:files[1].status==='rejected'?files[1].reason.message:''};
            });
        })
        .then(function(resultado){
            btn.prop('disabled', false).html(old);
            $('#modalEquipo').modal('hide');
            cargarEquipos();
            if (!resultado.fotoOk || !resultado.manualOk) {
                var errores=[]; if(!resultado.fotoOk)errores.push('Foto: '+resultado.fotoError); if(!resultado.manualOk)errores.push('Manual: '+resultado.manualError);
                Swal.fire('Equipo guardado en SAP', errores.join('<br>')+'<br><small>Puede volver a cargar el archivo desde Editar.</small>', 'warning');
                return;
            }
            if (normEstado(payload.estado) === 'DE BAJA') {
                var baja = resultado.sap.baja || {};
                var bajaError = String(resultado.sap.baja_error || '');
                var bloqueadas = Number(baja.ocurrencias_con_ot || 0);
                Swal.fire({
                    icon: (bajaError || bloqueadas > 0) ? 'warning' : 'success',
                    title: bajaError ? 'Equipo guardado; programación pendiente' : 'Equipo dado de baja',
                    html:(bajaError
                        ? '<b>' + esc(payload.itemcode) + '</b> quedó guardado como <b>DE BAJA</b>, pero SAP no completó la regularización:<br><small>' + esc(bajaError) + '</small><hr>'
                        : '')
                        + '<b>' + Number(baja.planes_inactivados || 0) + '</b> plan(es) inactivado(s).<br>'
                        + '<b>' + Number(baja.ocurrencias_canceladas || 0) + '</b> ocurrencia(s) cancelada(s).'
                        + (bloqueadas > 0 ? '<br><b>' + bloqueadas + '</b> ocurrencia(s) conservada(s) porque tienen OT.' : '')
                });
                return;
            }
            Swal.fire({
                icon:'success',
                title: payload.action === 'update' ? 'Equipo actualizado' : 'Equipo agregado',
                text: tieneFotoNueva || tieneManualNuevo ? 'Los datos SAP y sus archivos quedaron guardados.' : 'Los datos del equipo quedaron guardados en SAP.',
                timer:1700,
                showConfirmButton:false
            });
        })
        .catch(function(e){ btn.prop('disabled', false).html(old); Swal.fire('No se completó el guardado', e.message, 'error'); });
}
