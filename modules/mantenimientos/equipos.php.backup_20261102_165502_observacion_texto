function exportarReporteCriticidad(){
    if (!dtReporteCriticidad || !dtReporteCriticidad.rows({search:'applied'}).count()) { Swal.fire('Sin datos','No hay equipos para exportar.','info'); return; }
    var params=new URLSearchParams({buscar:($('#crBuscar').val()||'').trim(),familia:$('#crFamilia').val()||'',nivel:$('#crNivel').val()||''});
    var button=$('#crExcel'),old=button.html(); button.prop('disabled',true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Preparando');
    window.location.href=BASE+'/api/mantenimientos/exportar_criticidad_xlsx.php?'+params.toString();
