function abrirReporteEstado(){
    if (!dtEquipos) return;
    var rows = dtEquipos.rows({search:'applied'}).data().toArray();
    var counts = {OPERATIVO:0, INOPERATIVO:0, 'DE BAJA':0};
    rows.forEach(function(r){
        var st = normEstado(r.Estado);
        if (st.indexOf('BAJA') >= 0) counts['DE BAJA']++;
        else if (st === 'OPERATIVO' || st === 'ACTIVO') counts.OPERATIVO++;
        else counts.INOPERATIVO++;
    });
    $('#erTotal').text(rows.length);
    $('#erOperativo').text(counts.OPERATIVO);
    $('#erInoperativo').text(counts.INOPERATIVO);
    $('#erBaja').text(counts['DE BAJA']);
    $('#erVacio').toggle(rows.length === 0);
    $('#btnDescargarReporteEstado').prop('disabled', rows.length === 0);
    $('#modalReporteEstado').modal('show');
}
function exportarReporteEstado(){
    if (!dtEquipos || !dtEquipos.rows({search:'applied'}).count()) { Swal.fire('Sin datos','No hay equipos para exportar con los filtros actuales.','info'); return; }
    var params = new URLSearchParams({buscar:($('#buscarEquipos').val()||'').trim(),nivel:$('#filtroCriticidad').val()||'',estado:$('#filtroEstado').val()||''});
    var btn = $('#btnDescargarReporteEstado'), old = btn.html();
    btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i>Preparando');
    window.location.href = BASE + '/api/mantenimientos/exportar_equipos_xlsx.php?' + params.toString();
    setTimeout(function(){ btn.prop('disabled', false).html(old); $('#modalReporteEstado').modal('hide'); }, 1800);
}
