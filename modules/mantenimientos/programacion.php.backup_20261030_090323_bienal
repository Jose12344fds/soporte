function processImportProgNext() {
    var body = new URLSearchParams({
        action:'batch',
        token:importProgToken,
        start:String(importProgStart),
        chunk:String(importProgChunk)
    });
    return fetch(importProgUrl, {
        method:'POST',
        headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},
        body:body.toString()
    })
    .then(function(r){ return r.json().then(function(j){ j._ok = r.ok; return j; }); })
    .then(function(json) {
        if (!json._ok || !json.success) throw new Error(json.error || 'Error en lote');
        importProgTotals.inserted += json.inserted || 0;
        importProgTotals.updated += json.updated || 0;
        importProgTotals.skipped += json.skipped || 0;
        importProgTotals.errors += json.errors_count || 0;
        importProgCounter();
        importProgLog(json.message || 'Lote procesado.');
        (json.errors || []).forEach(function(e) {
            importProgLog('OMITIDA fila ' + (e.row || '-') + ': ' + (e.error || 'Error') + ' | Code=' + (e.code || ''));
        });
        if (json.done) {
            document.getElementById('importProgBar').style.width = '100%';
            importProgStatus('Terminado');
            var btnDone = document.getElementById('btnStartImportProg');
            btnDone.disabled = false;
            btnDone.innerHTML = '<i class="fas fa-check mr-1"></i>Carga terminada';
            cargarProg();
            return;
        }
        importProgStart = json.nextStart || (importProgStart + importProgChunk);
        document.getElementById('importProgBar').style.width = Math.min(95, (importProgStart % 20000) / 200) + '%';
        setTimeout(function() {
            processImportProgNext().catch(function(err) {
                importProgStatus('Error');
                importProgLog('ERROR: ' + err.message);
                var btnRetry = document.getElementById('btnStartImportProg');
                btnRetry.disabled = false;
                btnRetry.textContent = 'Reintentar desde fila ' + importProgStart;
            });
        }, 80);
    });
}

$(document).on('click', '#btnOpenImportProg', function() {
    resetImportProgUi();
    $('#modalImportProg').modal('show');
});
$(document).on('submit', '#formImportProg', function(e) {
    e.preventDefault();
    var fd = new FormData(this);
    fd.append('action', 'prepare');
    var box = document.getElementById('boxImportProgProgress');
    var btn = document.getElementById('btnStartImportProg');
    var prepareBtn = document.getElementById('btnPrepareImportProg');
    box.style.display = 'block';
    document.getElementById('importProgLog').textContent = '';
    document.getElementById('importProgBar').style.width = '0%';
    importProgTotals = {inserted:0, updated:0, skipped:0, errors:0};
    importProgCounter();
    importProgStatus('Subiendo archivo...');
    btn.disabled = true;
    prepareBtn.disabled = true;
    fetch(importProgUrl, {method:'POST', body:fd})
        .then(function(r){ return r.json().then(function(j){ j._ok = r.ok; return j; }); })
        .then(function(json) {
            prepareBtn.disabled = false;
            if (!json._ok || !json.success) throw new Error(json.error || 'No se pudo preparar el archivo.');
            importProgToken = json.token;
            importProgStart = json.start || 2;
            importProgChunk = json.chunk || 500;
            importProgStatus('Archivo listo');
            importProgLog(json.message || 'Archivo preparado.');
            btn.disabled = false;
        })
        .catch(function(err) {
            prepareBtn.disabled = false;
            importProgStatus('Error');
            importProgLog('ERROR: ' + err.message);
        });
});
$(document).on('click', '#btnStartImportProg', function() {
    if (!importProgToken) return;
    this.disabled = true;
    this.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Procesando...';
    importProgStatus('Procesando lotes...');
    processImportProgNext().catch(function(err) {
        importProgStatus('Error');
        importProgLog('ERROR: ' + err.message);
        var btn = document.getElementById('btnStartImportProg');
        btn.disabled = false;
        btn.textContent = 'Reintentar desde fila ' + importProgStart;
    });
});
$(document).ready(function() {
    cargarProg();
});
JS;

