function saveSafeOccurrenceEdit() {
    var code = document.getElementById('editOccCode').value;
    var fecha = document.getElementById('editOccFecha').value;
    var fechaOriginal = document.getElementById('editOccFecha').getAttribute('data-original-date') || '';
    var fechaCambio = fecha !== fechaOriginal;
    var observacion = document.getElementById('editOccObservacion').value.trim();
    var motivo = document.getElementById('editOccMotivo').value.trim();
    if (!fecha || (fechaCambio && motivo.length < 4)) {
        Swal.fire(
            'Datos requeridos',
            fechaCambio
                ? 'Ingrese un motivo de al menos 4 caracteres para reprogramar.'
                : 'Conserve una fecha programada valida.',
            'warning'
        );
        return;
    }
    var button = document.getElementById('btnGuardarOcurrenciaSegura');
    var oldHtml = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>Guardando';
    submitSafeOccurrence({
        action: 'update_occurrence_safe',
        code: code,
        fecha: fecha,
        observacion: observacion,
        motivo: motivo,
        cancelar: false
    }, 'Ocurrencia actualizada').catch(function(error) {
        Swal.fire('No se pudo guardar', error.message, 'error');
    }).then(function() {
        button.disabled = false;
        button.innerHTML = oldHtml;
    });
}

function cancelSafeOccurrence(code) {
    var row = rowByOccurrenceCode(code);
    if (!occurrenceEditable(row)) {
        Swal.fire('Ocurrencia bloqueada', 'No se puede cancelar porque tiene OT o ya fue ejecutada.', 'warning');
        return;
    }
    Swal.fire({
        title: 'Cancelar ocurrencia?',
        html: '<b>' + esc(row.Code || '') + '</b><br><span class="text-muted">No se eliminara el registro.</span>',
        icon: 'warning',
        input: 'textarea',
        inputLabel: 'Motivo obligatorio',
        inputPlaceholder: 'Explique por que se cancela esta ocurrencia',
        inputAttributes: { maxlength: 220 },
        showCancelButton: true,
        confirmButtonText: 'Si, cancelar ocurrencia',
        cancelButtonText: 'Volver',
        confirmButtonColor: '#dc3545',
        inputValidator: function(value) {
            if (!value || value.trim().length < 4) return 'Ingrese un motivo de al menos 4 caracteres.';
        }
    }).then(function(result) {
        if (!result.isConfirmed) return;
        submitSafeOccurrence({
            action: 'update_occurrence_safe',
            code: row.Code,
            fecha: rawDate(row.U_FechaProg),
            observacion: occurrenceObservation(row),
            motivo: String(result.value || '').trim(),
            cancelar: true
        }, 'Ocurrencia cancelada').catch(function(error) {
            Swal.fire('No se pudo cancelar', error.message, 'error');
        });
    });
}

function eliminarProgramacion(planCode, planName, totalLineas) {
    if (!planCode) return;
    Swal.fire({
        title: 'Eliminar programación?',
        html: '<b>Plan:</b> ' + esc(planCode)
            + '<br><b>Descripción:</b> ' + esc(planName || '-')
            + '<br><b>Ocurrencias:</b> ' + esc(totalLineas || 0)
            + '<hr class="my-2"><span class="text-danger font-weight-bold">Se eliminarán también todas sus ocurrencias.</span>',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#dc3545'
    }).then(function(res) {
        if (!res.isConfirmed) return;
        fetch('$baseUrl/api/mantenimientos/guardar_prog.php', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ action: 'delete', code: planCode })
        })
        .then(function(r){ return r.json().then(function(j){ j._status = r.status; return j; }); })
        .then(function(json) {
            if (!json.success) {
                if (json._status === 404) {
                    removePlanFromUi(planCode);
                    cargarProg();
                    Swal.fire({
                        icon: 'info',
                        title: 'Programacion ya eliminada',
                        text: 'Se actualizo el listado.',
                        timer: 1500,
                        showConfirmButton: false
                    });
                    return;
                }
                Swal.fire('No se pudo eliminar', json.error || 'Error al eliminar la programación.', json._status === 409 ? 'warning' : 'error');
                return;
            }
            removePlanFromUi(planCode);
            Swal.fire({
                icon: 'success',
                title: 'Programación eliminada',
                text: 'Se eliminaron ' + (json.deleted_occurrences || 0) + ' ocurrencias.',
                timer: 1800,
                showConfirmButton: false
            });
            cargarProg();
        })
        .catch(function(err) {
            Swal.fire('Error conexión', err.message, 'error');
        });
    });
}

