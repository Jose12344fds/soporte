$inlineJs = <<<JS
var puedeEditar = {$puedeEditar};
var allRows = [];
var dtProg = null;
var dtPlanesResumen = null;
var selectedPlanCode = '';
var selectedEstado = '';
var selectedYear = '{$currentYear}';
var importProgUrl = '{$importProgUrl}';
var importProgToken = '';
var importProgStart = 2;
var importProgChunk = 500;
var importProgTotals = {inserted:0, updated:0, skipped:0, errors:0};

function esc(s) {
    return s == null ? '' : String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function attr(s) {
    return esc(s).replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function dateOnly(s) {
    if (!s) return '';
    var m = String(s).match(/^\\d{4}-\\d{2}-\\d{2}/);
    return m ? m[0] : String(s).split('T')[0].split(' ')[0];
}
function fmt(s) { return s ? dateOnly(s) : '-'; }
function rawDate(s) { return dateOnly(s); }
function rowYear(row) {
    var candidates = [row && row.U_AnioBase, row && row.U_Anio];
    for (var i = 0; i < candidates.length; i++) {
        var value = String(candidates[i] || '').trim();
        if (/^\d{4}$/.test(value)) return value;
    }
    var date = rawDate(row && row.U_FechaProg);
    return /^\d{4}-/.test(date) ? date.substring(0, 4) : '';
}
function rowsForSelectedYear() {
    return allRows.filter(function(row) { return rowYear(row) === selectedYear; });
}
function populateYearFilter() {
    var years = {};
    years[selectedYear] = true;
    allRows.forEach(function(row) {
        var year = rowYear(row);
        if (year) years[year] = true;
    });
    var options = Object.keys(years).sort(function(a, b) { return Number(b) - Number(a); });
    var select = document.getElementById('filtroAnioProg');
    select.innerHTML = options.map(function(year) {
        return '<option value="' + attr(year) + '">' + esc(year) + '</option>';
    }).join('');
    select.value = selectedYear;
}
function badgeTipo(code) {
    var labels = {PREV:'Preventivo',CORR:'Correctivo',PRED:'Predictivo',EMERG:'Emergencia'};
    return '<span class="badge badge-tipo-' + (code||'') + ' badge-pill px-2">' + esc(labels[code] || code || '-') + '</span>';
}
function modalidadLabel(code) {
    var value = String(code || '').toUpperCase();
    return value === 'M' || value === 'MR' ? value : 'F.D.';
}
function badgeModalidad(code) {
    var value = modalidadLabel(code);
    var css = value === 'M' ? 'badge-info' : value === 'MR' ? 'badge-success' : 'badge-warning text-dark';
    return '<span class="badge ' + css + ' badge-pill">' + esc(value) + '</span>';
}
function badgeEstado(s) {
    var labels = {
        Pendiente:'Pendiente',
        Ejecutado:'Ejecutado',
        Vencido:'Vencido',
        'Ejecutado fuera de fecha':'Ejecutado fuera de fecha'
    };
    var cls = s ? 'badge-estado-' + String(s).replace(/\\s+/g, '-') : 'badge-secondary';
    return '<span class="badge ' + cls + ' badge-pill">' + esc(labels[s] || s || '-') + '</span>';
}
function periodLabel(r) {
    if (r.U_TipoPeriodo === 'SEMANAL') return 'Sem ' + (r.U_Semana || r.U_PeriodoNum || '-');
    if (r.U_TipoPeriodo === 'QUINCENAL') return 'Qna ' + (r.U_PeriodoNum || '-');
    if (r.U_TipoPeriodo === 'MENSUAL') return 'Mes ' + (r.U_Mes || r.U_PeriodoNum || '-');
    if (r.U_TipoPeriodo === 'BIMENSUAL') return 'Bim ' + (r.U_PeriodoNum || '-');
    if (r.U_TipoPeriodo === 'TRIMESTRAL') return 'Trim ' + (r.U_PeriodoNum || '-');
    if (r.U_TipoPeriodo === 'SEMESTRAL') return 'Sem ' + (r.U_PeriodoNum || '-');
    if (r.U_TipoPeriodo === 'ANUAL') return 'Anual';
    return r.U_PeriodoNum ? 'Periodo ' + r.U_PeriodoNum : '-';
}
function otLabel(r) {
    if (r.U_OTDocNum) return 'OT-' + r.U_OTDocNum;
    if (r.U_OTDocEntry) return 'DocEntry ' + r.U_OTDocEntry;
    return '-';
}
function occurrenceEditable(row) {
    return !!row && row.IsOccurrence !== 'N' && !row.U_OTDocEntry && !row.U_OTDocNum
        && (row.U_Estado === 'Pendiente' || row.U_Estado === 'Vencido');
}
function occurrenceObservation(row) {
    if (!row) return '';
    return row.OccurrenceObservation != null ? String(row.OccurrenceObservation) : '';
}
function planObservation(row) {
    return row ? String(row.PlanObservation || '').trim() : '';
}
function isCustomOccurrenceObservation(row) {
    var occurrence = occurrenceObservation(row).trim();
    return occurrence !== '' && occurrence !== planObservation(row);
}
function effectiveObservation(row) {
    return isCustomOccurrenceObservation(row)
        ? occurrenceObservation(row).trim()
        : planObservation(row);
}
function buildPlanGroups(rows) {
    var groups = {};
    rows.forEach(function(r) {
        var key = r.PlanCode || r.Code;
        if (!groups[key]) {
            groups[key] = {
                planCode: key,
                name: r.Name || '',
                itemCode: r.U_ItemCode || '',
                itemName: r.ItemName || '',
                frecuencia: r.U_Frecuencia || '',
                tipo: r.U_TipoMant || '',
                rows: [],
                total: 0,
                pendiente: 0,
                ejecutado: 0,
                vencido: 0,
                fuera: 0
            };
        }
        groups[key].rows.push(r);
        groups[key].total++;
        if (r.U_Estado === 'Pendiente') groups[key].pendiente++;
        if (r.U_Estado === 'Ejecutado') groups[key].ejecutado++;
        if (r.U_Estado === 'Vencido') groups[key].vencido++;
        if (r.U_Estado === 'Ejecutado fuera de fecha') groups[key].fuera++;
    });
    Object.keys(groups).forEach(function(k) {
        groups[k].rows.sort(function(a,b) {
            return String(a.U_FechaProg || '').localeCompare(String(b.U_FechaProg || ''));
        });
    });
    return groups;
}
function calcStats(rows) {
    var total = rows.length, pend = 0, ejec = 0, venc = 0, ejecTarde = 0;
    rows.forEach(function(r) {
        if (r.U_Estado === 'Pendiente') pend++;
        if (r.U_Estado === 'Ejecutado') ejec++;
        if (r.U_Estado === 'Vencido') venc++;
        if (r.U_Estado === 'Ejecutado fuera de fecha') ejecTarde++;
    });
    document.getElementById('statTotal').textContent = total;
    document.getElementById('statPendiente').textContent = pend;
    document.getElementById('statEjecutado').textContent = ejec;
    document.getElementById('statVencido').textContent = venc;
    document.getElementById('statEjecutadoTarde').textContent = ejecTarde;
}
function renderPlanesResumen(rows) {
    var body = document.getElementById('planesResumenBody');
    var tableState = {
        search: '',
        page: 0,
        length: 10,
        order: [[0, 'asc']]
    };
    if (dtPlanesResumen) {
        tableState.search = dtPlanesResumen.search();
        tableState.page = dtPlanesResumen.page();
        tableState.length = dtPlanesResumen.page.len();
        tableState.order = dtPlanesResumen.order();
        dtPlanesResumen.destroy();
        dtPlanesResumen = null;
    }
    var groups = buildPlanGroups(rows);
    var plans = Object.keys(groups).map(function(k){ return groups[k]; });
    plans.sort(function(a,b){ return a.planCode.localeCompare(b.planCode); });
    body.innerHTML = plans.map(function(g) {
        return '<tr>'
            + '<td class="font-weight-bold text-monospace">' + esc(g.planCode) + '</td>'
            + '<td>' + esc(g.name) + '</td>'
            + '<td><span class="font-weight-bold">' + esc(g.itemCode) + '</span><br><small class="text-muted">' + esc(g.itemName) + '</small></td>'
            + '<td class="text-center">' + badgeModalidad(g.rows[0].U_Modalidad) + '</td>'
            + '<td class="text-center">' + esc(g.frecuencia || '-') + '</td>'
            + '<td class="text-center"><span class="plan-mini-badge bg-secondary text-white">' + g.total + '</span></td>'
            + '<td class="text-center"><span class="plan-mini-badge bg-warning text-dark">' + g.pendiente + '</span></td>'
            + '<td class="text-center"><span class="plan-mini-badge bg-success text-white">' + g.ejecutado + '</span></td>'
            + '<td class="text-center"><span class="plan-mini-badge bg-danger text-white">' + g.vencido + '</span></td>'
            + '<td class="text-center"><span class="plan-mini-badge" style="background:#fd7e14;color:#fff;">' + g.fuera + '</span></td>'
            + '<td class="text-center">'
            + '<div class="btn-group btn-group-sm">'
            + '<button type="button" class="btn btn-outline-primary btn-ver-plan" data-plan="' + attr(g.planCode) + '" title="Ver datos generales y calendario del plan"><i class="fas fa-eye"></i></button>'
            + (puedeEditar ? '<button type="button" class="btn btn-outline-info btn-edit-plan-safe" data-plan="' + attr(g.planCode) + '" title="Editar datos sin modificar ocurrencias"><i class="fas fa-edit"></i></button>' : '')
            + (puedeEditar ? '<button type="button" class="btn btn-outline-danger btn-delete-plan" data-plan="' + attr(g.planCode) + '" data-name="' + attr(g.name) + '" data-total="' + g.total + '" title="Eliminar programación"><i class="fas fa-trash"></i></button>' : '')
            + '</div>'
            + '</td>'
            + '</tr>';
    }).join('');
    document.getElementById('spinnerPlanes').style.display = 'none';
    document.getElementById('wrapPlanesResumen').style.display = '';
    dtPlanesResumen = $('#tblPlanesResumen').DataTable({
        language: DATATABLES_SPANISH,
        responsive: true,
        pageLength: tableState.length,
        order: tableState.order
    });
    if (tableState.search) {
        dtPlanesResumen.search(tableState.search).draw();
    }
    var pageInfo = dtPlanesResumen.page.info();
    if (pageInfo.pages > 0) {
        dtPlanesResumen.page(Math.min(tableState.page, pageInfo.pages - 1)).draw(false);
    }
    paintSelectedPlan();
}
