function renderTimeline(planCode, currentCode) {
    var body = document.getElementById('dp_timeline_body');
    var groups = buildPlanGroups(rowsForSelectedYear());
    var group = groups[planCode];
    if (!group) {
        body.innerHTML = '<tr><td colspan="5" class="text-center text-muted">No hay lineas para este plan.</td></tr>';
        return;
    }
    document.getElementById('dp_total_lineas').textContent = group.total;
    document.getElementById('dp_pendientes').textContent = group.pendiente;
    document.getElementById('dp_ejecutadas').textContent = group.ejecutado + group.fuera;
    document.getElementById('dp_vencidas').textContent = group.vencido;
    body.innerHTML = group.rows.map(function(r) {
        var current = r.Code === currentCode ? ' style="background:#f5fbf7;"' : '';
        return '<tr' + current + '>'
            + '<td>' + esc(periodLabel(r)) + '</td>'
            + '<td>' + esc(fmt(r.U_FechaProg)) + '</td>'
            + '<td>' + badgeEstado(r.U_Estado) + '</td>'
            + '<td>' + esc(otLabel(r)) + '</td>'
            + '<td class="text-center">' + (isCustomOccurrenceObservation(r)
                ? '<button type="button" class="btn btn-xs btn-warning btn-ver-indicacion" data-code="' + attr(r.Code || '') + '" title="Ver indicación personalizada"><i class="fas fa-sticky-note mr-1"></i>Personalizada</button>'
                : '<span class="badge badge-light border text-muted" title="Usa la instrucción del plan"><i class="fas fa-link mr-1"></i>Del plan</span>') + '</td>'
            + '</tr>';
    }).join('');
}

