function openSafePlanEdit(planCode) {
    if (!planCode) return;
    fetch('$baseUrl/api/mantenimientos/get_prog.php?plan_code=' + encodeURIComponent(planCode), {
        credentials: 'same-origin'
    })
    .then(function(response) {
        return response.json().then(function(json) {
            if (!response.ok || json.error) throw new Error(json.error || 'No se pudo cargar el programa.');
            return json;
        });
    })
    .then(function(rows) {
        var plan = Array.isArray(rows) ? rows[0] : null;
        if (!plan) throw new Error('No se encontro el programa seleccionado.');
