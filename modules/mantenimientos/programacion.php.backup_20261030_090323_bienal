        method: 'POST',
        credentials: 'same-origin',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
            action: 'update_metadata',
            code: code,
            name: name,
            observacion: observacion,
            modalidad: modalidad,
            critico: critico,
            activo: activo
        })
    })
    .then(function(response) {
