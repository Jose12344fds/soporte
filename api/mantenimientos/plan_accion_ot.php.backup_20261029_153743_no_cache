function pa_v($value): string { return trim((string)($value ?? '')); }
function pa_nullable(string $value): ?string { return $value === '' ? null : $value; }
function pa_date(string $value, bool $required=false): ?string {
    $value=substr(pa_v($value),0,10);
    if($value===''&&!$required)return null;
    $dt=DateTime::createFromFormat('!Y-m-d',$value);
    if(!$dt||$dt->format('Y-m-d')!==$value)throw new InvalidArgumentException('Fecha inválida.');
    return $value;
}
function pa_time(string $value): ?int {
    $value=pa_v($value); if($value==='')return null;
    if(!preg_match('/^(\d{1,2}):(\d{2})$/',$value,$m))throw new InvalidArgumentException('Hora inválida.');
